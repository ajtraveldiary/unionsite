{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds deploys to (made when the repo was connected, 1 Nov 2026)
  "name": "unionsite",
  // Astro's handler plus the scheduled jobs (src/worker.ts)
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Content (plan, section 4). The real database (APAC) was created on 1 Nov 2026 in the owner's
  // Cloudflare account, for now (plan, section 17). Locally wrangler keeps its own copy in
  // .wrangler/state; `npm run db:migrate:remote` applies new migrations to the real one.
  "d1_databases": [
    { "binding": "DB", "database_name": "union", "database_id": "12e61fae-79e8-42bd-adbe-7d44bbb58e51", "migrations_dir": "migrations" }
  ],
  // Uploaded photos and PDFs (plan, sections 4 and 9). The real bucket was created on 1 Nov 2026
  // in the same account; locally wrangler keeps the bucket in .wrangler/state. Served at /media/…
  // until media.keralangounion.in is connected at launch.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "union-media" }],
  // The Cloudflare adapter adds a SESSION binding to every build (the site doesn't use sessions).
  // Cloudflare made this namespace on the first deploy; naming its id stops each build making another.
  "kv_namespaces": [{ "binding": "SESSION", "id": "4650d60ffeea4a4c8fb08266fd6cd098" }],
  // Every five minutes: publish scheduled posts (src/worker.ts)
  "triggers": { "crons": ["*/5 * * * *"] },
  // Page views and the other beacons (src/lib/analytics.ts), so they don't write to D1. The hourly
  // roll-up reads them back through the SQL API with CF_ACCOUNT_ID and the CF_API_TOKEN secret
  // (an "Account Analytics: Read" token); the account id changes if the site moves to a union account.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "union_events" }],
  "vars": { "CF_ACCOUNT_ID": "4d2c2b4ca831c58d05db412df6452647" }
  // Later: vars ACCESS_TEAM_DOMAIN and ACCESS_AUD for admin login
}
