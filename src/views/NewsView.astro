---
/**
 * News (redesign, Phase C): search within news, topic chips and a district menu over a
 * text-first feed grouped by month, with "Load more". The newest story leads while no
 * filter is on. Filters live in the URL (?topic=&district=&q=), so a filtered view can be
 * shared and the home page's "More from…" links open it ready-filtered.
 *
 * The page renders only the newest stories. Filtering, search and "Load more" ask /api/news
 * for one page at a time (D1, with its full-text index for search) and draw it in the browser.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import StoryLead from '~/components/ds/StoryLead.astro';
import StoryItem from '~/components/ds/StoryItem.astro';
import EventCard from '~/components/ds/EventCard.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import type { Lang, Post } from '~/lib/types';
import { href, monthName } from '~/lib/i18n';
import { latestPosts, topicPostCounts, sortedDistricts, upcomingEvents } from '~/lib/content';
import { topics } from '~/data/districts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => href(lang, p);
const PAGE = 12;
// The lead and the first page; the rest comes from /api/news a page at a time
const [posts, topicCounts] = await Promise.all([latestPosts({ limit: PAGE + 1 }), topicPostCounts()]);
const total = Object.values(topicCounts).reduce((a, b) => a + b, 0);
const lead = posts[0];

// Months of the newest year, then whole years before it (the script groups the same way)
const newestYear = Number(lead.date.slice(0, 4));
const groupOf = (p: Post) => {
  const y = Number(p.date.slice(0, 4));
  return y === newestYear ? `${monthName(Number(p.date.slice(5, 7)), 'en')} ${y}` : String(y);
};
// The first page, without the lead (it shows above)
const groups: { label: string; items: Post[] }[] = [];
for (const p of posts.slice(1, PAGE + 1)) {
  const label = groupOf(p);
  if (groups.at(-1)?.label !== label) groups.push({ label, items: [] });
  groups.at(-1)!.items.push(p);
}

const usedTopics = topics.filter((tp) => topicCounts[tp.slug]);
const events = await upcomingEvents(3);
---
<AppLayout lang={lang} title="News" description="News from the Kerala NGO Union and its 15 district committees.">
  <div class="wrap pt-5 lg:pt-8" lang="en">
    <Breadcrumbs lang={lang} items={[{ label: 'News' }]} />
    <h1 class="t-display mt-2">News</h1>
    <p class="mt-1 text-ink-2">From the union and its 15 district committees.</p>

    <form data-news-filters role="search" aria-label="Filter news" class="mt-5">
      <div class="flex flex-col gap-3 md:flex-row">
        <div class="relative min-w-0 flex-1 md:max-w-md">
          <Icon name="Search" size={18} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" />
          <input name="q" type="search" data-news-q class="field pl-9" placeholder="Search news" aria-label="Search news" autocomplete="off" />
        </div>
        <select name="district" data-news-district class="field md:w-60" aria-label="District">
          <option value="all">All districts</option>
          <option value="state">State level only</option>
          {sortedDistricts().map((d) => <option value={d.slug}>{d.name.en}</option>)}
        </select>
      </div>
      <div role="toolbar" aria-label="Topic" class="no-scrollbar -mx-4 mt-3 flex gap-2 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:px-0">
        <button type="button" class="chip" aria-pressed="true" data-news-topic="all">All</button>
        {usedTopics.map((tp) => <button type="button" class="chip" aria-pressed="false" data-news-topic={tp.slug}>{tp.name.en}</button>)}
      </div>
    </form>
  </div>

  <div class="wrap mt-8 grid gap-x-12 gap-y-14 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div data-news data-lang={lang} data-page={PAGE} data-total={total - 1} data-newest-year={newestYear} data-lead-id={lead.id}>
      <div data-news-lead class="mb-8">
        <StoryLead post={lead} lang={lang} headingLevel="h2" ratio="2/1" />
      </div>
      <p class="sr-only" aria-live="polite" data-news-status></p>

      <div data-news-feed>
        {groups.map((g) => (
          <section class="mb-8" aria-label={g.label}>
            <h2 lang="en" class="t-label mb-1">{g.label}</h2>
            <ul class="divide-y divide-line border-t border-line">
              {g.items.map((p) => <li class="py-4"><StoryItem post={p} lang={lang} /></li>)}
            </ul>
          </section>
        ))}
      </div>

      <div data-news-empty hidden>
        <EmptyState icon="Newspaper" title="No stories match" text="Try another topic or district, or clear the search.">
          <button type="button" data-news-clear class="btn btn-secondary btn-sm mt-4">Clear filters</button>
        </EmptyState>
      </div>
      <div lang="en" class="text-center">
        <p class="t-meta" data-news-count>Showing {Math.min(PAGE, total - 1)} of {total - 1}</p>
        <button type="button" data-news-more class="btn btn-secondary mt-2" hidden={total - 1 <= PAGE}>Load more</button>
      </div>
    </div>

    <aside lang="en" class="space-y-10">
      {events.length > 0 && (
        <section aria-labelledby="news-events">
          <SectionHead title="Coming up" id="news-events" size="h2" href={L('/events')} linkLabel="All events" />
          <ul class="space-y-2">
            {events.map((e) => <li><EventCard event={e} lang={lang} showDistrict /></li>)}
          </ul>
        </section>
      )}
      <section aria-labelledby="news-topics">
        <SectionHead title="Topics" id="news-topics" size="h2" />
        <ul class="divide-y divide-line text-sm">
          {usedTopics.map((tp) => (
            <li>
              <a href={L(`/news?topic=${tp.slug}`)} data-news-topic-link={tp.slug} class="flex items-center justify-between gap-3 py-2 hover:text-accent-ink">
                <span class="font-medium">{tp.name.en}</span>
                <span class="t-meta">{topicCounts[tp.slug]}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</AppLayout>

<script>
  interface IndexPost { id: number; u: string; d: string; tp: string; ds?: string; t: string; te?: string; s: string; se?: string; img?: string }
  interface NewsIndex { topics: Record<string, string>; districts: Record<string, string>; total: number; posts: IndexPost[] }
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

  function initNews() {
    const root = document.querySelector<HTMLElement>('[data-news]');
    const form = document.querySelector<HTMLFormElement>('[data-news-filters]');
    if (!root || !form || root.dataset.ready) return;
    root.dataset.ready = '1';
    const en = root.dataset.lang === 'en';
    const PAGE = Number(root.dataset.page);
    const newestYear = Number(root.dataset.newestYear);
    const leadId = Number(root.dataset.leadId);
    const q = form.querySelector<HTMLInputElement>('[data-news-q]')!;
    const sel = form.querySelector<HTMLSelectElement>('[data-news-district]')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-news-topic]')];
    const lead = root.querySelector<HTMLElement>('[data-news-lead]')!;
    const feed = root.querySelector<HTMLElement>('[data-news-feed]')!;
    const empty = root.querySelector<HTMLElement>('[data-news-empty]')!;
    const count = root.querySelector<HTMLElement>('[data-news-count]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-news-more]')!;
    const status = root.querySelector<HTMLElement>('[data-news-status]')!;

    const params = new URLSearchParams(location.search);
    let topic = chips.some((c) => c.dataset.newsTopic === params.get('topic')) ? params.get('topic')! : 'all';
    let district = params.get('district') ?? 'all';
    if (![...sel.options].some((o) => o.value === district)) district = 'all';
    q.value = params.get('q') ?? '';
    sel.value = district;
    // What the list shows now; empty until the first request (the server drew the first page)
    let shown: IndexPost[] = [];
    let ix: NewsIndex | undefined;
    let latest = 0;

    const groupOf = (d: string) => (Number(d.slice(0, 4)) === newestYear ? `${MONTHS[Number(d.slice(5, 7)) - 1]} ${d.slice(0, 4)}` : d.slice(0, 4));
    const shortDate = (d: string) => `${Number(d.slice(8, 10))} ${MONTHS[Number(d.slice(5, 7)) - 1].slice(0, 3)} ${d.slice(0, 4)}`;
    const isMl = (s: string) => /[ഀ-ൿ]/.test(s);

    // One story, drawn like StoryItem: meta line, title, two-line summary, photo on the right
    const item = (p: IndexPost, ix: NewsIndex) => {
      const li = document.createElement('li');
      li.className = 'py-4';
      const title = en && p.te ? p.te : p.t;
      const summary = en && p.se ? p.se : p.s;
      li.innerHTML = `
        <article class="group relative flex gap-4">
          <div class="min-w-0 flex-1">
            <p lang="en" class="t-meta"><span class="font-semibold text-ink-2"></span><span data-rest></span></p>
            <h3 class="t-h3 mt-0.5"><a class="stretched group-hover:text-accent-ink"></a></h3>
            <p class="clamp-2 mt-1 text-sm text-ink-2"></p>
          </div>
          ${p.img ? '<img alt="" loading="lazy" decoding="async" class="w-24 shrink-0 self-start rounded-[10px] bg-bg-subtle object-cover sm:w-36" style="aspect-ratio:4/3">' : ''}
        </article>`;
      li.querySelector('.font-semibold')!.textContent = ix.topics[p.tp] ?? '';
      li.querySelector('[data-rest]')!.textContent = `${p.ds ? ` · ${ix.districts[p.ds]}` : ''} · ${shortDate(p.d)}`;
      const h = li.querySelector('h3')!;
      h.lang = isMl(title) ? 'ml' : 'en';
      const a = h.querySelector('a')!;
      a.href = en ? `/en${p.u}` : p.u;
      a.textContent = title;
      const s = li.querySelector<HTMLElement>('p.clamp-2')!;
      s.lang = isMl(summary) ? 'ml' : 'en';
      s.textContent = summary;
      if (p.img) li.querySelector('img')!.src = p.img;
      return li;
    };

    // Asks the server for `count` stories from `offset` with the current filters
    const fetchPage = async (offset: number, count: number): Promise<NewsIndex> => {
      const term = q.value.trim();
      const u = new URLSearchParams();
      if (topic !== 'all') u.set('topic', topic);
      if (district !== 'all') u.set('district', district);
      if (term) u.set('q', term);
      // Without a filter the lead shows above the list, so the list leaves it out
      if (topic === 'all' && district === 'all' && !term) u.set('skip', String(leadId));
      u.set('offset', String(offset));
      u.set('limit', String(count));
      return (await fetch(`/api/news?${u}`)).json();
    };

    const draw = () => {
      if (!ix) return;
      const page = ix;
      const sections: HTMLElement[] = [];
      for (const p of shown) {
        const label = groupOf(p.d);
        if (sections.at(-1)?.getAttribute('aria-label') !== label) {
          const sec = document.createElement('section');
          sec.className = 'mb-8';
          sec.setAttribute('aria-label', label);
          sec.innerHTML = '<h2 lang="en" class="t-label mb-1"></h2><ul class="divide-y divide-line border-t border-line"></ul>';
          sec.querySelector('h2')!.textContent = label;
          sections.push(sec);
        }
        sections.at(-1)!.querySelector('ul')!.append(item(p, page));
      }
      feed.replaceChildren(...sections);
      empty.hidden = page.total > 0;
      count.hidden = page.total === 0;
      count.textContent = `Showing ${shown.length} of ${page.total}`;
      more.hidden = shown.length >= page.total;
    };

    // New filters: the first page again
    const apply = async (announce = false) => {
      const term = q.value.trim();
      const filtered = topic !== 'all' || district !== 'all' || !!term;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.newsTopic === topic)));
      lead.hidden = filtered;
      const mine = ++latest;
      root.setAttribute('aria-busy', 'true');
      const page = await fetchPage(0, PAGE);
      if (mine !== latest) return;
      root.removeAttribute('aria-busy');
      ix = page;
      shown = page.posts;
      draw();
      if (announce) status.textContent = page.total ? `${page.total} ${page.total === 1 ? 'story' : 'stories'}` : 'No stories match';

      // Keep the URL in step so the view can be shared
      const u = new URLSearchParams();
      if (topic !== 'all') u.set('topic', topic);
      if (district !== 'all') u.set('district', district);
      if (term) u.set('q', term);
      const qs = u.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };
    const refilter = () => apply(true);

    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-news-topic]');
      if (chip) { topic = chip.dataset.newsTopic!; refilter(); }
    });
    sel.addEventListener('change', () => { district = sel.value; refilter(); });
    let timer: number | undefined;
    q.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(refilter, 200); });

    // Topic links in the side column filter in place instead of reloading
    document.querySelectorAll<HTMLAnchorElement>('[data-news-topic-link]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      topic = a.dataset.newsTopicLink!;
      refilter();
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
    root.querySelector('[data-news-clear]')?.addEventListener('click', () => {
      topic = 'all'; district = 'all'; q.value = ''; sel.value = 'all';
      refilter();
    });
    more.addEventListener('click', async () => {
      // The first time, the server-drawn first page is fetched along with the next one
      const before = shown.length || PAGE;
      const mine = ++latest;
      root.setAttribute('aria-busy', 'true');
      const page = await fetchPage(shown.length, shown.length ? PAGE : PAGE * 2);
      if (mine !== latest) return;
      root.removeAttribute('aria-busy');
      ix = page;
      shown = [...shown, ...page.posts];
      draw();
      // Move focus to the first newly shown story so keyboard users carry on from there
      feed.querySelectorAll<HTMLElement>('li')[before]?.querySelector('a')?.focus();
    });

    // A filtered link (from the home page, or shared) draws its list straight away
    if (topic !== 'all' || district !== 'all' || q.value.trim()) apply();
  }
  initNews();
  document.addEventListener('astro:page-load', initNews);
</script>
