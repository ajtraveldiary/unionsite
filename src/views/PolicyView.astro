---
/** Privacy and Accessibility (redesign, Phase D): short points, drafts for the union's approval. */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import type { Lang } from '~/lib/types';
import { href } from '~/lib/i18n';

interface Props { lang: Lang; page: 'privacy' | 'accessibility' }
const { lang, page } = Astro.props;

const pages = {
  privacy: {
    title: 'Privacy',
    sub: 'What this website collects, and what it does not.',
    points: [
      ['Shield', 'No tracking cookies', 'Visits are counted without cookies, so there is no consent banner. We record pages viewed, not who viewed them.'],
      ['Play', 'Videos load on tap', 'YouTube is contacted only when you press play, using its privacy-enhanced mode.'],
      ['Mail', 'Messages you send', 'What you write in the contact form is used only to reply to you and is not shared or sold.'],
      ['Moon', 'Light or dark', 'If you pick a light or dark theme, that one choice is saved in your browser, nothing more.'],
      ['Lock', 'Admins', 'Editors sign in with a one-time email code. No passwords are stored.'],
    ],
  },
  accessibility: {
    title: 'Accessibility',
    sub: 'The site aims to meet WCAG 2.2 level AA on phones and computers.',
    points: [
      ['Smartphone', 'Phone first', 'Every page works on a 360 px screen, with large tap targets and a bottom tab bar.'],
      ['Keyboard', 'Keyboard and screen readers', 'All controls work from the keyboard. Pages have landmarks, headings and a skip link.'],
      ['Contrast', 'Contrast and dark mode', 'Text meets contrast rules in both light and dark themes.'],
      ['Languages', 'Malayalam done properly', 'Malayalam text is marked as Malayalam, so screen readers pronounce it correctly.'],
      ['Eye', 'Less motion', 'If your device asks for reduced motion, animations are switched off.'],
    ],
  },
} as const;
const p = pages[page];
---
<AppLayout lang={lang} title={p.title} description={p.sub}>
  <div class="wrap max-w-[800px] pt-5 lg:pt-8" lang="en">
    <Breadcrumbs lang={lang} items={[{ label: p.title }]} />
    <h1 class="t-display mt-2">{p.title}</h1>
    <p class="mt-1 text-ink-2">{p.sub}</p>
    <ul class="mt-6 divide-y divide-line border-y border-line">
      {p.points.map(([icon, head, body]) => (
        <li class="flex gap-4 py-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent-ink"><Icon name={icon} size={20} /></span>
          <div><h2 class="t-h3">{head}</h2><p class="mt-1 text-ink-2">{body}</p></div>
        </li>
      ))}
    </ul>
    <p class="t-meta mt-6">Draft for the union's approval. Questions? Use the <a href={href(lang, '/contact')} class="text-link underline underline-offset-2">contact form</a>.</p>
  </div>
</AppLayout>
