---
/**
 * Documents (approved wireframe "Documents"): the union's Bye-Law, policy resolutions and jubilee
 * documents, one card each, to read on the site or download. No cover image is stored for
 * documents, so each card shows a calm tile with its kind, as stories without a photo do.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import type { Lang } from '~/lib/types';
import { href, t, langOf } from '~/lib/i18n';
import { publishedDocuments } from '~/lib/content';
import { DOC_KIND_LABELS, docMeta } from '~/lib/documents';

interface Props { lang: Lang }
const { lang } = Astro.props;
const docs = await publishedDocuments();
---
<AppLayout lang={lang} title="Documents" description="The Kerala NGO Union's Bye-Law, policy resolutions and jubilee documents, to read online or download.">
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'About', path: '/about' }, { label: 'Documents' }]} />
    <h1 lang="en" class="t-display mt-2">Documents</h1>
    <p lang="en" class="mt-3 max-w-2xl text-lg text-ink-2">The union’s Bye-Law, policy resolutions and jubilee documents, to read online or download.</p>

    {docs.length ? (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {docs.map((d) => (
          <li class="card relative flex flex-col p-4">
            <div class="mx-auto grid aspect-[210/297] w-28 place-items-center rounded-[var(--radius-control)] border border-line bg-bg-subtle text-ink-3" aria-hidden="true">
              <span class="grid justify-items-center gap-1"><Icon name="FileText" size={28} /><span lang="en" class="text-xs font-semibold">{DOC_KIND_LABELS[d.kind]}</span></span>
            </div>
            <p lang="en" class="t-label mt-4">{[DOC_KIND_LABELS[d.kind], d.year].filter(Boolean).join(' · ')}</p>
            <h2 class="mt-1 font-semibold leading-snug"><a href={href(lang, `/about/documents/${d.slug}`)} lang={langOf(d.title, lang)} class="stretched hover:text-accent-ink">{t(d.title, lang)}</a></h2>
            <p lang="en" class="t-meta mt-1">{docMeta(d)}</p>
            <div lang="en" class="relative z-10 mt-auto flex gap-2 pt-4">
              <a href={href(lang, `/about/documents/${d.slug}`)} class="btn btn-primary btn-sm flex-1">Read</a>
              {d.pdfUrl && <a href={d.pdfUrl} download class="btn btn-secondary btn-sm flex-1"><Icon name="Download" size={16} /> Download</a>}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState icon="FileText" title="No documents yet" text="The state office is putting the Bye-Law and resolutions on the site." class="mt-6" />
    )}
  </div>
</AppLayout>
