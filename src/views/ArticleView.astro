---
/**
 * Article (redesign, Phase C), as in the wireframe: one meta line, the headline, a short
 * summary, then share right where people look for it. Comfortable reading width (about
 * 68 characters, 18 px text). The photo shows only when the post has one. Related stories
 * close the page as text cards.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import Media from '~/components/ds/Media.astro';
import ShareBar from '~/components/ds/ShareBar.astro';
import StoryRow from '~/components/ds/StoryRow.astro';
import type { Lang } from '~/lib/types';
import { t, langOf, href, formatDate, readingMinutes, formatViews, hasEn, ui } from '~/lib/i18n';
import { postById, postPath, relatedPosts, districtUrl } from '~/lib/content';
import { topicBySlug, districtBySlug } from '~/data/districts';
import { site } from '~/data/site';

interface Props { lang: Lang; id: number }
const { lang, id } = Astro.props;
const L = (p: string) => href(lang, p);
const p = postById(id)!;
const topic = topicBySlug[p.topic];
const district = p.district ? districtBySlug[p.district] : undefined;
// The English site shows Malayalam (and says so) until a reviewed English version exists
const enMissing = lang === 'en' && !hasEn(p.title);
const useEnBody = lang === 'en' && !!p.body?.en && !enMissing;
const body = useEnBody ? p.body!.en! : p.body?.ml;
const bodyLang = useEnBody ? 'en' : 'ml';
const title = t(p.title, lang);
// The summary under the headline, unless it's just the article's opening cut short (crawled posts)
const summary = t(p.summary, lang);
const standfirst = summary && !(body ?? []).join(' ').startsWith(summary.replace(/…$/, '')) ? summary : '';
const pageUrl = new URL(L(postPath(p)), Astro.site).toString();
const related = relatedPosts(p, 3);
const sameTopic = related.every((r) => r.topic === p.topic);
const photo = p.cover.kind === 'photo' ? p.cover : undefined;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: t(p.summary, lang),
  datePublished: p.date,
  inLanguage: langOf(p.title, lang),
  mainEntityOfPage: pageUrl,
  publisher: { '@type': 'Organization', name: site.name.en },
}).replace(/</g, '\\u003c');
---
<AppLayout lang={lang} title={p.title.en ?? p.title.ml} description={t(p.summary, lang)} noindex={enMissing}>
  <script type="application/ld+json" set:html={jsonLd} />

  <article class="wrap max-w-[800px] pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'News', path: '/news' }, { label: topic.name.en }]} />

    <header class="mt-5">
      <p lang="en" class="flex flex-wrap items-center gap-2">
        <a href={L(`/news?topic=${topic.slug}`)} class="t-label !text-accent-ink hover:underline underline-offset-2">{topic.name.en}</a>
        {district && <a href={districtUrl(district.slug, lang)} class="badge badge-neutral hover:border-line-strong"><Icon name="MapPin" size={12} /> {district.name.en}</a>}
        {p.sample && <span class="badge badge-warning">Sample post</span>}
      </p>
      <h1 lang={langOf(p.title, lang)} class="t-display mt-2">{title}</h1>
      {standfirst && <p lang={langOf(p.summary, lang)} class="mt-3 text-lg text-ink-2">{standfirst}</p>}
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-y border-line py-3">
        <p lang="en" class="t-meta">
          <time datetime={p.date}>{formatDate(p.date, 'en')}</time> · {readingMinutes(body)} min read{(p.views ?? 0) >= 50 ? ` · ${formatViews(p.views)} views` : ''}
        </p>
        <ShareBar url={pageUrl} title={title} />
      </div>
      {enMissing && (
        <p lang="en" class="mt-4 flex items-start gap-2 rounded-[var(--radius-card)] border border-warning/30 bg-warning-soft px-4 py-3 text-sm text-warning">
          <Icon name="Info" size={17} class="mt-0.5 shrink-0" /> {ui.enMissing}
        </p>
      )}
    </header>

    {photo && (
      <figure class="mt-6">
        <Media post={p} lang={lang} ratio="16/9" size="lg" eager />
        <figcaption lang={langOf(photo.alt, lang)} class="t-meta mt-2">{t(photo.alt, lang)}</figcaption>
      </figure>
    )}

    <div lang={bodyLang} class="prose mt-8">
      {body?.map((para) => <p>{para}</p>)}
    </div>
    {p.sample && (
      <p lang="en" class="mt-6 max-w-[68ch] rounded-[var(--radius-card)] border border-dashed border-line-strong p-4 text-sm text-ink-3">
        Placeholder: the full article, photos and gallery come across with the import from the current site.
      </p>
    )}

    <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-line pt-5">
      <p lang="en" class="text-sm font-semibold">Share this story</p>
      <ShareBar url={pageUrl} title={title} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap section max-w-[1000px]" aria-labelledby="related">
      <SectionHead title={sameTopic ? `More on ${topic.name.en}` : 'More stories'} id="related" href={L(sameTopic ? `/news?topic=${topic.slug}` : '/news')} linkLabel={sameTopic ? `All ${topic.name.en}` : 'All news'} />
      <ul class="grid gap-x-8 gap-y-6 md:grid-cols-3">
        {related.map((r) => (
          <li class="border-t-2 border-ink pt-3"><StoryRow post={r} lang={lang} thumb={false} meta={sameTopic ? 'date' : 'topic'} headingLevel="h3" /></li>
        ))}
      </ul>
    </section>
  )}
</AppLayout>
