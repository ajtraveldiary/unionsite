---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Lang, UnionEvent } from '~/lib/types';
import { t, langOf, href, dateParts, formatDate, formatTime, monthName } from '~/lib/i18n';
import { allEvents, isUpcoming } from '~/lib/content';
import { districtBySlug } from '~/data/districts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const events = allEvents();
const upcoming = events.filter(isUpcoming);
const past = events.filter((e) => !isUpcoming(e)).reverse();

// One calendar panel per month that has an event, plus the current month.
const today = dateParts(new Date().toISOString());
const key = (y: number, m: number) => y * 12 + m;
const monthKeys = [...new Set([key(today.y, today.m), ...events.map((e) => { const p = dateParts(e.start); return key(p.y, p.m); })])].sort((a, b) => a - b);
const months = monthKeys.map((k) => {
  const y = Math.floor(k / 12), m = k % 12;
  const first = new Date(Date.UTC(y, m, 1)).getUTCDay();
  const days = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
  const onDay = (d: number) => events.filter((e) => {
    const s = dateParts(e.start), en = e.end ? dateParts(e.end) : s;
    const n = key(y, m) * 40 + d;
    return key(s.y, s.m) * 40 + s.d <= n && n <= key(en.y, en.m) * 40 + en.d;
  });
  return { y, m, first, days, onDay, isNow: y === today.y && m === today.m };
});
const startIndex = Math.max(0, months.findIndex((x) => x.isNow));
const WEEK = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];

const ics = (e: UnionEvent) => JSON.stringify({ slug: e.slug, title: t(e.title, lang), start: e.start, end: e.end ?? '', venue: t(e.venue, lang) });
---
<Base lang={lang} title="Events" description="Meetings, camps, conventions and campaigns of the Kerala NGO Union across Kerala.">
  <PageHero lang={lang} eyebrow="Calendar" title="Events" sub="State and district programmes. Add any event to your phone's calendar in one tap." crumbs={[{ label: 'Events' }]} />

  <div class="container-x grid gap-10 py-10 lg:grid-cols-[360px_1fr] lg:gap-14 lg:py-14">
    <aside lang="en" class="lg:sticky lg:top-24 lg:self-start" aria-label="Month calendar">
      <div class="card p-4 sm:p-5" data-cal data-start={startIndex}>
        {months.map((mo, mi) => (
          <div data-month={mi} hidden={mi !== startIndex}>
            <div class="mb-3 flex items-center justify-between">
              <button type="button" data-cal-step="-1" class="grid size-10 place-items-center rounded-full hover:bg-paper-2 disabled:opacity-30" disabled={mi === 0} aria-label="Previous month"><Icon name="ChevronLeft" size={18} /></button>
              <p class="text-center"><span class="block text-lg font-bold">{monthName(mo.m + 1, 'en')} {mo.y}</span></p>
              <button type="button" data-cal-step="1" class="grid size-10 place-items-center rounded-full hover:bg-paper-2 disabled:opacity-30" disabled={mi === months.length - 1} aria-label="Next month"><Icon name="ChevronRight" size={18} /></button>
            </div>
            <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-ink-3" aria-hidden="true">{WEEK.map((w) => <span class="py-1">{w}</span>)}</div>
            <ol class="grid grid-cols-7 gap-1 text-center">
              {Array.from({ length: mo.first }).map(() => <li aria-hidden="true"></li>)}
              {Array.from({ length: mo.days }, (_, d) => d + 1).map((d) => {
                const evs = mo.onDay(d);
                const isToday = mo.isNow && d === today.d;
                return (
                  <li>
                    {evs.length ? (
                      <a href={`#${evs[0].slug}`} title={evs.map((e) => t(e.title, 'en')).join(', ')} class:list={['day relative grid aspect-square place-items-center rounded-lg bg-brand-solid text-sm font-bold text-white transition hover:scale-110', isToday && 'ring-2 ring-gold-line ring-offset-2 ring-offset-surface']}>
                        {d}<span class="sr-only">: {evs.map((e) => t(e.title, 'en')).join(', ')}</span>
                      </a>
                    ) : (
                      <span class:list={['grid aspect-square place-items-center rounded-lg text-sm tabular', isToday ? 'bg-ink font-bold text-paper' : 'text-ink-2']}>{d}</span>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
        <p class="mt-4 flex items-center gap-4 border-t border-line pt-3 text-xs text-ink-3">
          <span class="flex items-center gap-1.5"><span class="size-3 rounded bg-brand-solid"></span> Event</span>
          <span class="flex items-center gap-1.5"><span class="size-3 rounded bg-ink"></span> Today</span>
        </p>
      </div>
    </aside>

    <div class="min-w-0">
      <h2 lang="en" class="h2 mb-5">Coming up</h2>
      {upcoming.length ? (
        <ol class="relative space-y-4 border-l-2 border-line pl-6 sm:pl-8">
          {upcoming.map((e) => {
            const s = dateParts(e.start);
            const district = e.district ? districtBySlug[e.district] : undefined;
            return (
              <li id={e.slug} class="event relative scroll-mt-28">
                <span class="absolute -left-[33px] top-6 size-4 rounded-full border-4 border-paper bg-brand-solid sm:-left-[41px]" aria-hidden="true"></span>
                <article class="card p-5 sm:p-6">
                  <p lang="en" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-brand">
                    <span class="flex items-center gap-1.5"><Icon name="CalendarDays" size={15} />{formatDate(e.start, 'en')}{e.end && dateParts(e.end).d !== s.d && ` – ${formatDate(e.end, 'en')}`}</span>
                    <span class="flex items-center gap-1.5 text-ink-3"><Icon name="Clock" size={15} />{formatTime(e.start)}</span>
                  </p>
                  <h3 lang={langOf(e.title, lang)} class="h2 mt-2">{t(e.title, lang)}</h3>
                  <p class="mt-3 flex items-center gap-1.5 text-ink-2"><Icon name="MapPin" size={16} class="text-brand" /><span lang={langOf(e.venue, lang)}>{t(e.venue, lang)}</span></p>
                  <div lang="en" class="mt-4 flex flex-wrap items-center gap-2">
                    <button type="button" class="btn btn-ghost !min-h-10 text-sm" data-ics={ics(e)}><Icon name="CalendarPlus" size={16} /> Add to calendar</button>
                    {district && <a href={href(lang, `/districts/${district.slug}`)} class="badge badge-ink !h-8 hover:border-ink-3"><Icon name="MapPin" size={12} /> {district.name.en}</a>}
                    {!district && <span class="badge badge-brand !h-8">State level</span>}
                    {e.sample && <span class="badge badge-ink !h-8">Sample</span>}
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      ) : (
        <p lang="en" class="rounded-xl border border-dashed border-line-strong p-6 text-center text-ink-3">No events scheduled right now.</p>
      )}

      {past.length > 0 && (
        <details class="mt-12 group" lang="en">
          <summary class="flex cursor-pointer list-none items-center gap-2 font-semibold text-ink-2 hover:text-ink">
            <Icon name="ChevronRight" size={18} class="transition-transform group-open:rotate-90" /> Past events ({past.length})
          </summary>
          <ul class="mt-4 divide-y divide-line rounded-2xl border border-line bg-surface">
            {past.map((e) => (
              <li id={e.slug} class="flex flex-wrap items-center justify-between gap-2 px-5 py-3">
                <span lang={langOf(e.title, lang)} class="font-semibold">{t(e.title, lang)}</span>
                <span class="text-sm text-ink-3">{formatDate(e.start, 'en', 'short')} · <span lang={langOf(e.venue, lang)}>{t(e.venue, lang)}</span></span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </div>
</Base>

<style>
  .event:target article { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const cal = document.querySelector<HTMLElement>('[data-cal]');
    if (cal) {
      let cur = Number(cal.dataset.start);
      const panels = cal.querySelectorAll<HTMLElement>('[data-month]');
      cal.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cal-step]');
        if (!b) return;
        const next = Math.min(panels.length - 1, Math.max(0, cur + Number(b.dataset.calStep)));
        if (next === cur) return;
        panels[cur].hidden = true;
        panels[next].hidden = false;
        cur = next;
        panels[cur].querySelector<HTMLButtonElement>(`[data-cal-step="${b.dataset.calStep}"]:not(:disabled)`)?.focus();
      });
    }

    // Build an .ics file in the browser, so phones offer to add the event
    const stamp = (iso: string) => new Date(iso).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const esc = (s: string) => s.replace(/[\\,;]/g, (c) => `\\${c}`);
    document.querySelectorAll<HTMLButtonElement>('[data-ics]').forEach((b) => {
      b.onclick = () => {
        const ev = JSON.parse(b.dataset.ics!);
        const end = ev.end || new Date(new Date(ev.start).getTime() + 2 * 3600_000).toISOString();
        const body = [
          'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Kerala NGO Union//Events//EN', 'BEGIN:VEVENT',
          `UID:${ev.slug}@keralangounion.in`, `DTSTAMP:${stamp(new Date().toISOString())}`,
          `DTSTART:${stamp(ev.start)}`, `DTEND:${stamp(end)}`,
          `SUMMARY:${esc(ev.title)}`, `LOCATION:${esc(ev.venue)}`, `URL:${location.origin}${location.pathname}#${ev.slug}`,
          'END:VEVENT', 'END:VCALENDAR',
        ].join('\r\n');
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([body], { type: 'text/calendar' }));
        a.download = `${ev.slug}.ics`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      };
    });
  });
</script>
