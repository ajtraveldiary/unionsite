---
/**
 * Events (redesign, Phase D): upcoming state and district programmes grouped by month, each
 * with date, time, venue, where it belongs (state or a district) and "Add to calendar". A
 * district menu narrows the list (?district= in the URL, so a district can share its own
 * view). A small month calendar sits beside the list on laptops; past events fold away below.
 * Other pages link to one event with /events#slug, which highlights it.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import type { Lang, UnionEvent } from '~/lib/types';
import { t, langOf, href, dateParts, formatDate, formatTime, monthName } from '~/lib/i18n';
import { upcomingEvents, pastEvents, sortedDistricts } from '~/lib/content';
import { districtBySlug } from '~/data/districts';

interface Props { lang: Lang }
const { lang } = Astro.props;
// Every upcoming event, and the latest past ones (with their reports); never the whole archive
const [upcoming, past] = await Promise.all([upcomingEvents(200), pastEvents(30)]);
const events = [...past].reverse().concat(upcoming);

// Upcoming events by month
const byMonth: { label: string; items: UnionEvent[] }[] = [];
for (const e of upcoming) {
  const p = dateParts(e.start);
  const label = `${monthName(p.m + 1, 'en')} ${p.y}`;
  if (byMonth.at(-1)?.label !== label) byMonth.push({ label, items: [] });
  byMonth.at(-1)!.items.push(e);
}

// One calendar panel per month that has an event, plus the current month
const today = dateParts(new Date().toISOString());
const key = (y: number, m: number) => y * 12 + m;
const monthKeys = [...new Set([key(today.y, today.m), ...events.map((e) => { const p = dateParts(e.start); return key(p.y, p.m); })])].sort((a, b) => a - b);
const months = monthKeys.map((k) => {
  const y = Math.floor(k / 12), m = k % 12;
  const first = new Date(Date.UTC(y, m, 1)).getUTCDay();
  const days = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
  const onDay = (d: number) => events.filter((e) => {
    const s = dateParts(e.start), en = e.end ? dateParts(e.end) : s;
    const n = key(y, m) * 40 + d;
    return key(s.y, s.m) * 40 + s.d <= n && n <= key(en.y, en.m) * 40 + en.d;
  });
  return { y, m, first, days, onDay, isNow: y === today.y && m === today.m };
});
const startIndex = Math.max(0, months.findIndex((x) => x.isNow));
const WEEK = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];

const ics = (e: UnionEvent) => JSON.stringify({ slug: e.slug, title: t(e.title, lang), start: e.start, end: e.end ?? '', venue: t(e.venue, lang) });
const dateRange = (e: UnionEvent) => {
  const s = dateParts(e.start);
  const end = e.end ? dateParts(e.end) : undefined;
  return end && end.d !== s.d ? `${formatDate(e.start, 'en')} – ${formatDate(e.end!, 'en')}` : formatDate(e.start, 'en');
};
---
<AppLayout lang={lang} title="Events" description="Meetings, camps, conventions and campaigns of the Kerala NGO Union across Kerala.">
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'Events' }]} />
    <h1 lang="en" class="t-display mt-2">Events</h1>
    <p lang="en" class="mt-1 text-ink-2">State and district programmes. Add any event to your phone's calendar.</p>

    <div class="mt-6 grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="min-w-0" data-events>
        <div lang="en" class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
          <p class="text-sm text-ink-2" aria-live="polite" data-events-count><strong class="tabular text-ink">{upcoming.length}</strong> coming up</p>
          <select data-events-district class="field w-full sm:w-60" aria-label="District">
            <option value="all">All districts</option>
            <option value="state">State level only</option>
            {sortedDistricts().map((d) => <option value={d.slug}>{d.name.en}</option>)}
          </select>
        </div>

        {byMonth.map((g) => (
          <section data-events-group class="mt-6" aria-label={g.label}>
            <h2 lang="en" class="t-label">{g.label}</h2>
            <ul class="mt-1 divide-y divide-line border-t border-line">
              {g.items.map((e) => {
                const s = dateParts(e.start);
                const district = e.district ? districtBySlug[e.district] : undefined;
                return (
                  <li id={e.slug} data-event data-district={e.district ?? 'state'} class="event scroll-mt-24">
                    <article class="flex gap-4 py-4">
                      <div lang="en" class="w-14 shrink-0 self-start rounded-lg bg-bg-subtle py-1.5 text-center leading-tight">
                        <p class="text-[0.6875rem] font-semibold uppercase tracking-wide text-accent-ink">{s.monthShort}</p>
                        <p class="text-xl font-bold tabular">{s.d}</p>
                      </div>
                      <div class="min-w-0 flex-1">
                        <h3 lang={langOf(e.title, lang)} class="t-h3">{t(e.title, lang)}</h3>
                        <p class="t-meta mt-0.5"><span lang="en">{dateRange(e)} · {formatTime(e.start)}</span> · <span lang={langOf(e.venue, lang)}>{t(e.venue, lang)}</span></p>
                        <div lang="en" class="mt-2 flex flex-wrap items-center gap-2">
                          {district
                            ? <a href={href(lang, `/districts/${district.slug}`)} class="badge badge-neutral hover:border-line-strong"><Icon name="MapPin" size={12} /> {district.name.en}</a>
                            : <span class="badge badge-accent">State level</span>}
                          {e.sample && <span class="badge badge-warning">Sample</span>}
                          <button type="button" class="link ml-auto inline-flex items-center gap-1.5 text-sm" data-ics={ics(e)}><Icon name="CalendarPlus" size={16} /> Add to calendar</button>
                        </div>
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}

        <div data-events-empty hidden={upcoming.length > 0} class="mt-6">
          <EmptyState icon="CalendarDays" title="Nothing scheduled" text="New programmes appear here as soon as they are added." />
        </div>

        {past.length > 0 && (
          <details class="group mt-10" lang="en">
            <summary class="flex cursor-pointer list-none items-center gap-2 font-semibold text-ink-2 hover:text-ink [&::-webkit-details-marker]:hidden">
              <Icon name="ChevronRight" size={18} class="transition-transform group-open:rotate-90" /> Past events ({past.length})
            </summary>
            <ul class="mt-3 divide-y divide-line border-y border-line">
              {past.map((e) => (
                <li id={e.slug} class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-3">
                  <span lang={langOf(e.title, lang)} class="font-semibold">{t(e.title, lang)}</span>
                  <span class="t-meta">{formatDate(e.start, 'en', 'short')} · <span lang={langOf(e.venue, lang)}>{t(e.venue, lang)}</span></span>
                  {e.report && (
                    <a href={href(lang, e.report.path)} class="link mt-1 inline-flex w-full items-center gap-1.5"><Icon name="Newspaper" size={16} /> Report: <span lang={langOf(e.report.title, lang)} class="font-normal">{t(e.report.title, lang)}</span></a>
                  )}
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>

      <aside lang="en" class="lg:sticky lg:top-24 lg:self-start" aria-label="Month calendar">
        <div class="card p-4" data-cal data-start={startIndex}>
          {months.map((mo, mi) => (
            <div data-month={mi} hidden={mi !== startIndex}>
              <div class="mb-2 flex items-center justify-between">
                <button type="button" data-cal-step="-1" class="btn btn-ghost btn-sm btn-icon" disabled={mi === 0} aria-label="Previous month"><Icon name="ChevronLeft" size={18} /></button>
                <p class="font-semibold">{monthName(mo.m + 1, 'en')} {mo.y}</p>
                <button type="button" data-cal-step="1" class="btn btn-ghost btn-sm btn-icon" disabled={mi === months.length - 1} aria-label="Next month"><Icon name="ChevronRight" size={18} /></button>
              </div>
              <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-ink-3" aria-hidden="true">{WEEK.map((w) => <span class="py-1">{w}</span>)}</div>
              <ol class="grid grid-cols-7 gap-1 text-center">
                {Array.from({ length: mo.first }).map(() => <li aria-hidden="true"></li>)}
                {Array.from({ length: mo.days }, (_, d) => d + 1).map((d) => {
                  const evs = mo.onDay(d);
                  const isToday = mo.isNow && d === today.d;
                  return (
                    <li>
                      {evs.length ? (
                        <a href={`#${evs[0].slug}`} title={evs.map((e) => t(e.title, 'en')).join(', ')} class:list={['grid aspect-square place-items-center rounded-md bg-accent text-sm font-semibold text-on-accent hover:bg-accent-hover', isToday && 'ring-2 ring-ink ring-offset-2 ring-offset-surface']}>
                          {d}<span class="sr-only">: {evs.map((e) => t(e.title, 'en')).join(', ')}</span>
                        </a>
                      ) : (
                        <span class:list={['grid aspect-square place-items-center rounded-md text-sm tabular', isToday ? 'bg-ink font-semibold text-bg' : 'text-ink-2']}>{d}</span>
                      )}
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
          <p class="t-meta mt-3 flex items-center gap-4 border-t border-line pt-3">
            <span class="flex items-center gap-1.5"><span class="size-3 rounded-sm bg-accent"></span> Event</span>
            <span class="flex items-center gap-1.5"><span class="size-3 rounded-sm bg-ink"></span> Today</span>
          </p>
        </div>
      </aside>
    </div>
  </div>
</AppLayout>

<style>
  .event:target article { box-shadow: inset 3px 0 0 var(--accent); padding-left: 0.75rem; background: var(--accent-soft); }
</style>

<script>
  function initEvents() {
    const root = document.querySelector<HTMLElement>('[data-events]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // District menu, kept in the URL
    const sel = root.querySelector<HTMLSelectElement>('[data-events-district]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-event]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-events-group]')];
    const empty = root.querySelector<HTMLElement>('[data-events-empty]')!;
    const count = root.querySelector<HTMLElement>('[data-events-count]')!;
    const apply = () => {
      const v = sel.value;
      let n = 0;
      for (const li of items) { li.hidden = v !== 'all' && li.dataset.district !== v; if (!li.hidden) n++; }
      groups.forEach((g) => { g.hidden = !g.querySelector('[data-event]:not([hidden])'); });
      empty.hidden = n > 0;
      count.innerHTML = `<strong class="tabular text-ink">${n}</strong> coming up`;
      const qs = v === 'all' ? '' : `?district=${v}`;
      history.replaceState(null, '', `${location.pathname}${qs}${location.hash}`);
    };
    const start = new URLSearchParams(location.search).get('district');
    if (start && [...sel.options].some((o) => o.value === start)) { sel.value = start; apply(); }
    sel.addEventListener('change', apply);

    // Month calendar
    const cal = document.querySelector<HTMLElement>('[data-cal]');
    if (cal) {
      let cur = Number(cal.dataset.start);
      const panels = cal.querySelectorAll<HTMLElement>('[data-month]');
      cal.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cal-step]');
        if (!b) return;
        const next = Math.min(panels.length - 1, Math.max(0, cur + Number(b.dataset.calStep)));
        if (next === cur) return;
        panels[cur].hidden = true;
        panels[next].hidden = false;
        cur = next;
        panels[cur].querySelector<HTMLButtonElement>(`[data-cal-step="${b.dataset.calStep}"]:not(:disabled)`)?.focus();
      });
    }

    // Build an .ics file in the browser, so phones offer to add the event
    const stamp = (iso: string) => new Date(iso).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const esc = (s: string) => s.replace(/[\\,;]/g, (c) => `\\${c}`);
    root.querySelectorAll<HTMLButtonElement>('[data-ics]').forEach((b) => b.addEventListener('click', () => {
      const ev = JSON.parse(b.dataset.ics!);
      const end = ev.end || new Date(new Date(ev.start).getTime() + 2 * 3600_000).toISOString();
      const body = [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Kerala NGO Union//Events//EN', 'BEGIN:VEVENT',
        `UID:${ev.slug}@keralangounion.in`, `DTSTAMP:${stamp(new Date().toISOString())}`,
        `DTSTART:${stamp(ev.start)}`, `DTEND:${stamp(end)}`,
        `SUMMARY:${esc(ev.title)}`, `LOCATION:${esc(ev.venue)}`, `URL:${location.origin}${location.pathname}#${ev.slug}`,
        'END:VEVENT', 'END:VCALENDAR',
      ].join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([body], { type: 'text/calendar' }));
      a.download = `${ev.slug}.ics`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }));
  }
  initEvents();
  document.addEventListener('astro:page-load', initEvents);
</script>
