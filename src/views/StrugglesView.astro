---
/**
 * Struggles (approved wireframe "Struggles"): the union's major strikes and campaigns as a
 * timeline, newest first, with decade chips to jump back. The state office writes the page in
 * Admin → Pages & documents, one heading per struggle starting with its year ("2002 · …"); each
 * entry links to its stories in News, so the page never repeats what News holds. "Now" shows the
 * newest stories with the Struggles topic.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import StoryCard from '~/components/ds/StoryCard.astro';
import ShareBar from '~/components/ds/ShareBar.astro';
import type { AboutPage, Lang } from '~/lib/types';
import { href, t, langOf, ui } from '~/lib/i18n';
import { bodySections } from '~/lib/richtext';
import { latestPosts } from '~/lib/content';

interface Props { lang: Lang; page: AboutPage }
const { lang, page } = Astro.props;
const L = (p: string) => href(lang, p);
const enMissing = lang === 'en' && !page.title.en;
const useEn = lang === 'en' && !!page.body.en && !enMissing;
const bodyLang = useEn ? 'en' : 'ml';
const { intro, sections } = bodySections(useEn ? page.body.en : page.body.ml);
const entries = sections.map((s) => {
  const m = s.title.match(/^(\d{4})\s*[·:–—-]?\s*(.*)$/);
  return { year: m ? Number(m[1]) : null, name: m ? m[2] || s.title : s.title, html: s.html };
}).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const decadeOf = (y: number | null) => (y && y >= 1990 ? `${Math.floor(y / 10) * 10}s` : 'Earlier');
const decades = [...new Set(entries.map((e) => decadeOf(e.year)))];
const firstOf = new Map(decades.map((d) => [d, entries.findIndex((e) => decadeOf(e.year) === d)]));
const recent = await latestPosts({ limit: 3, topic: 'struggles' });
const title = t(page.title, lang);
const pageUrl = new URL(L(page.path), Astro.site).toString();
---
<AppLayout lang={lang} title={page.title.en ?? 'Struggles'} description={t(page.summary, lang) || 'Major strikes and campaigns of the Kerala NGO Union.'} noindex={enMissing}>
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'About', path: '/about' }, { label: 'Struggles' }]} />
    <h1 lang={langOf(page.title, lang)} class="t-display mt-2">{title}</h1>
    {t(page.summary, lang) && <p lang={langOf(page.summary, lang)} class="mt-3 max-w-2xl text-lg text-ink-2">{t(page.summary, lang)}</p>}
    <ShareBar url={pageUrl} title={title} class="mt-4" />
    {intro && <div lang={bodyLang} class="prose mt-5" set:html={intro} />}
    {enMissing && <p lang="en" class="mt-4 flex max-w-2xl items-start gap-2 rounded-[var(--radius-card)] border border-warning/30 bg-warning-soft px-4 py-3 text-sm text-warning"><Icon name="Info" size={17} class="mt-0.5 shrink-0" /> {ui.enMissing}</p>}
    {entries.length > 0 && (
      <div lang="en" class="no-scrollbar -mx-4 mt-5 flex gap-2 overflow-x-auto px-4" role="group" aria-label="Jump to">
        {recent.length > 0 && <a href="#now" class="chip shrink-0">Now</a>}
        {decades.map((d) => <a href={`#entry-${firstOf.get(d)}`} class="chip shrink-0">{d}</a>)}
      </div>
    )}
  </div>

  {recent.length > 0 && (
    <section id="now" class="wrap mt-8 scroll-mt-24" aria-labelledby="now-head">
      <SectionHead title="Now" id="now-head" href={L('/news?topic=struggles')} linkLabel="All struggle stories" size="h2" />
      <ul class="grid gap-x-5 gap-y-6 md:grid-cols-3">{recent.map((p) => <li><StoryCard post={p} lang={lang} showTopic={false} headingLevel="h3" /></li>)}</ul>
    </section>
  )}

  <section class="wrap mt-10" aria-labelledby="timeline">
    {entries.length > 0 && <h2 id="timeline" lang="en" class="t-h2 mb-4">Timeline</h2>}
    <ol class="relative ml-2 max-w-3xl border-l-2 border-line">
      {entries.map((e, i) => (
        <li id={`entry-${i}`} class="relative scroll-mt-24 pb-8 pl-6">
          <span class="absolute -left-[9px] top-1.5 size-4 rounded-full border-2 border-ink bg-bg" aria-hidden="true"></span>
          {e.year && <p lang="en" class="text-lg font-bold tabular">{e.year}</p>}
          <h3 lang={bodyLang} class="t-h3 mt-0.5">{e.name}</h3>
          {e.html && <div lang={bodyLang} class="prose mt-1 text-ink-2 [&_p:last-child]:mb-0" set:html={e.html} />}
          <a href={L(`/news?topic=struggles&q=${encodeURIComponent(e.name)}`)} lang="en" class="link mt-1 inline-block text-sm">Its stories in News</a>
        </li>
      ))}
    </ol>
  </section>
</AppLayout>
