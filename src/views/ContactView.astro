---
/**
 * Contact (redesign, Phase D): the State Centre's address and directions, the district
 * committees, and a message form. The form checks entries but doesn't send yet; sending
 * (with spam protection) is switched on with the admin panel.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Brand from '~/components/ui/Brand.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import type { Lang } from '~/lib/types';
import { t, langOf, href } from '~/lib/i18n';
import { districtUrl, sortedDistricts, siteInfo } from '~/lib/content';
import { TOPICS, turnstileKey } from '~/lib/contact';

interface Props { lang: Lang }
const { lang } = Astro.props;
const info = await siteInfo();
const turnstile = await turnstileKey();
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Kerala NGO Union, ${info.address.en}`)}`;
---
<AppLayout lang={lang} title="Contact" description="Contact the Kerala NGO Union State Centre in Thiruvananthapuram or your district committee.">
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'Contact' }]} />
    <h1 lang="en" class="t-display mt-2">Contact</h1>
    <p lang="en" class="mt-1 text-ink-2">Write to the State Centre, or reach your district committee directly.</p>

    <div class="mt-8 grid gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div>
        <section aria-labelledby="state-centre">
          <SectionHead title="State Centre" id="state-centre" size="h2" />
          <p lang={langOf(info.address, lang)} class="text-lg">{t(info.address, lang)}</p>
          <ul lang="en" class="mt-3 space-y-1.5 text-sm">
            <li class="flex items-center gap-2"><Icon name="Phone" size={16} class="text-ink-3" />{info.phone ? <a href={`tel:${info.phone}`} class="font-semibold hover:text-accent-ink">{info.phone}</a> : <span class="text-ink-3">Phone number to be added</span>}</li>
            <li class="flex items-center gap-2"><Icon name="Mail" size={16} class="text-ink-3" />{info.email ? <a href={`mailto:${info.email}`} class="font-semibold hover:text-accent-ink">{info.email}</a> : <span class="text-ink-3">Email address to be added</span>}</li>
          </ul>
          <div lang="en" class="mt-4 flex flex-wrap gap-2">
            <a href={mapUrl} target="_blank" rel="noopener" class="btn btn-primary btn-sm"><Icon name="MapPin" size={16} /> Directions</a>
            <a href={info.social.facebook} target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><Brand name="facebook" size={16} /> Facebook</a>
          </div>
        </section>

        <section class="mt-10" aria-labelledby="district-committees" lang="en">
          <SectionHead title="District committees" id="district-committees" size="h2" />
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {sortedDistricts().map((d) => (
              <li>
                <article class="card card-hover group relative px-3 py-2">
                  <h3 class="text-sm font-semibold leading-snug"><a href={districtUrl(d.slug, lang)} class="stretched group-hover:text-accent-ink">{d.name.en.replace('Thiruvananthapuram', 'TVM')}</a></h3>
                  <p class="t-meta">HQ {d.hq.en?.replace('Thiruvananthapuram', 'TVM')}</p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <section aria-labelledby="message" lang="en">
        <SectionHead title="Send a message" id="message" size="h2" />
        <p class="t-meta -mt-2">We reply by email or phone. Fields marked * are required.</p>
        <form class="mt-4 grid gap-4 sm:grid-cols-2" data-contact novalidate>
          <label class="grid gap-1.5 sm:col-span-2"><span class="text-sm font-semibold">Name *</span><input name="name" class="field" required autocomplete="name" /></label>
          <label class="grid gap-1.5"><span class="text-sm font-semibold">Email *</span><input name="email" type="email" class="field" required autocomplete="email" /></label>
          <label class="grid gap-1.5"><span class="text-sm font-semibold">Phone</span><input name="phone" type="tel" class="field" autocomplete="tel" inputmode="tel" /></label>
          <label class="grid gap-1.5"><span class="text-sm font-semibold">Your district</span>
            <select name="district" class="field">
              <option value="">Choose…</option>
              {sortedDistricts().map((d) => <option value={d.slug}>{d.name.en}</option>)}
            </select>
          </label>
          <label class="grid gap-1.5"><span class="text-sm font-semibold">Topic</span>
            <select name="topic" class="field">{TOPICS.map((t) => <option>{t}</option>)}</select>
          </label>
          <label class="grid gap-1.5 sm:col-span-2"><span class="text-sm font-semibold">Message *</span><textarea name="message" rows="5" class="field py-2.5" required maxlength="5000"></textarea></label>
          <!-- People never see or fill this; form-filling robots do -->
          <label class="sr-only" aria-hidden="true">Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>
          {turnstile && <div class="cf-turnstile sm:col-span-2" data-sitekey={turnstile} data-theme="auto"></div>}
          {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
          <div class="flex flex-wrap items-center gap-3 sm:col-span-2">
            <button type="submit" class="btn btn-primary"><Icon name="Send" size={17} /> Send message</button>
            <p class="text-sm" data-contact-status role="status" aria-live="polite"></p>
          </div>
        </form>
        <p class="t-meta mt-5 flex items-start gap-2"><Icon name="Info" size={15} class="mt-0.5 shrink-0" /> Your message goes to the State Centre, and to your district committee if you choose one. It is kept for 12 months (see <a href={href(lang, '/privacy')} class="underline">Privacy</a>).</p>
      </section>
    </div>
  </div>
</AppLayout>

<style>
  [data-contact] [aria-invalid='true'] { border-color: var(--accent); }
</style>

<script>
  function initContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let firstBad: HTMLInputElement | undefined;
      form.querySelectorAll<HTMLInputElement>('input, textarea').forEach((el) => {
        const bad = !el.checkValidity();
        el.setAttribute('aria-invalid', String(bad));
        if (bad) firstBad ??= el;
      });
      if (firstBad) {
        status.className = 'text-sm text-accent-ink';
        status.textContent = 'Please fill in the highlighted fields.';
        firstBad.focus();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      button.disabled = true;
      status.className = 'text-sm text-ink-2';
      status.textContent = 'Sending…';
      fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) })
        .then(async (r) => {
          const out = (await r.json().catch(() => ({}))) as { error?: string };
          if (!r.ok) throw new Error(out.error ?? 'The message could not be sent.');
          form.reset();
          status.className = 'text-sm text-success';
          status.textContent = 'Thank you. Your message has reached the office; we reply by email or phone.';
        })
        .catch((err: Error) => {
          status.className = 'text-sm text-accent-ink';
          status.textContent = err.message || 'No connection. Please try again.';
        })
        .finally(() => { button.disabled = false; (window as { turnstile?: { reset(): void } }).turnstile?.reset(); });
    });
  }
  initContact();
</script>
