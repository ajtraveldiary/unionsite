---
/**
 * Media (redesign, Phase D): the union's latest YouTube videos (only the thumbnail loads
 * until play is tapped, via VideoCard), then photo albums, which arrive with the import.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Brand from '~/components/ui/Brand.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import VideoCard from '~/components/ds/VideoCard.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import type { Lang } from '~/lib/types';
import { site, videos } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<AppLayout lang={lang} title="Media" description="Videos and photos from Kerala NGO Union programmes and campaigns.">
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'About', path: '/about' }, { label: 'Media' }]} />
    <h1 lang="en" class="t-display mt-2">Media</h1>
    <p lang="en" class="mt-1 text-ink-2">Talks, campaigns and programmes. Videos load only when you tap play.</p>

    <section class="mt-8" aria-labelledby="videos">
      <SectionHead title="Latest videos" id="videos" size="h2">
        <a href={site.social.youtube} target="_blank" rel="noopener" lang="en" class="btn btn-secondary btn-sm"><Brand name="youtube" size={16} /> YouTube channel</a>
      </SectionHead>
      <ul class="grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((v) => <li><VideoCard video={v} lang={lang} /></li>)}
      </ul>
    </section>

    <section class="section" aria-labelledby="photos">
      <SectionHead title="Photo albums" id="photos" size="h2" />
      <EmptyState icon="Images" title="Albums are on their way" text="Photos from the current site are moved over in the import, and admins add new albums from their phones." />
    </section>
  </div>
</AppLayout>
