---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/ui/Icon.astro';
import MagazineCover from '~/components/ui/MagazineCover.astro';
import type { Lang } from '~/lib/types';
import { href, monthName } from '~/lib/i18n';
import { issuePath } from '~/lib/content';
import { site, magazineIssues } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const current = magazineIssues[0];
const years = [...new Set(magazineIssues.map((i) => i.year))];
const byYear = years.map((y) => ({ y, issues: magazineIssues.filter((i) => i.year === y) }));
---
<Base lang={lang} title="Kerala Service" description={`Kerala Service, the Kerala NGO Union's monthly magazine — ${magazineIssues.length} issues since November 2014, readable on any phone.`}>
  <PageHero lang={lang} eyebrow="The union's monthly" title="Kerala Service" sub={`${magazineIssues.length} issues since November 2014. Tap any cover to open the issue.`} crumbs={[{ label: 'Kerala Service' }]} />

  <section class="container-x py-10 lg:py-14" aria-labelledby="cur-title">
    <div class="card relative grid items-center gap-8 overflow-hidden p-6 sm:grid-cols-[220px_1fr] sm:p-10">
      <div class="pointer-events-none absolute -left-24 -top-24 size-80 rounded-full bg-gold-soft" aria-hidden="true"></div>
      <a href={href(lang, issuePath(current.year, current.month))} class="cover relative mx-auto block w-[200px] overflow-hidden rounded-md shadow-[0_24px_50px_-18px_rgb(0_0_0/0.5)] ring-1 ring-black/10 sm:w-full">
        <MagazineCover year={current.year} month={current.month} class="block h-auto w-full" />
      </a>
      <div class="relative" lang="en">
        <p class="eyebrow">Current issue</p>
        <h2 id="cur-title" class="display mt-2 !text-[clamp(2rem,1.3rem+2.4vw,3.2rem)]">{monthName(current.month, 'en')} {current.year}</h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={href(lang, issuePath(current.year, current.month))} class="btn btn-primary"><Icon name="BookOpen" size={18} /> Open issue</a>
          <a href={site.magazineSite} target="_blank" rel="noopener" class="btn btn-ghost">Articles site <Icon name="ArrowUpRight" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x" aria-labelledby="arch-title">
    <h2 id="arch-title" lang="en" class="h2">Archive</h2>
    <nav lang="en" aria-label="Jump to year" class="sticky top-[64px] z-20 -mx-4 mt-4 border-b border-line bg-paper/90 px-4 py-3 backdrop-blur lg:mx-0 lg:px-0">
      <ul class="no-scrollbar flex gap-2 overflow-x-auto">
        {years.map((y) => <li><a href={`#y${y}`} class="chip" data-year-chip={y}>{y}</a></li>)}
      </ul>
    </nav>
    {byYear.map(({ y, issues }) => (
      <section id={`y${y}`} class="scroll-mt-36 pt-10" aria-label={String(y)} data-year={y}>
        <h3 lang="en" class="title mb-4 flex items-center gap-3 text-[2.18rem] font-extrabold tabular">{y}<span class="h-px flex-1 bg-line"></span><span class="text-sm font-medium text-ink-3">{issues.length} {issues.length === 1 ? 'issue' : 'issues'}</span></h3>
        <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6 lg:gap-5">
          {issues.map((iss) => (
            <li>
              <a href={href(lang, issuePath(iss.year, iss.month))} class="cover group block">
                <span class="block overflow-hidden rounded-md shadow-[0_10px_24px_-14px_rgb(0_0_0/0.5)] ring-1 ring-black/10 transition duration-300 group-hover:-translate-y-1.5 group-hover:-rotate-1 group-hover:shadow-[0_20px_36px_-16px_rgb(0_0_0/0.55)]">
                  <MagazineCover year={iss.year} month={iss.month} class="block h-auto w-full" />
                </span>
                <span lang="en" class="mt-2 block text-center text-sm font-semibold group-hover:text-brand">{monthName(iss.month, 'en').slice(0, 3)} {iss.year}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</Base>

<script>
  // Highlight the year chip for the section in view
  document.addEventListener('astro:page-load', () => {
    const chips = document.querySelectorAll<HTMLElement>('[data-year-chip]');
    if (!chips.length) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        const y = (e.target as HTMLElement).dataset.year;
        chips.forEach((c) => {
          const on = c.dataset.yearChip === y;
          c.classList.toggle('is-active', on);
          if (on) c.scrollIntoView({ block: 'nearest', inline: 'center' });
        });
      }
    }, { rootMargin: '-40% 0px -55% 0px' });
    document.querySelectorAll('[data-year]').forEach((s) => io.observe(s));
  });
</script>
