---
/**
 * Admin: events (plan, section 10; approved wireframe "Events"). Upcoming events soonest first,
 * or past ones latest first, with a district menu for state roles (district roles see only their
 * district). Past events still waiting for their news report are flagged, so the office
 * remembers to link it after the day.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import StatusBadge from '~/components/admin/StatusBadge.astro';
import { listEvents } from '~/lib/admin/events';
import { isState } from '~/lib/admin/roles';
import { districtBySlug } from '~/data/districts';
import { sortedDistricts } from '~/lib/content';
import { dateParts, formatTime } from '~/lib/i18n';

const user = Astro.locals.user!;
const p = Astro.url.searchParams;
const when = p.get('when') === 'past' ? 'past' : 'upcoming';
const district = isState(user) && (p.get('district') === 'state' || districtBySlug[p.get('district') ?? '']) ? p.get('district')! : undefined;
const rows = await listEvents(user, { when, district });
const districtName = (slug: string | null) => (slug ? districtBySlug[slug]?.name.en.replace('Thiruvananthapuram', 'TVM') : 'State level');
const link = (change: Record<string, string | undefined>) => {
  const u = new URLSearchParams(Astro.url.search);
  for (const [k, v] of Object.entries(change)) v ? u.set(k, v) : u.delete(k);
  return `/admin/events${u.size ? `?${u}` : ''}`;
};
---
<AdminLayout title="Events" section="events">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="t-h1">Events</h1>
      <p class="t-meta mt-1">{isState(user) ? 'State and district programmes' : `Programmes of ${districtName(user.district)} district`}</p>
    </div>
    <a href="/admin/events/new" class="btn btn-primary"><Icon name="Plus" size={18} /> New event</a>
  </div>

  <form method="get" action="/admin/events" class="mt-5 flex flex-wrap items-center gap-2" data-filters>
    <a href={link({ when: undefined })} class="chip" aria-current={when === 'upcoming' ? 'page' : undefined}>Upcoming</a>
    <a href={link({ when: 'past' })} class="chip" aria-current={when === 'past' ? 'page' : undefined}>Past</a>
    {when === 'past' && <input type="hidden" name="when" value="past" />}
    {isState(user) && (
      <select name="district" class="field !min-h-10 w-auto md:w-56" aria-label="District" data-autosubmit>
        <option value="">All districts</option>
        <option value="state" selected={district === 'state'}>State level</option>
        {sortedDistricts().map((d) => <option value={d.slug} selected={district === d.slug}>{d.name.en}</option>)}
      </select>
    )}
    <noscript><button class="btn btn-secondary btn-sm">Filter</button></noscript>
  </form>

  {rows.length === 0 ? (
    <div class="card mt-5 p-8 text-center">
      <Icon name="CalendarDays" size={32} class="mx-auto text-ink-3" />
      <p class="mt-3 font-semibold">{when === 'upcoming' ? 'Nothing coming up' : 'No past events'}</p>
      <p class="t-meta mt-1">{when === 'upcoming' ? 'Events you add appear here and on the site’s calendar.' : 'Events move here once they are over.'}</p>
    </div>
  ) : (
    <ul class="mt-5 divide-y divide-line border-y border-line">
      {rows.map((e) => {
        const d = dateParts(`${e.start}:00+05:30`);
        const needsReport = when === 'past' && e.status === 'published' && !e.reportPostId;
        return (
          <li class="relative flex items-start gap-3 py-3 sm:items-center">
            <div class="w-14 shrink-0 rounded-lg bg-bg-subtle py-1.5 text-center leading-tight">
              <p class="text-[0.6875rem] font-semibold uppercase tracking-wide text-accent-ink">{d.monthShort}</p>
              <p class="text-xl font-bold tabular">{d.d}</p>
            </div>
            <div class="min-w-0 flex-1">
              <a href={`/admin/events/${e.id}`} lang="ml" class="stretched clamp-2 font-semibold leading-snug">{e.titleMl}</a>
              <p class="t-meta">{districtName(e.district)} · {formatTime(`${e.start}:00+05:30`)}{d.y !== new Date().getFullYear() ? ` · ${d.y}` : ''} · <span lang="ml">{e.venueMl}</span></p>
              <p class="mt-1 flex flex-wrap gap-1.5">
                <StatusBadge status={e.status} />
                {e.sample && <span class="badge badge-neutral">Sample</span>}
                {e.enSource === 'ai_draft' && <span class="badge badge-warning">English to approve</span>}
                {needsReport && <span class="badge badge-warning">Over: link the report</span>}
                {e.reportTitle && <span class="badge badge-neutral">Report linked</span>}
              </p>
            </div>
            <span class="btn btn-secondary btn-sm hidden shrink-0 sm:inline-flex" aria-hidden="true">Edit</span>
          </li>
        );
      })}
    </ul>
  )}
  {rows.length === 100 && <p class="t-meta mt-3">Showing the first 100. Narrow by district to see others.</p>}
</AdminLayout>

<script>
  function initEventFilters() {
    const form = document.querySelector<HTMLFormElement>('[data-filters]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    form.querySelectorAll('[data-autosubmit]').forEach((el) => el.addEventListener('change', () => form.requestSubmit()));
    form.addEventListener('formdata', (e) => {
      for (const [k, v] of [...e.formData.entries()]) if (v === '') e.formData.delete(k);
    });
  }
  initEventFilters();
</script>
