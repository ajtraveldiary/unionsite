---
/**
 * Admin: upload orders (plan, section 10; approved wireframe "Orders upload"). Step 1: drop any
 * number of GO PDFs, or choose them on a phone. Step 2: each file gets a row; its GO number, date,
 * title and a likely subject are read from the PDF's text in the browser, and the editor checks
 * them. Duplicates (same GO number or same file) are flagged; scanned PDFs are typed in. Step 3:
 * publish the ready ones together; the rest can be kept as drafts. The page script is
 * src/lib/admin/orders-upload.ts.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { orderSubjects, orderGroups } from '~/data/orders';
import { isState } from '~/lib/admin/roles';

const user = Astro.locals.user!;
---
<AdminLayout title="Upload orders" section="orders">
  {!isState(user) ? (
    <p class="card p-6 text-ink-2">Orders are managed by the state office.</p>
  ) : (
    <div data-order-upload>
      <a href="/admin/orders" class="btn btn-ghost btn-sm -ml-2"><Icon name="ArrowLeft" size={18} /> Orders</a>
      <h1 class="t-h1 mt-2">Upload orders</h1>
      <p class="t-meta mt-1">GO and circular PDFs, up to 50 MB each. Their details are read from the PDF; check them, pick the subject, then publish.</p>

      <label class="mt-5 grid cursor-pointer place-items-center gap-2 rounded-[var(--radius-card)] border-2 border-dashed border-line-strong bg-surface px-4 py-10 text-center hover:border-ink-3" data-drop>
        <Icon name="FileText" size={32} class="text-ink-3" />
        <span class="font-semibold">Drop PDFs here</span>
        <span class="t-meta">or</span>
        <span class="btn btn-secondary btn-sm">Choose files</span>
        <input type="file" accept="application/pdf,.pdf" multiple class="sr-only" data-files />
      </label>

      <div class="mt-6 hidden" data-summary-wrap>
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2">
          <h2 class="t-h2" data-count></h2>
          <p class="t-meta" data-summary aria-live="polite"></p>
        </div>
        <ul class="mt-3 space-y-3" data-rows></ul>

        <div class="sticky bottom-20 z-10 mt-5 flex flex-wrap items-center gap-3 rounded-[var(--radius-card)] border border-line bg-surface p-3 shadow-float lg:bottom-4">
          <p class="flex-1 text-sm font-semibold" data-ready-text></p>
          <button type="button" class="btn btn-secondary" data-save-drafts>Save as drafts</button>
          <button type="button" class="btn btn-primary" data-publish><Icon name="Check" size={18} /> <span data-publish-label>Publish</span></button>
        </div>
      </div>

      <template data-row>
        <li class="card p-4" data-row-item>
          <div class="flex flex-wrap items-center gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-bg-subtle text-xs font-bold text-ink-2">PDF</span>
            <div class="min-w-0 flex-1">
              <p class="truncate font-semibold" data-name></p>
              <p class="t-meta" data-state aria-live="polite"></p>
            </div>
            <span class="badge hidden" data-badge></span>
            <button type="button" class="link" data-remove>Remove</button>
          </div>
          <div class="mt-3 hidden rounded-[var(--radius-control)] border border-warning/30 bg-warning-soft px-3 py-2 text-sm text-warning" data-dup></div>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-fields>
            <label class="block"><span class="t-label">GO number</span><input class="field mt-1" data-f="goNumber" placeholder="G.O.(P) No.…/…/Fin" maxlength="80" /></label>
            <label class="block"><span class="t-label">Date</span><input type="date" class="field mt-1" data-f="goDate" /></label>
            <label class="block sm:col-span-2"><span class="t-label">Title</span><input class="field mt-1" data-f="title" placeholder="From the PDF’s subject line" maxlength="300" /></label>
            <label class="block sm:col-span-2"><span class="t-label">Subject</span>
              <select class="field mt-1" data-f="subject">
                <option value="">Choose…</option>
                {orderGroups.map((g) => <optgroup label={g.name.en}>{orderSubjects.filter((s) => s.group === g.slug).map((s) => <option value={s.slug}>{s.name.en}</option>)}</optgroup>)}
              </select>
            </label>
            <label class="block sm:col-span-2"><span class="t-label">Department · optional</span><input class="field mt-1" data-f="department" maxlength="120" /></label>
            <label class="block sm:col-span-2 lg:col-span-3"><span class="t-label">Summary · optional, Malayalam</span><input lang="ml" class="field mt-1" data-f="summaryMl" placeholder="What changes for employees, in a line" maxlength="600" /></label>
            <label class="flex items-center gap-2 self-end pb-2.5 text-sm"><input type="checkbox" data-f="important" /> Important</label>
          </div>
        </li>
      </template>
    </div>
  )}
</AdminLayout>

<script>
  import { initOrderUpload } from '~/lib/admin/orders-upload';
  initOrderUpload();
</script>
