---
/**
 * Admin: one district's page (approved wireframe "Districts", the district section): the cover
 * photo, the history (a page, opened in the page editor), area committees (with their
 * office-bearers in People & committees) and office addresses with a map link for "Directions".
 * Only office phone numbers go here (plan, section 13). District editors read; their district
 * admin changes. Plain forms; the route (src/pages/admin/districts/[slug].astro) does each action.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import type { loadDistrict } from '~/lib/admin/districts';
import { isState } from '~/lib/admin/roles';
import { ago } from '~/lib/admin/client';

interface Props { d: NonNullable<Awaited<ReturnType<typeof loadDistrict>>>; error?: string; done?: string; editOffice?: number | null; editArea?: number | null }
const { d, error, done, editOffice, editArea } = Astro.props;
const user = Astro.locals.user!;
const office = d.offices.find((o) => o.id === editOffice);
const area = d.areas.find((a) => a.id === editArea);
const doneText: Record<string, string> = {
  cover: 'Cover photo saved.', area: 'Area committee saved.', area_delete: 'Area committee removed.', office: 'Office saved.', office_pin: 'Office saved, with its map pin.',
  office_nopin: 'Office saved. The map link has no position in it, so “Directions” opens the link as it is.', office_delete: 'Office removed.', move: '',
};
const kindLabel = (o: (typeof d.offices)[number]) => (o.kind === 'area' ? `${d.areas.find((a) => a.id === o.areaCommitteeId)?.nameEn || d.areas.find((a) => a.id === o.areaCommitteeId)?.nameMl || 'Area'} area office` : 'District committee office');
---
<AdminLayout title={`${d.name} district`} section="districts">
  {isState(user) && <a href="/admin/districts" class="btn btn-ghost btn-sm -ml-2"><Icon name="ArrowLeft" size={18} /> Districts</a>}
  <div class="mt-2 flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="t-h1">{d.name} district page</h1>
    <a href={`/districts/${d.slug}`} class="link" target="_blank" rel="noopener">View on the site</a>
  </div>
  {!d.canChange && <p class="mt-4 flex items-start gap-2 rounded-[var(--radius-card)] border border-line-strong bg-surface px-4 py-3 text-sm"><Icon name="Lock" size={17} class="mt-0.5" /> Your district admin changes the district page. You can write the history as a draft, and add office-bearers in People & committees.</p>}
  {error && <p class="mt-4 flex items-start gap-2 rounded-[var(--radius-card)] border border-accent/40 bg-accent-soft px-4 py-3 text-sm text-accent-ink" role="alert"><Icon name="CircleAlert" size={17} class="mt-0.5" /> {error}</p>}
  {done && doneText[done] && <p class="mt-4 flex items-start gap-2 rounded-[var(--radius-card)] border border-line-strong bg-surface px-4 py-3 text-sm" role="status"><Icon name="CircleCheck" size={17} class="mt-0.5" /> {doneText[done]}</p>}

  <div class="mt-6 grid gap-8 lg:grid-cols-2">
    <div class="space-y-8">
      <!-- Cover photo -->
      <section aria-labelledby="cover">
        <h2 id="cover" class="t-h2 border-b border-line pb-2">Cover photo</h2>
        <div class="mt-3">
          {d.cover?.url
            ? <img src={d.cover.url} alt="" class="aspect-video w-full rounded-[var(--radius-card)] bg-bg-subtle object-cover" data-cover-img />
            : <div class="grid aspect-video w-full place-items-center rounded-[var(--radius-card)] border border-dashed border-line-strong bg-bg-subtle text-ink-3" data-cover-empty><Icon name="Images" size={28} /></div>}
          {d.canChange && (
            <form method="post" class="mt-2 flex flex-wrap items-center gap-2" data-cover-form>
              <input type="hidden" name="coverMediaId" value={d.cover?.id ?? ''} data-cover-id />
              <label class="btn btn-secondary btn-sm"><Icon name="Upload" size={17} /> {d.cover ? 'Replace' : 'Upload'}<input type="file" accept="image/*" class="sr-only" data-cover-file /></label>
              {d.cover && <button name="action" value="cover_remove" class="btn btn-ghost btn-sm">Remove</button>}
              <span class="t-meta" data-cover-state aria-live="polite">For the district’s card and when its page is shared.</span>
            </form>
          )}
        </div>
      </section>

      <!-- History -->
      <section aria-labelledby="history">
        <div class="flex items-baseline justify-between gap-2 border-b border-line pb-2"><h2 id="history" class="t-h2">History</h2></div>
        {d.history ? (
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <p class="min-w-0 flex-1"><span lang="ml" class="font-semibold">{d.history.titleMl}</span><span class="t-meta block">{d.history.status === 'published' ? 'Published' : 'Draft'}{d.history.enSource === 'ai_draft' ? ' · English to approve' : ''} · updated {ago(d.history.updatedAt)}</span></p>
            <a href={`/admin/pages/${d.history.id}`} class="btn btn-secondary btn-sm">Edit history</a>
          </div>
        ) : (
          <form method="post" action="/admin/pages" class="mt-3">
            <input type="hidden" name="kind" value="district_history" /><input type="hidden" name="district" value={d.slug} />
            <p class="t-meta">No history written yet. It opens in the page editor, Malayalam first.</p>
            <button name="action" value="create_page" class="btn btn-secondary btn-sm mt-2">Write the history</button>
          </form>
        )}
      </section>

      <!-- Area committees -->
      <section aria-labelledby="areas">
        <h2 id="areas" class="t-h2 border-b border-line pb-2">Area committees</h2>
        {d.areas.length === 0 && <p class="t-meta py-3">None yet.</p>}
        <ul class="divide-y divide-line">
          {d.areas.map((a, i) => (
            <li class="flex flex-wrap items-center gap-2 py-2.5">
              <p class="min-w-0 flex-1"><span lang="ml" class="font-semibold">{a.nameMl}</span> <span class="t-meta">{a.nameEn} · {a.members} office-bearers · {a.offices} office</span></p>
              <a href={`/admin/people?c=area:${a.id}`} class="btn btn-ghost btn-sm">Office-bearers</a>
              {d.canChange && (
                <form method="post" class="flex gap-1">
                  <input type="hidden" name="id" value={a.id} />
                  <button name="action" value="area_up" class="btn btn-ghost btn-icon btn-sm" aria-label={`Move ${a.nameEn || a.nameMl} up`} disabled={i === 0}><Icon name="ArrowUp" size={16} /></button>
                  <button name="action" value="area_down" class="btn btn-ghost btn-icon btn-sm" aria-label={`Move ${a.nameEn || a.nameMl} down`} disabled={i === d.areas.length - 1}><Icon name="ArrowDown" size={16} /></button>
                  <a href={`?area=${a.id}#area-form`} class="btn btn-secondary btn-sm">Rename</a>
                  <button name="action" value="area_delete" class="btn btn-ghost btn-sm !text-accent-ink" data-confirm={`Remove the ${a.nameEn || a.nameMl} area committee?`}>Remove</button>
                </form>
              )}
            </li>
          ))}
        </ul>
        {d.canChange && (
          <form method="post" id="area-form" class="mt-3 grid scroll-mt-20 gap-2 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
            {area && <input type="hidden" name="id" value={area.id} />}
            <label class="block"><span class="t-label">{area ? 'Rename · Malayalam' : 'New area · Malayalam'}</span><input name="nameMl" lang="ml" class="field mt-1" value={area?.nameMl ?? ''} required maxlength="120" /></label>
            <label class="block"><span class="t-label">English</span><input name="nameEn" lang="en" class="field mt-1" value={area?.nameEn ?? ''} maxlength="120" /></label>
            <button name="action" value="area_save" class="btn btn-secondary">{area ? 'Save' : 'Add'}</button>
          </form>
        )}
      </section>
    </div>

    <!-- Offices -->
    <section aria-labelledby="offices">
      <h2 id="offices" class="t-h2 border-b border-line pb-2">Office addresses</h2>
      {d.offices.length === 0 && <p class="t-meta py-3">None yet. The district page says “to be confirmed” until one is added.</p>}
      <ul class="divide-y divide-line">
        {d.offices.map((o, i) => (
          <li class="flex flex-wrap items-start gap-2 py-3">
            <div class="min-w-0 flex-1">
              <p class="font-semibold">{kindLabel(o)}</p>
              <p lang="ml" class="whitespace-pre-line text-sm text-ink-2">{o.addressMl}</p>
              <p class="t-meta">{[o.phone && `Office phone ${o.phone}`, o.email, o.pinned ? 'Map pin set' : o.mapUrl ? 'Map link' : 'No map'].filter(Boolean).join(' · ')}</p>
            </div>
            {d.canChange && (
              <form method="post" class="flex gap-1">
                <input type="hidden" name="id" value={o.id} />
                <button name="action" value="office_up" class="btn btn-ghost btn-icon btn-sm" aria-label="Move up" disabled={i === 0}><Icon name="ArrowUp" size={16} /></button>
                <button name="action" value="office_down" class="btn btn-ghost btn-icon btn-sm" aria-label="Move down" disabled={i === d.offices.length - 1}><Icon name="ArrowDown" size={16} /></button>
                <a href={`?office=${o.id}#office-form`} class="btn btn-secondary btn-sm">Edit</a>
                <button name="action" value="office_delete" class="btn btn-ghost btn-sm !text-accent-ink" data-confirm="Remove this office address?">Remove</button>
              </form>
            )}
          </li>
        ))}
      </ul>
      {d.canChange && (
        <form method="post" id="office-form" class="card mt-4 scroll-mt-20 space-y-3 p-4">
          <p class="font-semibold">{office ? 'Edit office' : 'Add an office'}</p>
          {office && <input type="hidden" name="id" value={office.id} />}
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block"><span class="t-label">Kind</span>
              <select name="kind" class="field mt-1"><option value="district" selected={office?.kind !== 'area'}>District committee office</option><option value="area" selected={office?.kind === 'area'} disabled={!d.areas.length}>Area committee office</option></select>
            </label>
            <label class="block"><span class="t-label">Area committee</span>
              <select name="areaCommitteeId" class="field mt-1"><option value="">—</option>{d.areas.map((a) => <option value={a.id} selected={office?.areaCommitteeId === a.id}>{a.nameEn || a.nameMl}</option>)}</select>
            </label>
          </div>
          <label class="block"><span class="t-label">Address · Malayalam</span><textarea name="addressMl" lang="ml" rows="3" class="field grow-field mt-1" required maxlength="500">{office?.addressMl ?? ''}</textarea></label>
          <label class="block"><span class="t-label">Address · English · optional</span><textarea name="addressEn" lang="en" rows="3" class="field grow-field mt-1" maxlength="500">{office?.addressEn ?? ''}</textarea></label>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block"><span class="t-label">Office phone</span><input name="phone" type="tel" class="field mt-1" value={office?.phone ?? ''} maxlength="30" /></label>
            <label class="block"><span class="t-label">Email · optional</span><input name="email" type="email" class="field mt-1" value={office?.email ?? ''} maxlength="120" /></label>
          </div>
          <label class="block"><span class="t-label">Map link · optional</span><input name="mapUrl" type="url" class="field mt-1" value={office?.mapUrl ?? ''} placeholder="Open the office in Google Maps, Share, copy the link" />
            <span class="t-meta mt-1 block">Gives the district page and Contact a “Directions” button. Only office numbers are published, never personal ones.</span></label>
          <div class="flex gap-2"><button name="action" value="office_save" class="btn btn-primary">Save</button>{office && <a href="?#office-form" class="btn btn-ghost">Cancel</a>}</div>
        </form>
      )}
    </section>
  </div>
</AdminLayout>

<script>
  import { toast } from '~/lib/admin/client';
  import { prepareImage } from '~/lib/admin/image-prep';

  function initDistrict() {
    document.querySelectorAll<HTMLFormElement>('form').forEach((f) => {
      if (f.dataset.ready) return;
      f.dataset.ready = '1';
      f.addEventListener('submit', (e) => {
        const msg = (e.submitter as HTMLElement | null)?.dataset.confirm;
        if (msg && !window.confirm(msg)) e.preventDefault();
      });
    });
    // Cover: made smaller here, uploaded, then saved for the district straight away
    const form = document.querySelector<HTMLFormElement>('[data-cover-form]');
    form?.querySelector<HTMLInputElement>('[data-cover-file]')?.addEventListener('change', async (e) => {
      const input = e.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      const state = form.querySelector<HTMLElement>('[data-cover-state]')!;
      const alt = window.prompt('Describe the photo (read out by screen readers)')?.trim();
      if (!alt) return toast('The photo needs a description.', 'error');
      try {
        state.textContent = 'Preparing and uploading…';
        const res = await fetch('/api/admin/media', { method: 'POST', body: await prepareImage(file, alt), credentials: 'same-origin' });
        const out = (await res.json().catch(() => ({}))) as { item?: { id: number }; error?: string };
        if (!res.ok || !out.item) throw new Error(out.error ?? 'The upload failed.');
        form.querySelector<HTMLInputElement>('[data-cover-id]')!.value = String(out.item.id);
        const go = Object.assign(document.createElement('button'), { name: 'action', value: 'cover', hidden: true });
        form.append(go);
        form.requestSubmit(go);
      } catch (err) {
        state.textContent = '';
        toast(err instanceof Error ? err.message : 'The photo could not be used.', 'error');
      }
    });
  }
  initDistrict();
</script>
