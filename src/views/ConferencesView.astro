---
/**
 * State conferences (approved wireframe "Conferences"): a vertical timeline from the admin's
 * conference list, newest first with a switch to read from the 1st, and "Go to" a number. The
 * first 12 show; "Show all" opens the rest. Entries with only a number, year and place still
 * appear, so the record is complete; each opens its own page.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import type { Lang } from '~/lib/types';
import { href, t, langOf, ordinal } from '~/lib/i18n';
import { publishedConferences } from '~/lib/content';
import { confWhen } from '~/lib/conferences';
import { site } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const list = await publishedConferences();
const FIRST = 12;
const firstLine = (s?: string) => s?.split(/\n/).map((l) => l.trim()).find(Boolean);
---
<AppLayout lang={lang} title="State conferences" description={`The Kerala NGO Union's state conferences since ${site.founded}.`}>
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'About', path: '/about' }, { label: 'Conferences' }]} />
    <h1 lang="en" class="t-display mt-2">State conferences</h1>
    <p lang="en" class="mt-3 max-w-2xl text-lg text-ink-2">{list.length ? `${list[0].number} conferences since ${site.founded}.` : ''} Each set the union’s demands and elected its state committee.</p>
    {list.length > 1 && (
      <div lang="en" class="mt-5 flex flex-wrap items-center gap-2" data-conf-tools>
        <button type="button" class="chip" aria-pressed="true" data-conf-order="newest">Newest first</button>
        <button type="button" class="chip" aria-pressed="false" data-conf-order="oldest">From the 1st</button>
        <form class="ml-auto flex items-center gap-2 text-sm" data-conf-go>
          <label for="conf-go">Go to</label>
          <input id="conf-go" class="field !min-h-9 w-20 text-sm" inputmode="numeric" pattern="[0-9]*" placeholder="No." />
          <button class="btn btn-secondary btn-sm">Go</button>
        </form>
      </div>
    )}
    <p lang="en" class="t-meta mt-2" role="status" data-conf-message></p>
  </div>

  {list.length ? (
    <div class="wrap mt-6">
      <ol data-conf-list>
        {list.map((c, i) => {
          const line = firstLine(c.report);
          const extras = [c.report && 'Report', c.albumSlug && 'Photos'].filter(Boolean).join(' · ');
          return (
            <li id={`conf-${c.number}`} class="conf relative grid scroll-mt-24 grid-cols-[3.5rem_minmax(0,1fr)] gap-4 pb-6" hidden={i >= FIRST} data-conf>
              <span class="conf-line absolute bottom-0 left-[1.75rem] top-14 w-0.5 bg-line" aria-hidden="true"></span>
              <span lang="en" class:list={['relative grid size-14 place-items-center rounded-full text-lg font-bold tabular', i === 0 ? 'bg-ink text-bg' : 'border-2 border-line-strong bg-bg']}>{c.number}</span>
              <a href={href(lang, `/about/conferences/${c.number}`)} class="card card-hover block p-4">
                <p lang="en" class="t-label">{[`${ordinal(c.number)} conference`, confWhen(c, 'year')].filter(Boolean).join(' · ')}</p>
                {c.place && <p lang={langOf(c.place, lang)} class="mt-1 font-semibold">{t(c.place, lang)}</p>}
                {line && <p lang="ml" class="clamp-2 mt-1 text-ink-2">{line}</p>}
                {extras && <p lang="en" class="t-meta mt-1">{extras}</p>}
              </a>
            </li>
          );
        })}
      </ol>
      {list.length > FIRST && <button type="button" lang="en" class="btn btn-secondary ml-[4.5rem]" data-conf-more>Show all {list.length}</button>}
    </div>
  ) : (
    <div class="wrap mt-6"><EmptyState icon="Flag" title="No conferences listed yet" text="The state office is adding the conferences, from the 1st onwards." /></div>
  )}
</AppLayout>

<style>
  [data-conf-list] > li:last-of-type:not([hidden]) .conf-line,
  [data-conf-list] > li:has(+ li[hidden]) .conf-line { display: none; }
</style>

<script>
  function initConferences() {
    const list = document.querySelector<HTMLOListElement>('[data-conf-list]');
    if (!list || list.dataset.ready) return;
    list.dataset.ready = '1';
    const FIRST = 12;
    let all = false;
    const more = document.querySelector<HTMLButtonElement>('[data-conf-more]');
    const message = document.querySelector<HTMLElement>('[data-conf-message]')!;
    const show = () => {
      [...list.children].forEach((li, i) => ((li as HTMLElement).hidden = !all && i >= FIRST));
      if (more) more.hidden = all;
    };
    more?.addEventListener('click', () => { all = true; show(); });
    document.querySelectorAll<HTMLButtonElement>('[data-conf-order]').forEach((b) => b.addEventListener('click', () => {
      if (b.getAttribute('aria-pressed') === 'true') return;
      document.querySelectorAll('[data-conf-order]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      list.append(...[...list.children].reverse());
      show();
    }));
    document.querySelector<HTMLFormElement>('[data-conf-go]')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const n = Number((e.target as HTMLFormElement).querySelector('input')!.value);
      const li = document.getElementById(`conf-${n}`);
      if (!li) { message.textContent = n ? `Conference no. ${n} isn’t listed yet.` : 'Type a conference number.'; return; }
      message.textContent = '';
      all = true; show();
      li.scrollIntoView({ behavior: 'smooth' });
      li.querySelector('a')?.focus({ preventScroll: true });
    });
  }
  initConferences();
</script>
