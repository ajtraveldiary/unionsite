---
/**
 * A photo album (approved wireframe "Photo album"): title, where and when, the number of photos
 * and the conference it belongs to, then the photos in their own shapes (a masonry grid: 2
 * columns on phones, up to 4 on laptops), loading as you scroll. Tapping one opens the lightbox:
 * swipe or arrows to move, Esc to close, the caption in the page's language when an English one
 * exists. Albums are made in Admin → Media.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import ShareBar from '~/components/ds/ShareBar.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import type { Album, AlbumPhoto, Lang } from '~/lib/types';
import { href, t, langOf, formatDate, ordinal } from '~/lib/i18n';
import { districtBySlug } from '~/data/districts';

interface Props { lang: Lang; album: Album; photos: AlbumPhoto[]; conference?: number }
const { lang, album: a, photos, conference } = Astro.props;
const L = (p: string) => href(lang, p);
const title = t(a.title, lang);
const district = a.district ? districtBySlug[a.district] : undefined;
const pageUrl = new URL(L(`/gallery/${a.slug}`), Astro.site).toString();
const caption = (p: AlbumPhoto) => t(p.caption, lang);
const items = JSON.stringify(photos.map((p) => ({ src: p.src, srcset: p.srcset, caption: caption(p), lang: langOf(p.caption, lang) })));
---
<AppLayout lang={lang} title={a.title.en ?? a.title.ml} description={`Photos: ${a.title.en ?? a.title.ml}`}>
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[...(district ? [{ label: district.name.en, path: `/districts/${district.slug}` }] : []), { label: 'Media', path: '/gallery' }, { label: 'Album' }]} />
    <h1 lang={langOf(a.title, lang)} class="t-display mt-2">{title}</h1>
    <p lang="en" class="t-meta mt-2">
      {[district?.name.en, a.date && formatDate(a.date, 'en', 'short'), `${photos.length} ${photos.length === 1 ? 'photo' : 'photos'}`].filter(Boolean).join(' · ')}
      {conference && <Fragment> · <a href={L(`/about/conferences/${conference}`)} class="link">{ordinal(conference)} state conference</a></Fragment>}
    </p>
    <ShareBar url={pageUrl} title={title} class="mt-4" />
  </div>

  <section class="wrap mt-6" aria-label="Photos">
    {photos.length ? (
      <ul class="columns-2 gap-2 sm:columns-3 lg:columns-4" data-album={items}>
        {photos.map((p, i) => (
          <li class="mb-2 break-inside-avoid">
            <button type="button" class="block w-full overflow-hidden rounded-[var(--radius-control)] bg-bg-subtle focus-visible:outline-2" data-photo={i} aria-label={`Open photo ${i + 1} of ${photos.length}${caption(p) ? `: ${caption(p)}` : ''}`}>
              <img src={p.src} srcset={p.srcset} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw" width={p.width} height={p.height} alt="" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" class="block h-auto w-full" />
            </button>
          </li>
        ))}
      </ul>
    ) : <EmptyState icon="Images" title="No photos in this album yet" />}
  </section>

  <dialog class="lightbox m-0 size-full max-h-none max-w-none bg-black/95 p-0 text-white backdrop:bg-black/80" aria-label="Photo" data-lightbox>
    <div class="flex h-full flex-col">
      <div lang="en" class="flex items-center justify-between px-4 py-3 text-sm">
        <span class="tabular" data-lb-count aria-live="polite"></span>
        <button type="button" class="inline-flex min-h-11 items-center gap-1.5 rounded-[var(--radius-control)] border border-white/30 px-3" data-lb-close>Close <Icon name="X" size={18} /></button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16" data-lb-stage>
        <img alt="" class="max-h-full max-w-full select-none object-contain" data-lb-img />
        <button type="button" class="absolute left-3 top-1/2 hidden size-11 -translate-y-1/2 place-items-center rounded-full border border-white/30 sm:grid" data-lb-prev aria-label="Previous photo"><Icon name="ChevronLeft" size={22} /></button>
        <button type="button" class="absolute right-3 top-1/2 hidden size-11 -translate-y-1/2 place-items-center rounded-full border border-white/30 sm:grid" data-lb-next aria-label="Next photo"><Icon name="ChevronRight" size={22} /></button>
      </div>
      <p class="min-h-12 px-4 py-3 text-center text-sm" data-lb-caption></p>
    </div>
  </dialog>
</AppLayout>

<script>
  interface Item { src: string; srcset?: string; caption: string; lang: string }
  function initAlbum() {
    const grid = document.querySelector<HTMLElement>('[data-album]');
    if (!grid || grid.dataset.ready) return;
    grid.dataset.ready = '1';
    const items = JSON.parse(grid.dataset.album!) as Item[];
    const box = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = box.querySelector<HTMLElement>('[data-lb-count]')!;
    const cap = box.querySelector<HTMLElement>('[data-lb-caption]')!;
    let at = 0;
    const show = (i: number) => {
      at = (i + items.length) % items.length;
      const it = items[at];
      img.src = it.src;
      if (it.srcset) { img.srcset = it.srcset; img.sizes = '100vw'; } else img.removeAttribute('srcset');
      img.alt = it.caption;
      count.textContent = `${at + 1} / ${items.length}`;
      cap.textContent = it.caption;
      cap.lang = it.lang;
      // The next photo starts loading now, so swiping on feels instant
      const next = items[(at + 1) % items.length];
      if (next) Object.assign(new Image(), { src: next.src });
    };
    grid.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-photo]');
      if (!b) return;
      show(Number(b.dataset.photo));
      box.showModal();
    });
    box.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(at - 1));
    box.querySelector('[data-lb-next]')!.addEventListener('click', () => show(at + 1));
    box.querySelector('[data-lb-close]')!.addEventListener('click', () => box.close());
    box.addEventListener('close', () => grid.querySelector<HTMLElement>(`[data-photo="${at}"]`)?.focus());
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });
    // Swipe on phones
    const stage = box.querySelector<HTMLElement>('[data-lb-stage]')!;
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener('click', (e) => { if (e.target === stage) box.close(); });
  }
  initAlbum();
</script>
