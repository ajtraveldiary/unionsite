---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Poster from '~/components/ui/Poster.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Lang, Person } from '~/lib/types';
import { site, stateCommittee, roleLabels } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const by = (...roles: Person['role'][]) => stateCommittee.filter((p) => p.body === 'state' && roles.includes(p.role));
const leaders = by('president', 'general_secretary', 'treasurer');
const officers = by('vice_president', 'secretary');
const secretariat = by('secretariat_member');
const women = stateCommittee.filter((p) => p.body === 'women_subcommittee');
const initials = (en: string) => en.replace(/[^A-Za-z ]/g, ' ').trim().split(/\s+/).slice(-2).map((w) => w[0]).join('');
const nameLang = lang === 'en' ? 'en' : 'ml';
const primary = (p: Person) => (lang === 'en' ? p.name.en : p.name.ml);
---
<Base lang={lang} title="State committee" description="Office-bearers and secretariat of the Kerala NGO Union state committee.">
  <PageHero lang={lang} eyebrow="About the union" title="State committee" sub={`Elected at the state conference, the committee leads the union between conferences. ${site.conferences} state conferences have been held since ${site.founded}.`} crumbs={[{ label: 'About' }, { label: 'State committee' }]} />

  <div class="container-x py-10 lg:py-14">
    <section aria-labelledby="ob-title">
      <h2 id="ob-title" lang="en" class="sr-only">Office-bearers</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {leaders.map((p, i) => (
          <article class="card lift relative overflow-hidden reveal">
            <div class="relative h-40 overflow-hidden">
              <Poster cover={{ kind: 'poster', word: { ml: initials(p.name.en), en: initials(p.name.en) }, motif: (['rays', 'rings', 'stripes'] as const)[i] }} seed={i + 1} lang="en" class="absolute inset-0 size-full" />
            </div>
            <div class="relative -mt-11 px-5 pb-6">
              <div class="grid size-[88px] place-items-center rounded-full border-4 border-surface bg-ink text-[1.7rem] font-extrabold text-paper" aria-hidden="true">{initials(p.name.en)}</div>
              <p lang="en" class="eyebrow mt-3">{roleLabels[p.role].en}</p>
              <h3 lang={nameLang} class="h2 mt-1">{primary(p)}</h3>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {officers.map((p) => (
          <article class="card flex items-center gap-4 p-4">
            <span class="grid size-14 shrink-0 place-items-center rounded-full bg-brand-soft text-lg font-extrabold text-brand" aria-hidden="true">{initials(p.name.en)}</span>
            <div class="min-w-0">
              <p lang="en" class="text-xs font-semibold uppercase tracking-wider text-ink-3">{roleLabels[p.role].en}</p>
              <h3 lang={nameLang} class="h3">{primary(p)}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="sec-title" class="mt-16">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div lang="en">
          <p class="eyebrow mb-2 flex items-center gap-2"><span class="inline-block h-[3px] w-6 bg-brand-solid"></span>{secretariat.length} members</p>
          <h2 id="sec-title" class="h1">Secretariat</h2>
        </div>
        <label lang="en" class="relative w-full sm:w-64">
          <span class="sr-only">Find a name</span>
          <Icon name="Search" size={17} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" />
          <input type="search" data-name-filter placeholder="Find a name" class="h-11 w-full rounded-full border border-line-strong bg-surface pl-10 pr-4 text-sm" />
        </label>
      </div>
      <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3" data-name-list>
        {secretariat.map((p) => (
          <li class="flex items-center gap-3 rounded-xl border border-line bg-surface px-3 py-2.5" data-names={`${p.name.ml} ${p.name.en}`.toLowerCase()}>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper-2 text-xs font-bold text-ink-2" aria-hidden="true">{initials(p.name.en)}</span>
            <span class="min-w-0">
              <span lang={nameLang} class="block font-semibold leading-snug">{primary(p)}</span>
            </span>
          </li>
        ))}
      </ul>
      <p lang="en" class="hidden py-6 text-center text-ink-3" data-name-empty>No member matches that name.</p>
    </section>

    <section aria-labelledby="ws-title" class="mt-16">
      <div class="card relative overflow-hidden p-6 sm:p-8">
        <div class="pointer-events-none absolute -right-16 -top-16 size-56 rounded-full bg-gold-soft" aria-hidden="true"></div>
        <p lang="en" class="eyebrow relative">Sub-committee</p>
        <h2 id="ws-title" lang="en" class="h1 relative mt-1">Women's sub-committee</h2>
        <ul class="relative mt-6 grid gap-3 sm:grid-cols-3">
          {women.map((p) => (
            <li class="rounded-xl border border-line bg-paper p-4">
              <p lang="en" class="text-xs font-semibold uppercase tracking-wider text-gold">{roleLabels[p.role].en}</p>
              <p lang={nameLang} class="mt-1 text-lg font-bold">{primary(p)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <p lang="en" class="mt-8 flex items-start gap-2 text-sm text-ink-3"><Icon name="Info" size={16} class="mt-0.5 shrink-0" /> Names come from the current website. English spellings are drafts awaiting the state office's review; photos are added through the admin panel.</p>
  </div>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const input = document.querySelector<HTMLInputElement>('[data-name-filter]');
    if (!input) return;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll<HTMLElement>('[data-name-list] > li').forEach((li) => {
        const ok = !q || li.dataset.names!.includes(q);
        li.hidden = !ok;
        if (ok) shown++;
      });
      document.querySelector('[data-name-empty]')?.classList.toggle('hidden', shown > 0);
    });
  });
</script>
