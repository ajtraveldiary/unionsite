---
/**
 * State committee (redesign, Phase D): the three office-bearers, then vice presidents and
 * secretaries, the secretariat (with a name finder) and the women's sub-committee. Names
 * follow the page language; photos are added through the admin panel, initials stand in.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import PersonAvatar from '~/components/ds/PersonAvatar.astro';
import type { Lang, Person } from '~/lib/types';
import { site, roleLabels } from '~/data/site';
import { committee } from '~/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const [state, women] = await Promise.all([committee('state'), committee('women_subcommittee')]);
const by = (...roles: Person['role'][]) => state.filter((p) => roles.includes(p.role));
const leaders = by('president', 'general_secretary', 'treasurer');
const officers = by('vice_president', 'secretary');
const secretariat = by('secretariat_member', 'committee_member');
const nameLang = lang === 'en' ? 'en' : 'ml';
const name = (p: Person) => (lang === 'en' ? p.name.en : p.name.ml);
---
<AppLayout lang={lang} title="State committee" description="Office-bearers and secretariat of the Kerala NGO Union state committee.">
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'About', path: '/about' }, { label: 'State committee' }]} />
    <h1 lang="en" class="t-display mt-2">State committee</h1>
    <p lang="en" class="mt-1 max-w-2xl text-ink-2">Elected at the state conference, the committee leads the union between conferences. {site.conferences} state conferences have been held since {site.founded}.</p>

    <section class="mt-8" aria-labelledby="office-bearers">
      <h2 id="office-bearers" lang="en" class="sr-only">Office-bearers</h2>
      <ul class="grid gap-3 sm:grid-cols-3">
        {leaders.map((p) => (
          <li class="card flex items-center gap-4 p-4">
            <PersonAvatar person={p} size={64} tone="accent" />
            <div class="min-w-0">
              <p lang="en" class="t-label">{roleLabels[p.role].en}</p>
              <p lang={nameLang} class="t-h2 mt-0.5">{name(p)}</p>
            </div>
          </li>
        ))}
      </ul>
      <ul class="mt-3 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
        {officers.map((p) => (
          <li class="flex items-center gap-3 border-b border-line py-3">
            <PersonAvatar person={p} size={40} />
            <div class="min-w-0">
              <p lang="en" class="t-meta">{roleLabels[p.role].en}</p>
              <p lang={nameLang} class="font-semibold leading-snug">{name(p)}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="secretariat">
      <SectionHead title="Secretariat" id="secretariat">
        <label lang="en" class="relative hidden w-56 sm:block">
          <span class="sr-only">Find a name</span>
          <Icon name="Search" size={16} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" />
          <input type="search" data-name-filter placeholder="Find a name" class="field !min-h-9 pl-9 text-sm" />
        </label>
      </SectionHead>
      <label lang="en" class="relative mb-3 block sm:hidden">
        <span class="sr-only">Find a name</span>
        <Icon name="Search" size={16} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" />
        <input type="search" data-name-filter placeholder="Find a name" class="field pl-9 text-sm" />
      </label>
      <ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3" data-name-list>
        {secretariat.map((p) => (
          <li class="flex items-center gap-3 border-b border-line py-2.5" data-names={`${p.name.ml} ${p.name.en}`.toLowerCase()}>
            <PersonAvatar person={p} size={36} />
            <span lang={nameLang} class="font-medium">{name(p)}</span>
          </li>
        ))}
      </ul>
      <p lang="en" class="t-meta py-4" data-name-empty hidden>No member matches that name.</p>
    </section>

    <section class="section" aria-labelledby="women">
      <SectionHead title="Women's sub-committee" id="women" />
      <ul class="grid gap-x-8 sm:grid-cols-3">
        {women.map((p) => (
          <li class="border-b border-line py-3">
            <p lang="en" class="t-meta">{roleLabels[p.role].en}</p>
            <p lang={nameLang} class="font-semibold">{name(p)}</p>
          </li>
        ))}
      </ul>
    </section>

    <p lang="en" class="t-meta mt-8 flex items-start gap-2"><Icon name="Info" size={16} class="mt-0.5 shrink-0" /> Names come from the current website. English spellings are drafts awaiting the state office's review; photos are added through the admin panel.</p>
  </div>
</AppLayout>

<script>
  function initNames() {
    const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-name-filter]')];
    if (!inputs.length || inputs[0].dataset.ready) return;
    inputs[0].dataset.ready = '1';
    const items = [...document.querySelectorAll<HTMLElement>('[data-name-list] > li')];
    const empty = document.querySelector<HTMLElement>('[data-name-empty]')!;
    // The phone and laptop boxes stay in step
    inputs.forEach((input) => input.addEventListener('input', () => {
      inputs.forEach((other) => { if (other !== input) other.value = input.value; });
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) { li.hidden = !!q && !li.dataset.names!.includes(q); if (!li.hidden) shown++; }
      empty.hidden = shown > 0;
    }));
  }
  initNames();
</script>
