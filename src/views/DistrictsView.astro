---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/ui/Icon.astro';
import KeralaMap from '~/components/islands/KeralaMap';
import mapData from '~/data/geo/kerala-map.json';
import type { Lang } from '~/lib/types';
import { t, langOf, formatDate } from '~/lib/i18n';
import { sortedDistricts, postsForDistrict, eventsForDistrict, districtUrl, districtMapInfo, liveliestDistrict } from '~/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const list = sortedDistricts().map((d) => ({ d, posts: postsForDistrict(d.slug), events: eventsForDistrict(d.slug) }));
---
<Base lang={lang} title="District committees" description="The Kerala NGO Union's 15 district committees — news, events and office-bearers from every district.">
  <PageHero lang={lang} eyebrow="15 committees, one union" title="District committees" sub="Pick a district on the map to see its latest news, or open its hub for events and office-bearers." crumbs={[{ label: 'Districts' }]} />

  <section class="container-x py-10 lg:py-14" aria-label="Map of district committees">
    <KeralaMap client:load size="full" viewBox={mapData.viewBox} districts={mapData.districts} info={districtMapInfo(lang)} initial={liveliestDistrict()} />
  </section>

  <section class="container-x" aria-labelledby="all-title">
    <h2 id="all-title" lang="en" class="h2 mb-6">All districts, south to north</h2>
    <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {list.map(({ d, posts, events }) => (
        <li class="reveal">
          <article class="group card lift relative flex h-full gap-4 overflow-hidden p-5">
            <span class="num text-[2.6rem] font-extrabold leading-none" aria-hidden="true">{String(d.sortOrder).padStart(2, '0')}</span>
            <div class="min-w-0 flex-1">
              <h3 lang="en" class="title text-[1.5rem] font-bold leading-snug transition-colors group-hover:text-brand">
                <a href={districtUrl(d.slug, lang)} class="stretched">{d.name.en}</a>
              </h3>
              <p lang="en" class="text-sm text-ink-3">HQ {d.hq.en}</p>
              {posts[0] ? (
                <p class="mt-3 border-t border-line pt-3 text-sm">
                  <span lang="en" class="block text-xs font-semibold uppercase tracking-wider text-ink-3">Latest · {formatDate(posts[0].date, 'en', 'short')}</span>
                  <span lang={langOf(posts[0].title, lang)} class="clamp-2 mt-0.5 font-semibold leading-snug text-ink-2">{t(posts[0].title, lang)}</span>
                </p>
              ) : (
                <p lang="en" class="mt-3 border-t border-dashed border-line pt-3 text-sm text-ink-3">No district news yet</p>
              )}
              <p lang="en" class="mt-3 flex flex-wrap gap-1.5">
                <span class="badge badge-ink"><Icon name="Newspaper" size={12} /> {posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
                {events.length > 0 && <span class="badge badge-brand"><Icon name="CalendarDays" size={12} /> {events.length} upcoming</span>}
              </p>
            </div>
            <Icon name="ArrowUpRight" size={18} class="text-ink-3 transition group-hover:text-brand" />
          </article>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .num { color: transparent; -webkit-text-stroke: 1.5px var(--line-strong); transition: -webkit-text-stroke-color 0.2s; }
  .group:hover .num { -webkit-text-stroke-color: var(--brand); }
</style>
