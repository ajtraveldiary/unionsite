---
/**
 * Districts (redesign, Phase D): all 15 district committees, south to north, each with its
 * HQ, counts and latest story; the map sits beside the list on tablets and laptops (sticky)
 * and lights up the district under the pointer, both ways. Phones get the list only, so the
 * content comes first.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import KeralaMap from '~/components/ds/KeralaMap.astro';
import type { Lang } from '~/lib/types';
import { t, langOf, formatDate } from '~/lib/i18n';
import { sortedDistricts, latestPerDistrict, districtPostCounts, upcomingEventsByDistrict, districtUrl } from '~/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const [latest, counts, events] = await Promise.all([latestPerDistrict(1), districtPostCounts(), upcomingEventsByDistrict()]);
const list = sortedDistricts().map((d) => ({ d, latest: latest[d.slug][0], count: counts[d.slug] ?? 0, events: events[d.slug] ?? [] }));
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
<AppLayout lang={lang} title="Districts" description="The Kerala NGO Union's 15 district committees: news, events and office-bearers from every district.">
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'Districts' }]} />
    <h1 lang="en" class="t-display mt-2">Districts</h1>
    <p lang="en" class="mt-1 max-w-2xl text-ink-2">The union's 15 district committees, from Thiruvananthapuram in the south to Kasaragod in the north.</p>

    <div class="mt-6 grid gap-x-12 md:grid-cols-[minmax(0,1fr)_240px] lg:grid-cols-[minmax(0,1fr)_300px]">
      <ol class="divide-y divide-line border-y border-line" data-district-list>
        {list.map(({ d, latest, count, events }) => (
          <li data-district-row={d.slug}>
            <article class="group relative flex gap-4 py-3.5">
              <span lang="en" class="w-6 shrink-0 pt-0.5 text-right text-sm font-semibold tabular text-ink-3" aria-hidden="true">{d.sortOrder}</span>
              <div class="min-w-0 flex-1">
                <h2 lang="en" class="t-h3"><a href={districtUrl(d.slug, lang)} class="stretched group-hover:text-accent-ink">{d.name.en}</a></h2>
                <p lang="en" class="t-meta">HQ {d.hq.en} · {plural(count, 'post')}{events.length > 0 && ` · ${plural(events.length, 'upcoming event')}`}</p>
                {latest && (
                  <p class="mt-1 text-sm text-ink-2">
                    <span lang="en" class="text-ink-3">Latest, {formatDate(latest.date, 'en', 'short')}: </span>
                    <span lang={langOf(latest.title, lang)}>{t(latest.title, lang)}</span>
                  </p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ol>

      <div class="hidden md:block">
        <div class="sticky top-24">
          <KeralaMap lang={lang} withNews={Object.keys(counts)} class="max-h-[calc(100dvh-8rem)]" />
          <p lang="en" class="t-meta mt-2 flex items-center justify-end gap-2"><span class="inline-block size-3 rounded-sm border border-line-strong bg-accent-soft"></span> Has news</p>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  // Hovering a row lights its district on the map, and the other way round
  function initDistricts() {
    const list = document.querySelector<HTMLElement>('[data-district-list]');
    if (!list || list.dataset.ready) return;
    list.dataset.ready = '1';
    const light = (slug: string | undefined, on: boolean) => {
      if (!slug) return;
      document.querySelectorAll(`[data-map-district="${slug}"], [data-district-row="${slug}"]`).forEach((el) => el.classList.toggle('is-on', on));
    };
    const pairs: [string, string][] = [['[data-district-row]', 'districtRow'], ['[data-map-district]', 'mapDistrict']];
    for (const [sel, key] of pairs) {
      document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
        const slug = el.dataset[key];
        el.addEventListener('pointerenter', () => light(slug, true));
        el.addEventListener('pointerleave', () => light(slug, false));
        el.addEventListener('focusin', () => light(slug, true));
        el.addEventListener('focusout', () => light(slug, false));
      });
    }
  }
  initDistricts();
  document.addEventListener('astro:page-load', initDistricts);
</script>

<style>
  [data-district-row].is-on :global(h2 a) { color: var(--accent-ink); }
</style>
