---
/**
 * A district committee (redesign, Phase D), as in the wireframe: name, HQ and counts up top
 * with a small locator map; tabs for News, Office-bearers, Offices and Gallery (each with its
 * own link, e.g. #office-bearers, so a secretary can share one); the district's events beside
 * them on laptops; previous / next district at the foot.
 *
 * Office-bearers, office addresses and photos come from each district before launch
 * (plan, section 17), so those tabs say so for now.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import Tabs from '~/components/ds/Tabs.astro';
import StoryItem from '~/components/ds/StoryItem.astro';
import EventCard from '~/components/ds/EventCard.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import KeralaMap from '~/components/ds/KeralaMap.astro';
import type { Lang } from '~/lib/types';
import { href } from '~/lib/i18n';
import { sortedDistricts, postsForDistrict, eventsForDistrict, districtUrl } from '~/lib/content';
import { districtBySlug } from '~/data/districts';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const L = (p: string) => href(lang, p);
const d = districtBySlug[slug];
const all = sortedDistricts();
const i = all.findIndex((x) => x.slug === slug);
const prev = all[i - 1];
const next = all[i + 1];
const allDistrictPosts = postsForDistrict(slug);
// The newest 20 here; the rest are in News, filtered to this district
const posts = allDistrictPosts.slice(0, 20);
const events = eventsForDistrict(slug);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const bearerRoles = ['President', 'Secretary', 'Treasurer'];
---
<AppLayout lang={lang} title={`${d.name.en} district`} description={`News, events and office-bearers of the Kerala NGO Union ${d.name.en} district committee.`}>
  <div class="border-b border-line bg-bg-subtle">
    <div class="wrap grid items-center gap-6 pb-6 pt-5 md:grid-cols-[minmax(0,1fr)_120px] lg:pt-8">
      <div>
        <Breadcrumbs lang={lang} items={[{ label: 'Districts', path: '/districts' }, { label: d.name.en }]} />
        <h1 lang="en" class="t-display mt-2">{d.name.en}</h1>
        <p lang="en" class="mt-1 text-ink-2">District committee · HQ {d.hq.en} · {plural(allDistrictPosts.length, 'post')} · {plural(events.length, 'upcoming event')}</p>
      </div>
      <KeralaMap lang={lang} active={slug} label={`${d.name.en} on the map of Kerala`} class="hidden max-h-44 md:block" />
    </div>
  </div>

  <div class="wrap mt-6">
    <Tabs tabs={['News', 'Office-bearers', 'Offices', 'Gallery']} hashes={['news', 'office-bearers', 'offices', 'gallery']} idPrefix="district" label="District sections" />

    <div class="mt-6 grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div class="min-w-0">
        <section role="tabpanel" id="district-panel-0" aria-labelledby="district-tab-0">
          {posts.length ? (
            <>
              <ul class="divide-y divide-line">
                {posts.map((p) => <li class="py-4 first:pt-0"><StoryItem post={p} lang={lang} headingLevel="h2" /></li>)}
              </ul>
              <a href={L(`/news?district=${slug}`)} lang="en" class="link mt-2 inline-block">{allDistrictPosts.length > posts.length ? `All ${allDistrictPosts.length} ${d.name.en} posts in News` : `${d.name.en} in News`}</a>
            </>
          ) : (
            <EmptyState icon="Newspaper" title="No district news yet" text="The district committee posts its news here. Older posts arrive with the import from the current site." />
          )}
        </section>

        <section role="tabpanel" id="district-panel-1" aria-labelledby="district-tab-1" hidden lang="en">
          <ul class="grid gap-3 sm:grid-cols-3">
            {bearerRoles.map((r) => (
              <li class="card flex items-center gap-3 p-3">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-bg-subtle text-ink-3"><Icon name="UserRound" size={20} /></span>
                <div><p class="t-label">{r}</p><p class="text-sm text-ink-3">To be confirmed</p></div>
              </li>
            ))}
          </ul>
          <p class="t-meta mt-3">The district committee confirms its office-bearers, with phone numbers, before launch.</p>
        </section>

        <section role="tabpanel" id="district-panel-2" aria-labelledby="district-tab-2" hidden lang="en">
          <article class="card flex gap-3 p-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent-ink"><Icon name="Building2" size={20} /></span>
            <div>
              <h2 class="font-semibold">District office, {d.hq.en}</h2>
              <p class="text-sm text-ink-3">Address, phone, email and opening hours to be confirmed by the district committee.</p>
            </div>
          </article>
          <p class="t-meta mt-3">Area and unit offices will be listed here too. Until then, see <a href={L('/contact')} class="text-link underline underline-offset-2">Contact</a> for the state office.</p>
        </section>

        <section role="tabpanel" id="district-panel-3" aria-labelledby="district-tab-3" hidden>
          <EmptyState icon="Images" title="No photos yet" text="Albums from the district arrive with the import, and district admins add new ones from their phones." />
        </section>
      </div>

      <aside lang="en" aria-labelledby="district-events">
        <h2 id="district-events" class="t-h2 mb-3">Events in {d.name.en.replace('Thiruvananthapuram', 'TVM')}</h2>
        {events.length ? (
          <ul class="space-y-2">{events.map((e) => <li><EventCard event={e} lang={lang} /></li>)}</ul>
        ) : (
          <EmptyState compact title="Nothing scheduled">
            <a href={L('/events')} class="link mt-1 inline-block">State calendar</a>
          </EmptyState>
        )}
      </aside>
    </div>

    <nav lang="en" aria-label="Other districts" class="mt-12 grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-t border-line pt-4 text-sm">
      {prev ? <a href={districtUrl(prev.slug, lang)} class="flex items-center gap-1 font-semibold hover:text-accent-ink"><Icon name="ChevronLeft" size={16} /> {prev.name.en.replace('Thiruvananthapuram', 'TVM')}</a> : <span />}
      <a href={L('/districts')} class="link">All districts</a>
      {next ? <a href={districtUrl(next.slug, lang)} class="flex items-center justify-end gap-1 text-right font-semibold hover:text-accent-ink">{next.name.en.replace('Thiruvananthapuram', 'TVM')} <Icon name="ChevronRight" size={16} /></a> : <span />}
    </nav>
  </div>
</AppLayout>
