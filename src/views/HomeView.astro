---
/**
 * Home page (redesign, Phase C). Layout as finalized in the wireframe:
 * red wave + campaign banner → notice → Top news + Coming up → From the union → Articles → Latest orders + Tools & guides →
 * Districts → Kerala Service + Videos. No story appears twice on the page, and columns
 * side by side end on the same line.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import MagazineCover from '~/components/ui/MagazineCover.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import Notice from '~/components/ds/Notice.astro';
import HeroBand from '~/components/ds/HeroBand.astro';
import CampaignBanner from '~/components/ds/CampaignBanner.astro';
import StoryLead from '~/components/ds/StoryLead.astro';
import StoryRow from '~/components/ds/StoryRow.astro';
import StoryCard from '~/components/ds/StoryCard.astro';
import EventSlider from '~/components/ds/EventSlider.astro';
import EventCard from '~/components/ds/EventCard.astro';
import OrderRow from '~/components/ds/OrderRow.astro';
import ToolTile from '~/components/ds/ToolTile.astro';
import DistrictTile from '~/components/ds/DistrictTile.astro';
import FilterMenu from '~/components/ds/FilterMenu.astro';
import EmptyState from '~/components/ds/EmptyState.astro';
import VideoCard from '~/components/ds/VideoCard.astro';
import type { Lang, Post } from '~/lib/types';
import { href, monthName } from '~/lib/i18n';
import { allPosts, latestOrders, upcomingEvents, sortedDistricts, postsForDistrict, allIssues, issuePath, activeNotice, activeBanner, postPath } from '~/lib/content';
import { videos, site } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => href(lang, p);
const notice = activeNotice();
const banner = activeBanner();
// The story the campaign banner links to (or a post with the banner's exact title) isn't
// repeated in the sections below it
const posts = allPosts().filter((p) => !banner || (postPath(p) !== banner.path && p.title.ml !== banner.title.ml));

// Top news: the featured story leads, the next four sit beside it (three on phones)
const lead = posts.find((p) => p.featured) ?? posts[0];
const topRest = posts.filter((p) => p !== lead).slice(0, 4);

// From the union: three columns that carry on where Top news stops, so nothing repeats.
// Each opens with a photo story when one exists, then lists three more as text.
const used = new Set<number>([lead, ...topRest].map((p) => p.id));
const take = (list: Post[], n: number) => {
  const out = list.filter((p) => !used.has(p.id)).slice(0, n);
  out.forEach((p) => used.add(p.id));
  const i = out.findIndex((p) => p.cover.kind === 'photo');
  return i > 0 ? [out[i], ...out.filter((_, j) => j !== i)] : out;
};
// Articles: the three newest posts editors marked as articles, newest first. Claimed before the
// columns below so an article never shows twice.
const articles = posts.filter((p) => p.topic === 'articles' && !used.has(p.id)).slice(0, 3);
articles.forEach((p) => used.add(p.id));
const columns = [
  { name: 'Secretary’s page', more: '/news?topic=secretary', posts: take(posts.filter((p) => p.topic === 'secretary'), 4) },
  { name: 'FSETO', more: '/news?topic=fseto', posts: take(posts.filter((p) => p.topic === 'fseto'), 4) },
];
columns.unshift({ name: 'NGO Union News', more: '/news', posts: take(posts.filter((p) => !['secretary', 'fseto', 'articles'].includes(p.topic)), 4) });

// Orders and the tools beside them
const orders = latestOrders(5);
const popular = [
  { label: 'DA', path: '/orders?s=da' },
  { label: 'Pay Revision', path: '/orders?s=pay-revision' },
  { label: 'Pension', path: '/orders?g=pension' },
  { label: 'NPS', path: '/orders?g=nps' },
  { label: 'Leave', path: '/orders?s=leave' },
  { label: 'Bonus', path: '/orders?s=bonus' },
];
// Tools without a path aren't built yet and show "Coming soon"
const tools = [
  { name: 'DA arrears', kind: 'Calculator', icon: 'Calculator' },
  { name: 'Pay fixation', kind: 'Calculator', icon: 'Calculator' },
  { name: 'Leave surrender', kind: 'Calculator', icon: 'Calculator' },
  { name: 'Pension & DCRG', kind: 'Calculator', icon: 'Calculator' },
  { name: 'MEDISEP claim', kind: 'Guide', icon: 'BookOpen' },
  { name: 'Apply for HBA', kind: 'Guide', icon: 'BookOpen' },
  { name: 'GPF withdrawal', kind: 'Guide', icon: 'BookOpen' },
  { name: 'Orders & PDFs', kind: 'Downloads', icon: 'FileDown', path: '/orders' },
  { name: 'SPARK & portals', kind: 'Links', icon: 'ExternalLink', path: '/useful-links' },
];

// Events: every upcoming event in the slider; district ones again in the Districts section
const events = upcomingEvents(50);
const districtEvents = events.filter((e) => e.district);
// District news: stories already shown higher up appear only when their district is picked.
// The page carries a few per district (enough to fill the list when one is picked), not all.
const EVENT_LIMIT = 4;
const NEWS_LIMIT = 5;
const perDistrict = new Map<string, number>();
const districtPosts = posts.filter((p) => {
  if (!p.district) return false;
  const n = perDistrict.get(p.district) ?? 0;
  perDistrict.set(p.district, n + 1);
  return n < NEWS_LIMIT + 2;
});
const districts = sortedDistricts().map((d) => ({ d, count: postsForDistrict(d.slug).length }));
const districtOptions = districts.map(({ d }) => ({ value: d.slug, label: d.name.en, short: d.name.en.replace('Thiruvananthapuram', 'TVM') }));
const firstNews = districtPosts.filter((p) => !used.has(p.id)).slice(0, NEWS_LIMIT);

const issues = allIssues();
const issue = issues[0];
const oldest = issues.at(-1)!;
---
<AppLayout lang={lang}>
  <h1 class="sr-only">Kerala NGO Union</h1>

  <!-- 0 · The red wave carrying on from the header, with the campaign banner on it (or a short band) -->
  {banner ? (
    <HeroBand><CampaignBanner banner={banner} lang={lang} /></HeroBand>
  ) : (
    <HeroBand short />
  )}

  {notice && (
    <div class="wrap mt-4 lg:mt-6">
      <Notice text={notice.text} textLang={notice.textLang} href={notice.href} />
    </div>
  )}

  <!-- 1 · Top news, with upcoming events underneath -->
  <section class="wrap mt-6 lg:mt-8" aria-labelledby="top-news">
    <SectionHead title="Top news" id="top-news" href={L('/news')} linkLabel="All news" />
    <div class="grid gap-x-8 gap-y-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <StoryLead post={lead} lang={lang} />
      <ul class="balance-list divide-y divide-line">
        {topRest.map((p, i) => (
          <li class:list={['py-3 first:pt-0 lg:last:pb-0', i === 3 && 'max-lg:hidden']}><StoryRow post={p} lang={lang} /></li>
        ))}
      </ul>
    </div>
    {events.length > 0 && (
      <EventSlider events={events} lang={lang} href={L('/events')} class="mt-8 border-t border-line pt-5" />
    )}
  </section>

  <!-- 2 · From the union: three columns, each with its own heading (no section heading above) -->
  <section class="wrap mt-10 lg:mt-12" aria-label="From the union">
    <div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
      {columns.map((c) => {
        const [first, ...rest] = c.posts;
        return (
          <div class="col">
            <SectionHead title={c.name} level="h2" size="h2" />
            {first ? (
              <>
                <StoryCard post={first} lang={lang} headingLevel="h3" />
                <ul class="mt-3 divide-y divide-line border-t border-line">
                  {rest.map((p) => <li class="py-3"><StoryRow post={p} lang={lang} thumb={false} meta="date" headingLevel="h3" /></li>)}
                </ul>
              </>
            ) : (
              <EmptyState compact title="Nothing new here yet" />
            )}
            <a href={L(c.more)} lang="en" class="link col-foot">More from {c.name}</a>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 3 · Articles: the three newest, side by side -->
  <section class="wrap section" aria-labelledby="articles">
    <SectionHead title="Articles" id="articles" href={articles.length ? L('/news?topic=articles') : undefined} linkLabel="All articles" />
    {articles.length ? (
      <ul class="grid gap-x-8 gap-y-8 md:grid-cols-3">
        {articles.map((p) => <li><StoryCard post={p} lang={lang} /></li>)}
      </ul>
    ) : (
      <EmptyState compact title="No articles yet" text="Articles appear here once editors mark a post as an article." />
    )}
  </section>

  <!-- 4 · Latest orders beside Tools & guides -->
  <section class="wrap section grid gap-x-10 gap-y-12 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    <div class="col">
      <SectionHead title="Latest orders" href={L('/orders')} linkLabel="All orders" />
      <nav aria-label="Popular subjects" lang="en" class="no-scrollbar -mx-4 mb-3 flex gap-2 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:px-0">
        {popular.map((c) => <a href={L(c.path)} class="chip">{c.label}</a>)}
      </nav>
      <ul class="balance-list divide-y divide-line">
        {orders.map((o) => <li class="py-3 lg:last:pb-0"><OrderRow order={o} lang={lang} /></li>)}
      </ul>
    </div>
    <div class="col">
      <SectionHead title="Tools & guides" />
      <ul class="grid grid-cols-3 gap-2 lg:flex-1 lg:auto-rows-fr">
        {tools.map((tl) => (
          <li><ToolTile name={tl.name} kind={tl.kind} icon={tl.icon} href={tl.path && L(tl.path)} class="lg:h-full lg:min-h-[7.5rem] lg:!aspect-auto" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 · Districts: events and news from every district (each filterable), then all 15 -->
  <section class="wrap section" aria-labelledby="districts">
    <SectionHead title="Districts" id="districts" href={L('/districts')} linkLabel="All districts" />
    <div class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
      <div class="col" data-filterable data-limit={EVENT_LIMIT}>
        <SectionHead title="District events" level="h3" size="h2">
          <FilterMenu label="Filter district events by district" options={districtOptions} />
        </SectionHead>
        <ul class="space-y-2">
          {districtEvents.map((e, i) => (
            <li data-filter-item data-value={e.district} hidden={i >= EVENT_LIMIT}><EventCard event={e} lang={lang} showDistrict /></li>
          ))}
        </ul>
        <div data-filter-empty hidden={districtEvents.length > 0}>
          <EmptyState compact title="No upcoming events" text="New events appear here as soon as they are added."><span data-filter-name class="sr-only"></span></EmptyState>
        </div>
        <a href={L('/events')} lang="en" class="link col-foot">All events</a>
      </div>

      <div class="col" data-filterable data-limit={NEWS_LIMIT}>
        <SectionHead title="District news" level="h3" size="h2">
          <FilterMenu label="Filter district news by district" options={districtOptions} />
        </SectionHead>
        <ul class="divide-y divide-line">
          {districtPosts.map((p) => (
            <li data-filter-item data-value={p.district} data-filter-only={used.has(p.id) ? '' : undefined} hidden={!firstNews.includes(p)} class="py-3 first:pt-0">
              <StoryRow post={p} lang={lang} meta="district" />
            </li>
          ))}
        </ul>
        <div data-filter-empty hidden={firstNews.length > 0}>
          <EmptyState compact title="No district news yet" text="District committees post their news here."><span data-filter-name class="sr-only"></span></EmptyState>
        </div>
        <a href={L('/news')} lang="en" class="link col-foot">All district news</a>
      </div>

      <div class="col md:col-span-2 lg:col-span-1">
        <SectionHead title="All districts" level="h3" size="h2" />
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-2">
          {districts.map(({ d, count }) => <li><DistrictTile district={d} lang={lang} count={count} /></li>)}
        </ul>
        <a href={L('/districts')} lang="en" class="link col-foot">Map of districts</a>
      </div>
    </div>
  </section>

  <!-- 6 · Kerala Service and videos -->
  <section class="wrap section grid gap-x-10 gap-y-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div class="col">
      <SectionHead title="Kerala Service" href={L('/kerala-service')} linkLabel="Archive" />
      <div class="flex flex-1 gap-5">
        <a href={L(issuePath(issue.year, issue.month))} class="block w-32 shrink-0 self-start overflow-hidden rounded-md border border-line" aria-label={`Read Kerala Service, ${monthName(issue.month, 'en')} ${issue.year}`}>
          <MagazineCover year={issue.year} month={issue.month} class="h-auto w-full" />
        </a>
        <div lang="en" class="flex min-w-0 flex-col">
          <p class="t-label">Current issue</p>
          <p class="t-h2 mt-1">{monthName(issue.month, 'en')} {issue.year}</p>
          <p class="mt-1 text-sm text-ink-2">The union's monthly magazine. Every issue since {monthName(oldest.month, 'en')} {oldest.year}, readable on any phone.</p>
          <a href={L(issuePath(issue.year, issue.month))} class="btn btn-primary btn-sm mt-auto self-start"><Icon name="BookOpen" size={16} /> Read online</a>
        </div>
      </div>
    </div>
    <div class="col">
      <SectionHead title="Videos" href={site.social.youtube} linkLabel="YouTube channel" />
      <ul class="grid gap-x-4 gap-y-6 sm:grid-cols-3">
        {videos.slice(0, 3).map((v) => <li><VideoCard video={v} lang={lang} /></li>)}
      </ul>
    </div>
  </section>
</AppLayout>
