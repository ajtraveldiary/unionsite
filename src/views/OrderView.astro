---
/**
 * A single government order (redesign, Phase C). Built like the article page: one meta line
 * (GO number, date, Important), the title in the page's language with the other language
 * under it, then share. The PDF card comes first because opening the PDF is why people are
 * here; the summary follows, and the order's details sit beside it on laptops (under it on
 * phones). Related orders close the page.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import ShareBar from '~/components/ds/ShareBar.astro';
import OrderRow from '~/components/ds/OrderRow.astro';
import type { Lang, Order } from '~/lib/types';
import { t, langOf, href, formatDate, formatKb, hasEn, ui } from '~/lib/i18n';
import { subjectBySlug, orderGroups } from '~/data/orders';
import { orderPath, relatedOrders } from '~/lib/content';

interface Props { lang: Lang; order: Order }
const { lang, order: o } = Astro.props;
const L = (p: string) => href(lang, p);
const subj = subjectBySlug[o.subject];
const group = orderGroups.find((g) => g.slug === o.group)!;
const title = t(o.title, lang);
const otherTitle = lang === 'en' ? o.title.ml : o.title.en;
const pageUrl = new URL(L(orderPath(o)), Astro.site).toString();
const pdfInfo = [o.pages && `${o.pages} ${o.pages === 1 ? 'page' : 'pages'}`, o.pdfKb && formatKb(o.pdfKb)].filter(Boolean).join(' · ');
const dateLabel = o.dateIsUpload ? 'Added' : 'Date';
const related = await relatedOrders(o);
const sameSubject = related.every((r) => r.subject === o.subject);
// "DA orders", but "Pension Orders" stays as it is
const subjOrders = /orders$/i.test(subj.name.en) ? subj.name.en : `${subj.name.en} orders`;
const details = [
  ['GO number', o.goNumber],
  [dateLabel, formatDate(o.goDate, 'en')],
  ['Department', o.department],
  ['Group', group.name.en],
  ['Subject', subj.name.en],
  ['PDF', pdfInfo],
].filter(([, v]) => v);
---
<AppLayout lang={lang} title={[o.goNumber, o.title.en].filter(Boolean).join(' · ')} description={`${o.title.en}.${o.goNumber ? ` ${o.goNumber}, dated ${formatDate(o.goDate, 'en')}.` : ''}`}>
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'Orders', path: '/orders' }, { label: subj.name.en }]} />

    <!-- One grid so the header, the PDF card and the summary share a right edge; details sit beside them -->
    <div class="mt-5 grid gap-x-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <header class="min-w-0 max-w-[800px]">
        <p lang="en" class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {o.goNumber && <span class="font-semibold tabular">{o.goNumber}</span>}
          <span class="t-meta">{o.goNumber && '· '}{o.dateIsUpload && 'Added '}<time datetime={o.goDate}>{formatDate(o.goDate, 'en')}</time></span>
          {o.important && <span class="badge badge-accent">Important</span>}
          {o.sample && <span class="badge badge-warning">Sample order</span>}
        </p>
        <h1 lang={langOf(o.title, lang)} class="t-display mt-2">{title}</h1>
        {otherTitle !== title && <p lang={lang === 'en' ? 'ml' : 'en'} class="mt-2 text-lg text-ink-3">{otherTitle}</p>}
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-y border-line py-3">
          <a href={L(`/orders?s=${o.subject}`)} lang="en" class="link">More {subjOrders}</a>
          <ShareBar url={pageUrl} title={o.goNumber ? `${o.goNumber}: ${title}` : title} />
        </div>
      </header>

      <div class="mt-6 min-w-0 max-w-[800px] lg:col-start-1">
        <!-- The PDF, opened from the current site for now; it moves to R2 (with a pdf.js viewer) in Phase 2 -->
        <section lang="en" class="card flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:p-5" aria-label="PDF">
          <div class="flex min-w-0 flex-1 items-center gap-4">
            <span class="doc" aria-hidden="true"><span>PDF</span></span>
            <div class="min-w-0">
              <p class="font-semibold">Government order (PDF)</p>
              <p class="t-meta">{pdfInfo}{!o.pdfUrl && ' · arrives with the import'}</p>
            </div>
          </div>
          {o.pdfUrl ? (
            <a href={o.pdfUrl} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="Download" size={18} /> Open PDF</a>
          ) : (
            <button type="button" class="btn btn-primary" disabled><Icon name="Download" size={18} /> Open PDF</button>
          )}
        </section>

        {o.summary && (
          <section class="mt-8" aria-labelledby="summary">
            <h2 id="summary" lang="en" class="t-label">Summary</h2>
            {lang === 'en' && !hasEn(o.summary) && <p lang="en" class="t-meta mt-1">{ui.enMissing}</p>}
            <div lang={langOf(o.summary, lang)} class="prose mt-2"><p>{t(o.summary, lang)}</p></div>
          </section>
        )}

        <p lang="en" class="t-meta mt-8 flex items-start gap-2">
          <Icon name="Info" size={16} class="mt-0.5 shrink-0" />
          <span>This is a reference copy for members. For the authoritative version, check the Government's <a href="https://document.kerala.gov.in/" target="_blank" rel="noopener" class="text-link underline underline-offset-2">Document Portal</a>.</span>
        </p>
      </div>

      <aside lang="en" class="mt-8 lg:sticky lg:top-24 lg:col-start-2 lg:row-start-2 lg:mt-6 lg:self-start" aria-labelledby="details">
        <h2 id="details" class="t-label">Details</h2>
        <dl class="mt-2 divide-y divide-line border-y border-line text-sm">
          {details.map(([k, v]) => (
            <div class="flex justify-between gap-4 py-2.5"><dt class="text-ink-3">{k}</dt><dd class="text-right font-medium tabular">{v}</dd></div>
          ))}
        </dl>
      </aside>
    </div>
  </div>

  {related.length > 0 && (
    <section class="wrap section" aria-labelledby="related">
      <SectionHead title={sameSubject ? `More on ${subj.name.en}` : 'Related orders'} id="related" href={L(sameSubject ? `/orders?s=${o.subject}` : `/orders?g=${o.group}`)} linkLabel={sameSubject ? `All ${subjOrders}` : `All ${group.name.en}`} />
      <ul class="grid gap-x-10 md:grid-cols-2">
        {related.map((r) => <li class="border-b border-line py-3"><OrderRow order={r} lang={lang} /></li>)}
      </ul>
    </section>
  )}
</AppLayout>

<style>
  /* A small page with a folded corner, as on the order rows */
  .doc {
    position: relative; flex: none; display: grid; place-items: center; width: 2.75rem; height: 3.25rem;
    border: 1.5px solid var(--line-strong); border-radius: 5px; background: var(--bg-subtle);
    clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 0 100%);
    font-size: 0.625rem; font-weight: 700; letter-spacing: 0.05em; color: var(--accent-ink);
  }
  .doc::after {
    content: ""; position: absolute; top: -1px; right: -1px; width: 12px; height: 12px;
    background: linear-gradient(225deg, transparent 50%, var(--line-strong) 50%); border-bottom-left-radius: 2px;
  }
</style>
