---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/ui/Icon.astro';
import Poster from '~/components/ui/Poster.astro';
import MagazineCover from '~/components/ui/MagazineCover.astro';
import type { Lang } from '~/lib/types';

interface Props { lang: Lang }
const { lang } = Astro.props;

const tokens = [
  ['--brand-solid', 'Union red', 'Buttons, active tabs, map'],
  ['--brand-soft', 'Red tint', 'Badges, icon tiles'],
  ['--gold-line', 'Kasavu gold', 'Borders, dividers'],
  ['--gold-soft', 'Gold tint', 'Highlights'],
  ['--ink', 'Ink', 'Text'],
  ['--ink-2', 'Ink 2', 'Secondary text'],
  ['--ink-3', 'Ink 3', 'Meta text'],
  ['--paper', 'Paper', 'Page background'],
  ['--paper-2', 'Paper 2', 'Wells, hovers'],
  ['--surface', 'Surface', 'Cards'],
  ['--line', 'Line', 'Card borders'],
  ['--success', 'Success', 'Confirmations'],
] as const;
const motifs = ['rays', 'dots', 'stripes', 'rings', 'leaf', 'flag'] as const;
---
<Base lang={lang} title="Style guide" description="The Kerala NGO Union website design system: colours, type, components and motifs." noindex>
  <PageHero lang={lang} eyebrow="Design system" title="Chuvarezhuthu × Kasavu" sub="The confidence of Kerala's hand-painted wall writing, framed by the fine gold border of a kasavu mundu. Titles in Anek Malayalam, drawn 16% taller; text in Noto Sans Malayalam. Levels differ by size and weight." crumbs={[{ label: 'Style guide' }]} />

  <div class="container-x space-y-16 py-10 lg:py-14" lang="en">
    <section aria-labelledby="c-title">
      <h2 id="c-title" class="h2 mb-5">Colour</h2>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {tokens.map(([v, name, use]) => (
          <li class="card overflow-hidden">
            <div class="h-20 border-b border-line" style={`background: var(${v})`}></div>
            <div class="p-3"><p class="font-semibold">{name}</p><p class="text-xs text-ink-3"><code>{v}</code> · {use}</p></div>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="t-title">
      <h2 id="t-title" class="h2 mb-5">Type</h2>
      <div class="card divide-y divide-line">
        <div class="grid gap-2 p-5 sm:grid-cols-[160px_1fr]"><span class="text-sm text-ink-3">Display · Anek 800</span><p lang="ml" class="display">ജനപക്ഷ സിവിൽ സർവീസ്</p></div>
        <div class="grid gap-2 p-5 sm:grid-cols-[160px_1fr]"><span class="text-sm text-ink-3">H1 · Anek 700</span><p class="h1">Government orders &amp; circulars</p></div>
        <div class="grid gap-2 p-5 sm:grid-cols-[160px_1fr]"><span class="text-sm text-ink-3">H2 · Anek 650</span><p class="h2">From the districts</p></div>
        <div class="grid gap-2 p-5 sm:grid-cols-[160px_1fr]"><span class="text-sm text-ink-3">H3 · Anek 600</span><p lang="ml" class="h3">സംസ്ഥാന കമ്മിറ്റി</p></div>
        <div class="grid gap-2 p-5 sm:grid-cols-[160px_1fr]"><span class="text-sm text-ink-3">Body · Noto 400</span><p lang="ml" class="prose-union">ജീവനക്കാരുടെ ന്യായമായ ആവശ്യങ്ങൾ ഉന്നയിച്ച് സംസ്ഥാനത്തുടനീളം പ്രതിഷേധ പ്രകടനം നടന്നു.</p></div>
        <div class="grid gap-2 p-5 sm:grid-cols-[160px_1fr]"><span class="text-sm text-ink-3">Body · Noto 400</span><p class="prose-union">Employees across the state marched to press their demands.</p></div>
      </div>
    </section>

    <section aria-labelledby="k-title">
      <h2 id="k-title" class="h2 mb-5">Controls</h2>
      <div class="card space-y-6 p-6">
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" class="btn btn-primary"><Icon name="FileText" size={18} /> Primary</button>
          <button type="button" class="btn btn-ghost">Ghost</button>
          <button type="button" class="btn btn-primary" disabled>Disabled</button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" class="chip" aria-pressed="true">Selected chip</button>
          <button type="button" class="chip" aria-pressed="false">Chip</button>
          <span class="badge badge-brand">Brand badge</span>
          <span class="badge badge-gold"><Icon name="Star" size={12} /> Important</span>
          <span class="badge badge-ink">Ink badge</span>
          <span class="go-number">G.O.(P) No.112/2026/Fin</span>
        </div>
        <div class="space-y-3">
          <div class="kasavu"></div>
          <div class="kasavu-thin"></div>
        </div>
      </div>
    </section>

    <section aria-labelledby="p-title">
      <h2 id="p-title" class="h2 mb-2">Wall posters</h2>
      <p class="mb-5 text-ink-2">Generated covers for posts without a photo, one per motif.</p>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {motifs.map((m, i) => (
          <li class="overflow-hidden rounded-xl">
            <Poster cover={{ kind: 'poster', word: { ml: ['സമരം', 'സംഘടന', 'സേവനം', 'ഐക്യം', 'പ്രകൃതി', 'വിജയം'][i] }, motif: m }} seed={i + 3} lang="ml" class="aspect-[4/3] w-full" />
            <p class="mt-1.5 text-center text-xs text-ink-3">{m}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="m-title">
      <h2 id="m-title" class="h2 mb-5">Magazine covers</h2>
      <ul class="grid grid-cols-3 gap-3 sm:grid-cols-5">
        {[1, 2, 3, 4, 5].map((m) => <li class="overflow-hidden rounded-md ring-1 ring-black/10"><MagazineCover year={2025} month={m} class="block h-auto w-full" /></li>)}
      </ul>
    </section>
  </div>
</Base>
