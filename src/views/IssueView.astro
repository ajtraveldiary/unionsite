---
/**
 * One Kerala Service issue (redesign, Phase D): cover, month, read / download and share;
 * older and newer issue at the foot, then the rest of that year. The reader and download
 * open once the issue's PDF is moved over from the current site.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import SectionHead from '~/components/ds/SectionHead.astro';
import ShareBar from '~/components/ds/ShareBar.astro';
import MagazineCover from '~/components/ui/MagazineCover.astro';
import type { Lang, MagazineIssue } from '~/lib/types';
import { href, monthName } from '~/lib/i18n';
import { issuePath } from '~/lib/content';

/** `issues` is every issue, newest first (allIssues()); the page shows the one at year/month */
interface Props { lang: Lang; issues: MagazineIssue[]; year: number; month: number }
const { lang, issues: magazineIssues, year, month } = Astro.props;
const L = (p: string) => href(lang, p);
const i = magazineIssues.findIndex((x) => x.year === year && x.month === month);
// The list runs newest first, so the older issue is the next item.
const newer = magazineIssues[i - 1];
const older = magazineIssues[i + 1];
const issue = magazineIssues[i];
const sameYear = magazineIssues.filter((x) => x.year === year);
const label = `${monthName(month, 'en')} ${year}`;
const pageUrl = new URL(L(issuePath(year, month)), Astro.site).toString();
---
<AppLayout lang={lang} title={`Kerala Service · ${label}`} description={`Kerala Service, ${label}: the Kerala NGO Union's monthly magazine.`}>
  <div class="wrap pt-5 lg:pt-8" lang="en">
    <Breadcrumbs lang={lang} items={[{ label: 'Kerala Service', path: '/kerala-service' }, { label: String(year), path: `/kerala-service#y${year}` }, { label: monthName(month, 'en') }]} />

    <div class="mt-5 grid items-start gap-6 sm:grid-cols-[200px_minmax(0,1fr)] lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-10">
      <div class="mx-auto w-48 overflow-hidden rounded-md border border-line sm:w-full">
        <MagazineCover issue={issue} class="block h-auto w-full" eager />
      </div>
      <div>
        <p class="t-label">Kerala Service</p>
        <h1 class="t-display mt-1">{label}</h1>
        {issue.pdfUrl ? (
          <>
            <div class="mt-5 flex flex-wrap gap-2">
              <a href={issue.pdfUrl} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="BookOpen" size={18} /> Read the PDF</a>
            </div>
            <p class="t-meta mt-2 max-w-md">Opens the issue's PDF from the current site. A page-by-page reader comes with Phase 3.</p>
          </>
        ) : (
          <>
            <div class="mt-5 flex flex-wrap gap-2">
              <button type="button" class="btn btn-primary" disabled><Icon name="BookOpen" size={18} /> Read the PDF</button>
            </div>
            <p class="t-meta mt-2 max-w-md">This issue isn't on the current site, so there is no PDF yet. The cover is a stand-in.</p>
          </>
        )}
        <div class="mt-5 border-t border-line pt-4">
          <ShareBar url={pageUrl} title={`Kerala Service, ${label}`} />
        </div>
      </div>
    </div>

    <nav aria-label="Other issues" class="mt-10 grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-y border-line py-3 text-sm">
      {older ? <a href={L(issuePath(older.year, older.month))} class="flex items-center gap-1 font-semibold hover:text-accent-ink"><Icon name="ChevronLeft" size={16} /> {monthName(older.month, 'en').slice(0, 3)} {older.year}</a> : <span />}
      <a href={L('/kerala-service')} class="link">All issues</a>
      {newer ? <a href={L(issuePath(newer.year, newer.month))} class="flex items-center justify-end gap-1 font-semibold hover:text-accent-ink">{monthName(newer.month, 'en').slice(0, 3)} {newer.year} <Icon name="ChevronRight" size={16} /></a> : <span />}
    </nav>

    <section class="section" aria-labelledby="year">
      <SectionHead title={`More from ${year}`} id="year" size="h2" />
      <ul class="no-scrollbar -mx-4 flex gap-3 overflow-x-auto px-4 pb-2 md:mx-0 md:px-0">
        {sameYear.map((x) => (
          <li class="w-24 shrink-0 sm:w-28">
            <a href={L(issuePath(x.year, x.month))} aria-current={x.month === month ? 'page' : undefined} class="group block">
              <span class:list={['block overflow-hidden rounded-md border transition-colors group-hover:border-accent', x.month === month ? 'border-2 border-accent' : 'border-line']}>
                <MagazineCover issue={x} class="block h-auto w-full" />
              </span>
              <span class:list={['mt-1.5 block text-center text-sm', x.month === month ? 'font-semibold text-accent-ink' : 'font-medium']}>{monthName(x.month, 'en').slice(0, 3)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</AppLayout>
