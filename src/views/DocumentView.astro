---
/**
 * One document (approved wireframe "One document"): its kind and year, the title, a short
 * description (which also tells screen-reader users what the PDF holds), Download and share, the
 * PDF in a reader on the page, and the other documents.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import ShareBar from '~/components/ds/ShareBar.astro';
import PdfReader from '~/components/ds/PdfReader.astro';
import type { Lang, UnionDocument } from '~/lib/types';
import { href, t, langOf, formatDate } from '~/lib/i18n';
import { publishedDocuments } from '~/lib/content';
import { DOC_KIND_LABELS, docMeta } from '~/lib/documents';

interface Props { lang: Lang; doc: UnionDocument }
const { lang, doc } = Astro.props;
const title = t(doc.title, lang);
const others = (await publishedDocuments()).filter((d) => d.slug !== doc.slug);
const pageUrl = new URL(href(lang, `/about/documents/${doc.slug}`), Astro.site).toString();
---
<AppLayout lang={lang} title={doc.title.en ?? doc.title.ml} description={doc.summary ?? `${DOC_KIND_LABELS[doc.kind]} of the Kerala NGO Union`}>
  <div class="wrap pt-5 lg:pt-8">
    <Breadcrumbs lang={lang} items={[{ label: 'About', path: '/about' }, { label: 'Documents', path: '/about/documents' }, { label: doc.title.en ?? DOC_KIND_LABELS[doc.kind] }]} />
    <p lang="en" class="t-label mt-4">{[DOC_KIND_LABELS[doc.kind], doc.year].filter(Boolean).join(' · ')}</p>
    <h1 lang={langOf(doc.title, lang)} class="t-display mt-1">{title}</h1>
    {doc.summary && <p lang="ml" class="mt-3 max-w-2xl text-lg text-ink-2">{doc.summary}</p>}
    <div class="mt-4 flex flex-wrap items-center gap-2 border-y border-line py-3">
      <span lang="en" class="t-meta mr-auto">{docMeta(doc)} · updated {formatDate(doc.updatedAt.slice(0, 10), 'en', 'short')}</span>
      {doc.pdfUrl && <a href={doc.pdfUrl} download lang="en" class="btn btn-primary btn-sm"><Icon name="Download" size={16} /> Download</a>}
      <ShareBar url={pageUrl} title={title} />
    </div>
  </div>

  {doc.pdfUrl && (
    <section class="wrap mt-6" aria-label="Document">
      <PdfReader src={doc.pdfUrl} bytes={doc.bytes} title={title} />
    </section>
  )}

  {others.length > 0 && (
    <section lang="en" class="wrap section" aria-labelledby="other">
      <h2 id="other" class="t-h2">Other documents</h2>
      <ul class="mt-2 divide-y divide-line border-y border-line">
        {others.map((d) => (
          <li class="flex items-center justify-between gap-3 py-3">
            <a href={href(lang, `/about/documents/${d.slug}`)} lang={langOf(d.title, lang)} class="font-medium hover:text-accent-ink">{t(d.title, lang)}</a>
            <span class="t-meta shrink-0">{[DOC_KIND_LABELS[d.kind], d.year].filter(Boolean).join(' · ')}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</AppLayout>
