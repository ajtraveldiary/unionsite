---
/** Useful links (redesign, Phase D): the Government portals employees use most, one list. */
import AppLayout from '~/layouts/AppLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Breadcrumbs from '~/components/ds/Breadcrumbs.astro';
import type { Lang } from '~/lib/types';
import { usefulLinks } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---
<AppLayout lang={lang} title="Useful links" description="Kerala Government portals State employees use every day: SPARK, eOffice, Document Portal, PSC and more.">
  <div class="wrap pt-5 lg:pt-8" lang="en">
    <Breadcrumbs lang={lang} items={[{ label: 'Useful links' }]} />
    <h1 class="t-display mt-2">Useful links</h1>
    <p class="mt-1 text-ink-2">The official portals employees use most. Each opens the Government site in a new tab.</p>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {usefulLinks.map((l) => (
        <li>
          <article class="card card-hover group relative flex h-full items-center gap-3 p-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent-soft text-sm font-bold text-accent-ink" aria-hidden="true">{l.label.slice(0, 2).toUpperCase()}</span>
            <div class="min-w-0 flex-1">
              <h2 class="font-semibold leading-snug"><a href={l.url} target="_blank" rel="noopener" class="stretched group-hover:text-accent-ink">{l.label}<span class="sr-only"> (opens in a new tab)</span></a></h2>
              <p class="t-meta truncate">{l.note} · {host(l.url)}</p>
            </div>
            <Icon name="ArrowUpRight" size={18} class="text-ink-3 group-hover:text-accent-ink" />
          </article>
        </li>
      ))}
    </ul>
    <p class="t-meta mt-8 flex items-start gap-2"><Icon name="Info" size={16} class="mt-0.5 shrink-0" /> These are Government of Kerala and public-sector sites. The union is not responsible for their content or availability.</p>
  </div>
</AppLayout>
