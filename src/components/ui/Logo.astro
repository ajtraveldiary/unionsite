---
/**
 * Torch mark — a vector redraw of the union's torch-on-red logo, used until the
 * official vector artwork is supplied (plan, open question). The flame flickers on hover.
 * The wordmark uses the title face (Anek Malayalam, 16% taller; sizes are 1.16x nominal).
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
  inverse?: boolean;
  /** Two-line Malayalam wordmark for narrow phone headers */
  stacked?: boolean;
}
const { size = 44, withWordmark = true, class: cls = '', inverse = false, stacked = false } = Astro.props;
---
<span class:list={['logo inline-flex items-center gap-3', cls]}>
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
    <rect width="64" height="64" rx="12" fill="#C8102E" />
    <g transform="rotate(-22 32 40)">
      <g class="flame">
        <path d="M31.5 29C21 24.5 20 14.5 26.5 6.5c-.5 7.5 4 9.5 6 4.5 4 4.5 10 8 6 16.5 5.5-3 7-9.5 6-13 5.5 6.5 3 15-6.5 15.5Z" fill="#FFD23F" />
        <path d="M32 28.5c-4.5-2.5-4.5-8-1.5-12 .8 4 3.8 4.6 5 2.2 3.4 4 2.6 8.4-.8 10Z" fill="#F7941D" />
      </g>
      <path d="M23 29.5h18l-5.6 26.5h-6.8Z" fill="#FFFFFF" />
      <rect x="22" y="27" width="20" height="4.5" rx="1.6" fill="#FFFFFF" />
      <path d="M24.5 39.5c3-1.8 12-1.8 15.5 0l-.8 4.2c-3.5-1.3-10.6-1.3-14 0Z" fill="#C8102E" opacity=".9" />
    </g>
    <rect x="6" y="57" width="52" height="1.6" fill="#E2B45A" />
    <rect x="6" y="60" width="52" height=".8" fill="#E2B45A" />
  </svg>
  {withWordmark && stacked && (
    <span lang="ml" class:list={['title font-extrabold', inverse ? 'text-white' : 'text-brand']} style="font-size:1.14rem;line-height:1.1">
      കേരള എൻ.ജി.ഒ<br />യൂണിയൻ
    </span>
  )}
  {withWordmark && !stacked && (
    <span class="flex flex-col leading-none">
      <span
        lang="ml"
        class:list={['title font-extrabold tracking-normal', inverse ? 'text-white' : 'text-brand']}
        style="font-size:1.23rem;line-height:1.2"
      >കേരള എൻ.ജി.ഒ യൂണിയൻ</span>
      <span class:list={['title text-[0.79rem] font-semibold uppercase tracking-[0.2em]', inverse ? 'text-white/60' : 'text-ink-2']}>Kerala NGO Union</span>
    </span>
  )}
</span>

<style>
  .flame { transform-origin: 32px 28px; transition: transform 0.4s var(--ease-spring); }
  .logo:hover .flame { animation: flicker 0.9s ease-in-out infinite alternate; }
  @keyframes flicker {
    0% { transform: scale(1) skewX(0deg); }
    40% { transform: scale(1.06, 1.1) skewX(-3deg); }
    100% { transform: scale(0.98, 1.04) skewX(2deg); }
  }
</style>
