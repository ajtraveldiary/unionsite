---
/**
 * The union's torch-on-red logo (public/brand/kngu-logo-original.jpg, supplied by the union;
 * a vector version would let it scale without a bitmap). The wordmark uses the title face
 * (Anek Malayalam, 16% taller; sizes are 1.16x nominal).
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
  inverse?: boolean;
  /** Two-line Malayalam wordmark for narrow phone headers */
  stacked?: boolean;
}
const { size = 44, withWordmark = true, class: cls = '', inverse = false, stacked = false } = Astro.props;
---
<span class:list={['logo inline-flex items-center gap-3', cls]}>
  <img src="/brand/logo-128.webp" width={size} height={size} alt="" class="shrink-0 rounded-[22%]" decoding="async" />
  {withWordmark && stacked && (
    <span lang="ml" class:list={['title font-extrabold', inverse ? 'text-white' : 'text-brand']} style="font-size:1.14rem;line-height:1.1">
      കേരള എൻ.ജി.ഒ<br />യൂണിയൻ
    </span>
  )}
  {withWordmark && !stacked && (
    <span class="flex flex-col leading-none">
      <span
        lang="ml"
        class:list={['title font-extrabold tracking-normal', inverse ? 'text-white' : 'text-brand']}
        style="font-size:1.23rem;line-height:1.2"
      >കേരള എൻ.ജി.ഒ യൂണിയൻ</span>
      <span class:list={['title text-[0.79rem] font-semibold uppercase tracking-[0.2em]', inverse ? 'text-white/60' : 'text-ink-2']}>Kerala NGO Union</span>
    </span>
  )}
</span>

