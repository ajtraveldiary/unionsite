---
/**
 * Generated "wall poster" artwork for posts without a photo. Many union notices are
 * text-only, so instead of a grey placeholder every story gets a bold poster in the
 * union's palette — the same idea as hand-painted chuvarezhuthu on Kerala walls.
 * The SVG uses `slice`, so one poster crops cleanly to 16:9, 4:5 or 1:1.
 */
import type { Lang, PosterCover } from '~/lib/types';
import { rng } from '~/lib/random';

interface Props {
  cover: PosterCover;
  seed: number;
  lang: Lang;
  class?: string;
  /** Larger text for hero use */
  hero?: boolean;
  label?: string;
}
const { cover, seed, lang, class: cls = '', hero = false, label } = Astro.props;
const rand = rng(seed * 7919);

const palettes = [
  { bg: '#C8102E', shape: '#A50D26', accent: '#FFC72C', text: '#FFFFFF', small: '#FFE3A3' },
  { bg: '#1B1A19', shape: '#2C2A27', accent: '#C8102E', text: '#F7F3EC', small: '#E2B45A' },
  { bg: '#F1E7D3', shape: '#E5D6B8', accent: '#C8102E', text: '#1B1A19', small: '#8A6414' },
  { bg: '#8E0A1F', shape: '#740818', accent: '#FFC72C', text: '#FFFFFF', small: '#FFD9A0' },
  { bg: '#E2B45A', shape: '#D4A244', accent: '#8E0A1F', text: '#1B1A19', small: '#5A3E08' },
];
const p = palettes[seed % palettes.length];
const W = 400, H = 300;
const word = lang === 'en' && cover.word.en ? cover.word.en : cover.word.ml;
const isMl = !(lang === 'en' && cover.word.en);
const len = [...word].length;
const fontSize = Math.min(hero ? 132 : 118, (isMl ? 560 : 620) / Math.max(len, 2.4));
const ox = 20 + rand() * 40;

const shapes: string[] = [];
switch (cover.motif) {
  case 'rays': {
    const cx = W * (0.15 + rand() * 0.7), cy = H * 1.05, n = 22;
    for (let i = 0; i < n; i += 2) {
      const a1 = Math.PI + (i / n) * Math.PI, a2 = Math.PI + ((i + 1) / n) * Math.PI, r = 700;
      shapes.push(`<path d="M${cx} ${cy}L${cx + r * Math.cos(a1)} ${cy + r * Math.sin(a1)}L${cx + r * Math.cos(a2)} ${cy + r * Math.sin(a2)}Z" fill="${p.shape}"/>`);
    }
    shapes.push(`<circle cx="${cx}" cy="${cy}" r="${60 + rand() * 30}" fill="${p.accent}"/>`);
    break;
  }
  case 'dots': {
    const step = 22;
    for (let x = 0; x <= W; x += step)
      for (let y = 0; y <= H; y += step) {
        const r = Math.max(0, ((x / W) * 0.6 + (1 - y / H) * 0.6) * 8 - 2);
        if (r > 0.4) shapes.push(`<circle cx="${x}" cy="${y}" r="${r.toFixed(1)}" fill="${p.shape}"/>`);
      }
    shapes.push(`<circle cx="${W * 0.78}" cy="${H * 0.3}" r="${50 + rand() * 20}" fill="${p.accent}"/>`);
    break;
  }
  case 'stripes': {
    for (let i = -6; i < 16; i += 2)
      shapes.push(`<path d="M${i * 40} 0h40l-${H * 0.6} ${H}h-40z" fill="${p.shape}" transform="translate(${H * 0.6} 0)"/>`);
    shapes.push(`<rect x="${W * 0.62}" y="${H * 0.12}" width="${W * 0.3}" height="${W * 0.3}" fill="${p.accent}" transform="rotate(12 ${W * 0.77} ${H * 0.3})"/>`);
    break;
  }
  case 'rings': {
    const cx = W * (0.68 + rand() * 0.15), cy = H * (0.28 + rand() * 0.15);
    for (let r = 260; r > 20; r -= 26) shapes.push(`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${p.shape}" stroke-width="11"/>`);
    shapes.push(`<circle cx="${cx}" cy="${cy}" r="34" fill="${p.accent}"/>`);
    break;
  }
  case 'leaf': {
    for (let i = 0; i < 7; i++) {
      const x = W * (0.45 + rand() * 0.6), y = H * rand() * 0.9, rot = rand() * 180;
      shapes.push(`<path d="M0 0C40-50 120-50 160 0C120 50 40 50 0 0Z" fill="${i % 3 === 0 ? p.accent : p.shape}" transform="translate(${x} ${y}) rotate(${rot}) scale(${0.7 + rand() * 0.8})"/>`);
    }
    break;
  }
  case 'flag': {
    const x = W * 0.58, y = H * 0.08;
    shapes.push(`<rect x="${x}" y="${y}" width="7" height="${H}" fill="${p.text}" opacity=".85"/>`);
    shapes.push(`<path d="M${x + 7} ${y + 4}c40-18 80 18 120 0s60-16 80-8v96c-20-8-40-10-80 8s-80-18-120 0z" fill="${p.accent}"/>`);
    for (let i = 0; i < 5; i++) shapes.push(`<path d="M${-40 + i * 34} ${H}L${x - 30 + i * 12} ${y + 70}" stroke="${p.shape}" stroke-width="16"/>`);
    break;
  }
}
const baseline = H - 44;
---
<svg
  class={cls}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width={W} height={H} fill={p.bg} />
  <g set:html={shapes.join('')} />
  <text
    x={ox}
    y={baseline}
    fill={p.text}
    lang={isMl ? 'ml' : 'en'}
    style={`font-family:'Anek Malayalam Variable','Noto Sans Malayalam Variable',sans-serif;font-stretch:86%;font-weight:800;font-size:${fontSize * 1.16}px;letter-spacing:${isMl ? 0 : -1}px`}
  >{word}</text>
  <g opacity=".95">
    <rect x="0" y={H - 14} width={W} height="3" fill={p.small} />
    <rect x="0" y={H - 8} width={W} height="1.5" fill={p.small} />
  </g>
  <text x="20" y="30" fill={p.small} lang="ml" style="font-family:'Noto Sans Malayalam Variable',sans-serif;font-weight:700;font-size:13px;letter-spacing:.5px">കേരള എൻ.ജി.ഒ യൂണിയൻ</text>
</svg>
