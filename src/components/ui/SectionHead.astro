---
import Icon from './Icon.astro';
interface Props { eyebrow?: string; title: string; href?: string; linkLabel?: string; class?: string; id?: string }
const { eyebrow, title, href, linkLabel = 'View all', class: cls = '', id } = Astro.props;
---
<div class:list={['mb-5 flex items-end justify-between gap-4 lg:mb-6', cls]}>
  <div lang="en">
    {eyebrow && <p class="eyebrow mb-2 flex items-center gap-2"><span class="inline-block h-[3px] w-6 bg-brand-solid" aria-hidden="true"></span>{eyebrow}</p>}
    <h2 id={id} class="h1">{title}</h2>
    <slot name="after-title" />
  </div>
  {href && (
    <a href={href} lang="en" class="group hidden shrink-0 items-center gap-1.5 rounded-full border border-line-strong px-4 py-2 text-sm font-semibold transition hover:border-ink sm:inline-flex">
      {linkLabel}<Icon name="ArrowRight" size={16} class="transition-transform group-hover:translate-x-0.5" />
    </a>
  )}
</div>
