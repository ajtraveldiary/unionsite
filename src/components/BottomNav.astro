---
import Icon from './ui/Icon.astro';
import Brand from './ui/Brand.astro';
import { href } from '~/lib/i18n';
import type { Lang } from '~/lib/types';
import { site } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';

const tabs = [
  { label: 'Home', path: '/', icon: 'House' },
  { label: 'News', path: '/news', icon: 'Newspaper' },
  { label: 'Orders', path: '/orders', icon: 'FileText', primary: true },
  { label: 'Districts', path: '/districts', icon: 'MapPinned' },
] as const;
const active = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));

const more = [
  { label: 'About', sub: 'History & committee', path: '/about/state-committee', icon: 'Landmark' },
  { label: 'Kerala Service', sub: 'Monthly magazine', path: '/kerala-service', icon: 'BookOpen' },
  { label: 'Events', sub: 'Calendar', path: '/events', icon: 'CalendarDays' },
  { label: 'Gallery', sub: 'Photos & videos', path: '/gallery', icon: 'Images' },
  { label: 'Contact', sub: 'Offices & form', path: '/contact', icon: 'Phone' },
  { label: 'Useful links', sub: 'SPARK, eOffice…', path: '/useful-links', icon: 'ExternalLink' },
] as const;
---
<nav lang="en" aria-label="Mobile" class="bottom-nav fixed inset-x-0 bottom-0 z-40 lg:hidden no-print">
  <div class="mx-auto max-w-lg px-3 pb-[max(env(safe-area-inset-bottom),10px)]">
    <ul class="grid grid-cols-5 items-end rounded-[22px] border border-line bg-surface/90 px-1 py-1.5 shadow-[0_10px_40px_-12px_rgb(0_0_0/0.35)] backdrop-blur-xl">
      {tabs.map((tab) =>
        'primary' in tab ? (
          <li class="flex justify-center">
            <a href={href(lang, tab.path)} aria-current={active(tab.path) ? 'page' : undefined} class="group -mt-7 flex flex-col items-center gap-1">
              <span class:list={['grid size-14 place-items-center rounded-full bg-brand-solid text-white shadow-lg shadow-red/40 ring-4 ring-paper transition-transform group-active:scale-90', active(tab.path) && 'ring-gold-line']}>
                <Icon name={tab.icon} size={24} stroke={2} />
              </span>
              <span class:list={['text-[0.7rem] font-semibold', active(tab.path) ? 'text-brand' : 'text-ink-2']}>{tab.label}</span>
            </a>
          </li>
        ) : (
          <li>
            <a href={href(lang, tab.path)} aria-current={active(tab.path) ? 'page' : undefined} class="relative flex flex-col items-center gap-0.5 rounded-2xl py-1.5 active:scale-95 transition-transform">
              {active(tab.path) && <span class="absolute inset-x-2 inset-y-0 -z-0 rounded-2xl bg-brand-soft" style="view-transition-name: tab-pill" />}
              <span class:list={['relative', active(tab.path) ? 'text-brand' : 'text-ink-2']}><Icon name={tab.icon} size={22} stroke={active(tab.path) ? 2.2 : 1.75} /></span>
              <span class:list={['relative text-[0.7rem]', active(tab.path) ? 'font-bold text-brand' : 'font-medium text-ink-2']}>{tab.label}</span>
            </a>
          </li>
        )
      )}
      <li>
        <button type="button" data-open-more class="flex w-full flex-col items-center gap-0.5 rounded-2xl py-1.5 text-ink-2 active:scale-95 transition-transform" aria-haspopup="dialog">
          <Icon name="LayoutGrid" size={22} />
          <span class="text-[0.7rem] font-medium">More</span>
        </button>
      </li>
    </ul>
  </div>
</nav>

<dialog id="more-sheet" lang="en" class="sheet lg:hidden" aria-label="More sections">
  <div class="mx-auto mb-2 mt-2.5 h-1.5 w-10 rounded-full bg-line-strong" aria-hidden="true"></div>
  <div class="px-4 pb-[max(env(safe-area-inset-bottom),16px)]">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="title text-[1.3rem] font-bold">More</h2>
      <button type="button" data-close-sheet class="grid size-10 place-items-center rounded-full bg-paper-2" aria-label="Close"><Icon name="X" size={18} /></button>
    </div>
    <ul class="grid grid-cols-2 gap-2">
      {more.map((m) => (
        <li>
          <a href={href(lang, m.path)} class="flex items-center gap-3 rounded-2xl border border-line bg-surface p-3 active:scale-[0.98] transition-transform">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand"><Icon name={m.icon} size={20} /></span>
            <span class="min-w-0">
              <span class="block text-[0.9rem] font-semibold leading-tight">{m.label}</span>
              <span class="block truncate text-xs text-ink-3">{m.sub}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-3 flex items-center gap-2">
      <button type="button" data-theme-toggle class="flex flex-1 items-center justify-center gap-2 rounded-2xl border border-line bg-surface py-3 text-sm font-semibold">
        <Icon name="Moon" size={18} class="theme-moon" /><Icon name="Sun" size={18} class="theme-sun" /> Theme
      </button>
      <a href={site.social.facebook} target="_blank" rel="noopener" class="grid size-12 place-items-center rounded-2xl border border-line bg-surface" aria-label="Facebook"><Brand name="facebook" size={19} /></a>
      <a href={site.social.youtube} target="_blank" rel="noopener" class="grid size-12 place-items-center rounded-2xl border border-line bg-surface" aria-label="YouTube"><Brand name="youtube" size={19} /></a>
    </div>
  </div>
</dialog>

<style>
  .sheet {
    margin: auto 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 85dvh;
    border: 0;
    padding: 0;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 -20px 60px -20px rgb(0 0 0 / 0.4);
    transition: translate 0.32s var(--ease-out-soft), display 0.32s allow-discrete, overlay 0.32s allow-discrete;
    translate: 0 100%;
  }
  .sheet[open] { translate: 0 0; }
  @starting-style { .sheet[open] { translate: 0 100%; } }
  .sheet::backdrop { background: rgb(10 8 6 / 0); transition: background 0.3s, display 0.3s allow-discrete, overlay 0.3s allow-discrete; }
  .sheet[open]::backdrop { background: rgb(10 8 6 / 0.45); backdrop-filter: blur(2px); }
  @starting-style { .sheet[open]::backdrop { background: rgb(10 8 6 / 0); } }
  :global([data-theme='dark']) .theme-moon, :global(:root:not([data-theme='dark'])) .theme-sun { display: none; }
</style>
