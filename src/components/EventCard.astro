---
import Icon from './ui/Icon.astro';
import type { Lang, UnionEvent } from '~/lib/types';
import { t, langOf, dateParts, formatTime, href } from '~/lib/i18n';
import { districtBySlug } from '~/data/districts';

interface Props { event: UnionEvent; lang: Lang }
const { event: e, lang } = Astro.props;
const s = dateParts(e.start);
const end = e.end ? dateParts(e.end) : undefined;
const district = e.district ? districtBySlug[e.district] : undefined;
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
---
<li id={e.slug} class="group relative flex gap-4 rounded-xl p-2 transition-colors hover:bg-paper-2">
  <div lang="en" class="leaf relative w-[70px] shrink-0 overflow-hidden rounded-lg border border-line bg-surface text-center transition-transform duration-300 group-hover:-rotate-3">
    <div class="bg-brand-solid py-0.5 text-[0.68rem] font-bold uppercase tracking-[0.18em] text-white">{s.monthShort}</div>
    <div class="text-[2rem] font-extrabold leading-[1.15] tabular">
      {s.d}{end && end.d !== s.d && <span class="text-base text-ink-3">–{end.d}</span>}
    </div>
    <div class="pb-1 text-[0.68rem] font-semibold text-ink-3">{WEEKDAYS[s.wd]}</div>
  </div>
  <div class="min-w-0 flex-1 py-0.5">
    <h3 lang={langOf(e.title, lang)} class="title text-[1.22rem] font-bold leading-snug">
      <a href={href(lang, `/events#${e.slug}`)} class="stretched group-hover:text-brand">{t(e.title, lang)}</a>
    </h3>
    <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-2"><Icon name="MapPin" size={14} class="text-brand" /><span lang={langOf(e.venue, lang)}>{t(e.venue, lang)}</span></p>
    <p lang="en" class="mt-1 flex items-center gap-2 text-xs text-ink-3">
      <Icon name="Clock" size={13} />{formatTime(e.start)}
      {district && <span class="badge badge-ink !h-5">{district.name.en}</span>}
      {e.sample && <span class="badge badge-ink !h-5">Sample</span>}
    </p>
  </div>
</li>

<style>
  .leaf { box-shadow: 0 2px 0 var(--line), 0 4px 0 -1px var(--line-strong); }
</style>
