---
import Icon from './ui/Icon.astro';
import { site } from '~/data/site';
const a = site.announcement;
---
{a?.text && (
  <div class="announcement relative z-50 bg-ink text-paper no-print" lang="en" data-ann={a.id}>
    <div class="container-x flex min-h-10 items-center gap-3 py-1.5 text-[0.82rem]">
      <span class="relative flex size-2 shrink-0"><span class="absolute inset-0 rounded-full bg-saffron" style="animation: pulse-dot 2s ease-out infinite"></span><span class="relative size-2 rounded-full bg-saffron"></span></span>
      <p class="flex-1 leading-snug">{a.text}</p>
      <button type="button" data-dismiss-ann class="-mr-2 grid size-9 shrink-0 place-items-center rounded-full opacity-70 hover:bg-white/10 hover:opacity-100" aria-label="Dismiss announcement"><Icon name="X" size={16} /></button>
    </div>
  </div>
)}
<style>
  :global(.ann-hidden) .announcement { display: none; }
</style>
