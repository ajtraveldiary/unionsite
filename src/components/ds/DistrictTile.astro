---
/** A district in the all-districts grid: name and how many posts it has. */
import type { District, Lang } from '~/lib/types';
import { districtUrl } from '~/lib/content';

interface Props { district: District; lang: Lang; count: number }
const { district: d, lang, count } = Astro.props;
---
<article lang="en" class="card card-hover group relative px-3 py-2">
  <h3 class="text-sm font-semibold leading-snug"><a href={districtUrl(d.slug, lang)} class="stretched group-hover:text-accent-ink">{d.name.en.replace('Thiruvananthapuram', 'TVM')}</a></h3>
  <p class="t-meta">{count ? `${count} post${count === 1 ? '' : 's'}` : 'No posts yet'}</p>
</article>
