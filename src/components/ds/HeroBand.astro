---
/**
 * The home page's wave: the header's light grey carried down the page and curving off into white,
 * with whatever sits on it (the campaign banner) in the page column. Drawn as one SVG path, no
 * image and no motion. `short`: just the band under the header, for when there's no banner.
 */
interface Props { short?: boolean; class?: string }
const { short = false, class: cls = '' } = Astro.props;
---
<div class:list={['relative isolate', cls]}>
  <svg viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true"
    class:list={['absolute inset-x-0 top-0 -z-10 w-full', short ? 'h-10 lg:h-14' : 'h-[150px] sm:h-[190px] lg:h-[230px]']}>
    <path d="M0 0H1440V150C1250 205 1010 232 720 246C430 260 210 290 0 320Z" class="fill-bg-subtle" />
  </svg>
  {!short && <div class="wrap pt-3 lg:pt-4"><slot /></div>}
</div>
