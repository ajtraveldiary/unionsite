---
/**
 * Upcoming events in one row: three in view on laptops, two on tablets, swipe on phones.
 * The arrow buttons appear only when there are more events than fit.
 */
import EventCard from './EventCard.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Lang, UnionEvent } from '~/lib/types';

interface Props {
  events: UnionEvent[];
  lang: Lang;
  title?: string;
  href?: string;
  linkLabel?: string;
  showDistrict?: boolean;
  class?: string;
}
const { events, lang, title = 'Coming up', href, linkLabel = 'Calendar', showDistrict = true, class: cls = '' } = Astro.props;
---
<div data-slider class={cls}>
  <div lang="en" class="mb-3 flex items-center justify-between gap-4">
    <h3 class="t-label">{title}</h3>
    <div class="flex items-center gap-1.5">
      <button type="button" data-slider-prev class="btn btn-secondary btn-sm btn-icon hidden" aria-label="Previous events"><Icon name="ChevronLeft" size={18} /></button>
      <button type="button" data-slider-next class="btn btn-secondary btn-sm btn-icon hidden" aria-label="Next events"><Icon name="ChevronRight" size={18} /></button>
      {href && <a href={href} class="link ml-2">{linkLabel}</a>}
    </div>
  </div>
  <ul data-slider-track class="no-scrollbar -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto scroll-smooth px-4 md:mx-0 md:scroll-px-0 md:px-0">
    {events.map((e) => (
      <li class="flex w-[85%] shrink-0 snap-start sm:w-[calc((100%-0.75rem)/2)] lg:w-[calc((100%-1.5rem)/3)]">
        <EventCard event={e} lang={lang} showDistrict={showDistrict} class="w-full" />
      </li>
    ))}
  </ul>
</div>

<script>
  function initSliders() {
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach((box) => {
      if (box.dataset.sliderReady) return;
      box.dataset.sliderReady = '1';
      const track = box.querySelector<HTMLElement>('[data-slider-track]')!;
      const prev = box.querySelector<HTMLButtonElement>('[data-slider-prev]')!;
      const next = box.querySelector<HTMLButtonElement>('[data-slider-next]')!;
      const sync = () => {
        const more = track.scrollWidth > track.clientWidth + 2;
        prev.classList.toggle('hidden', !more);
        next.classList.toggle('hidden', !more);
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }));
      track.addEventListener('scroll', sync, { passive: true });
      new ResizeObserver(sync).observe(track);
    });
  }
  initSliders();
  document.addEventListener('astro:page-load', initSliders);
</script>
