---
/**
 * A government order in a list: a document icon carrying the order number (type, number,
 * year), then the title and one meta line (date · department · subject · Important).
 * Orders without a known GO number get "PDF" and the year in the icon instead.
 */
import type { Lang, Order } from '~/lib/types';
import { t, langOf, formatDate } from '~/lib/i18n';
import { orderUrl, subjectName } from '~/lib/content';

interface Props { order: Order; lang: Lang }
const { order: o, lang } = Astro.props;
// "G.O.(P) No.112/2026/Fin" -> type "G.O.(P)", number "112", year "2026", department "Fin"
const m = o.goNumber.match(/^(.*?)\s*No\.\s*(\d+)\/(\d+)\/?(.*)$/);
const g = m ? { type: m[1], n: m[2], year: m[3], dept: m[4] } : { type: 'Order', n: 'PDF', year: o.goDate.slice(0, 4), dept: '' };
---
<article class="group relative flex items-center gap-4">
  <div lang="en" class="doc" aria-hidden="true">
    <span class="text-[0.5625rem] font-semibold uppercase tracking-wide text-ink-3">{g.type}</span>
    <span class="text-[1.25rem] font-bold leading-none tabular">{g.n}</span>
    <span class="text-[0.6875rem] font-medium tabular text-ink-2">{g.year}</span>
  </div>
  <div class="min-w-0 flex-1">
    <h3 lang={langOf(o.title, lang)} class="clamp-2 font-semibold leading-snug">
      <a href={orderUrl(o, lang)} class="stretched group-hover:text-accent-ink">{o.goNumber && <span class="sr-only" lang="en">{o.goNumber}: </span>}{t(o.title, lang)}</a>
    </h3>
    <p lang="en" class="t-meta mt-0.5">
      {o.dateIsUpload && 'Added '}{formatDate(o.goDate, 'en', 'short')}{g.dept && ` · ${g.dept}`} · {subjectName(o.subject)?.en}
      {o.important && <span class="badge badge-accent ml-1 !h-5 align-[1px]">Important</span>}
    </p>
  </div>
</article>

<style>
  /* A page with a folded top-right corner */
  .doc {
    position: relative; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem;
    width: 4rem; height: 4.75rem; border: 1.5px solid var(--line-strong); border-radius: 6px; background: var(--bg-subtle); color: var(--ink);
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
    transition: border-color 0.15s;
  }
  .doc::after {
    content: ""; position: absolute; top: -1px; right: -1px; width: 15px; height: 15px;
    background: linear-gradient(225deg, transparent 50%, var(--line-strong) 50%); border-bottom-left-radius: 3px;
  }
  .group:hover .doc { border-color: var(--accent); }
</style>
