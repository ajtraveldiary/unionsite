---
/**
 * Site header: logo, the five main sections, search (desktop), content language and theme.
 * On phones the sections live in the bottom bar and search opens from there.
 */
import Logo from './Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Lang } from '~/lib/types';
import { href, altPath } from '~/lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const nav = [
  { label: 'News', path: '/news' },
  { label: 'Orders', path: '/orders' },
  { label: 'Districts', path: '/districts' },
  { label: 'Kerala Service', path: '/kerala-service' },
  { label: 'About', path: '/about', match: '/about' },
];
const active = (p: string) => path.startsWith(p);
const alt = altPath(Astro.url.pathname);
// The search page has its own big box, so the header's is left out there
const onSearchPage = path.replace(/\/$/, '') === '/search';
---
<header lang="en" class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur supports-[backdrop-filter]:bg-bg/85">
  <div class="wrap flex h-16 items-center gap-3 lg:gap-6">
    <a href={href(lang, '/')} class="flex min-w-0 items-center lg:shrink-0" aria-label="Kerala NGO Union, home">
      <!-- Wrappers carry the breakpoints (the logo's own inline-flex would override `hidden`); flex, not
           block, so no empty line space sits under the logo and it stays centred in the bar -->
      <span class="hidden sm:flex"><Logo /></span>
      <span class="flex sm:hidden"><Logo size={36} stacked /></span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex gap-1">
        {nav.map((n) => (
          <li>
            <a href={href(lang, n.path)} aria-current={active(n.match ?? n.path) ? 'page' : undefined}
              class:list={['block whitespace-nowrap rounded-[var(--radius-control)] px-3 py-2 text-[0.9375rem] transition-colors',
                active(n.match ?? n.path) ? 'bg-bg-subtle font-semibold text-ink' : 'text-ink-2 hover:bg-bg-subtle hover:text-ink']}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    {!onSearchPage && (
      <form action={href(lang, '/search')} role="search" class="relative ml-auto hidden min-w-0 max-w-xs flex-1 md:block">
        <Icon name="Search" size={18} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" />
        <input name="q" type="search" class="field !min-h-10 !rounded-full pl-9 text-sm" placeholder="Search orders, news, districts" aria-label="Search the site" />
      </form>
    )}

    <div class:list={['ml-auto flex shrink-0 items-center gap-1.5', !onSearchPage && 'md:ml-0']}>
      <!-- Fixed-height halves with the text centred: Malayalam's taller line height would otherwise sit "മല" lower than "EN" -->
      <div class="flex rounded-full border border-line-strong p-0.5 text-sm font-semibold" role="group" aria-label="Content language">
        <a href={alt.ml} lang="ml" aria-current={lang === 'ml' ? 'true' : undefined} class:list={['inline-flex h-8 items-center rounded-full px-2.5 leading-none sm:px-3', lang === 'ml' ? 'bg-ink text-bg' : 'text-ink-2 hover:text-ink']}>മല</a>
        <a href={alt.en} aria-current={lang === 'en' ? 'true' : undefined} class:list={['inline-flex h-8 items-center rounded-full px-2.5 leading-none sm:px-3', lang === 'en' ? 'bg-ink text-bg' : 'text-ink-2 hover:text-ink']}>EN</a>
      </div>
      <button type="button" data-theme-toggle class="btn btn-ghost btn-sm btn-icon" aria-label="Switch light or dark theme">
        <Icon name="Moon" size={18} class="dark:hidden" />
        <Icon name="Sun" size={18} class="hidden dark:block" />
      </button>
    </div>
  </div>
</header>
