---
/** Home-page notice strip, shown only while the office has an active notice. */
import Icon from '~/components/ui/Icon.astro';

interface Props { text: string; textLang?: 'ml' | 'en'; href?: string }
const { text, textLang = 'en', href } = Astro.props;
---
<aside class="flex items-start gap-3 rounded-[var(--radius-card)] border border-warning/30 bg-warning-soft px-4 py-3" aria-label="Notice">
  <Icon name="Bell" size={18} class="mt-0.5 text-warning" />
  <p class="min-w-0 flex-1 text-sm">
    <span lang="en" class="t-label !text-warning mr-2">Notice</span>
    <span lang={textLang}>{text}</span>
    {href && <a href={href} lang="en" class="link ml-1">Read more</a>}
  </p>
</aside>
