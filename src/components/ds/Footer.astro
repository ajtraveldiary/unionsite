---
/** One footer that maps the whole site, then Govt portals and legal links. */
import Logo from './Logo.astro';
import type { Lang } from '~/lib/types';
import { href } from '~/lib/i18n';
import { site, usefulLinks } from '~/data/site';
import { defaultSiteDetails, siteDetails } from '~/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
// Pages built ahead of time can't read the database; they keep the defaults until rebuilt
const details = Astro.isPrerendered ? defaultSiteDetails() : await siteDetails();
const cols = [
  { head: 'News', links: [['Latest news', '/news'], ['Events', '/events'], ['Secretary’s page', '/news?topic=secretary'], ['FSETO', '/news?topic=fseto']] },
  { head: 'Orders', links: [['Search orders', '/orders'], ['Govt orders', '/orders?g=govt'], ['NPS', '/orders?g=nps'], ['Pension', '/orders?g=pension']] },
  { head: 'Districts', links: [['All districts', '/districts'], ['District news', '/news']] },
  { head: 'Kerala Service', links: [['Current issue', '/kerala-service'], ['Archive', '/kerala-service']] },
  { head: 'About', links: [['State committee', '/about/state-committee'], ['Media', '/gallery'], ['Contact', '/contact']] },
];
---
<footer lang="en" class="mt-16 border-t border-line bg-bg-subtle">
  <div class="wrap pb-28 pt-10 lg:pb-10">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-[minmax(0,2fr)_repeat(5,minmax(0,1fr))]">
      <div class="col-span-2 sm:col-span-3 lg:col-span-5 xl:col-span-1">
        <Logo size={36} />
        <p class="mt-3 text-sm text-ink-2">The organisation of Kerala State Government employees, since {site.founded}.</p>
      </div>
      {cols.map((c) => (
        <div>
          <h2 class="t-label">{c.head}</h2>
          <ul class="mt-2 space-y-1.5 text-sm">
            {c.links.map(([label, p]) => <li><a href={href(lang, p)} class="text-ink-2 hover:text-ink hover:underline underline-offset-2">{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-8 border-t border-line pt-4">
      <p class="t-label">Govt portals</p>
      <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {usefulLinks.slice(0, 8).map((l) => <li><a href={l.url} target="_blank" rel="noopener" class="text-ink-2 hover:text-ink hover:underline underline-offset-2">{l.label}</a></li>)}
      </ul>
    </div>
    <div class="mt-6 flex flex-col gap-2 border-t border-line pt-4 text-sm text-ink-3 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} Kerala NGO Union</p>
      <p class="flex gap-4">
        <a href={details.facebook} target="_blank" rel="noopener" class="hover:text-ink">Facebook</a>
        <a href={details.youtube} target="_blank" rel="noopener" class="hover:text-ink">YouTube</a>
        <a href={href(lang, '/privacy')} class="hover:text-ink">Privacy</a>
        <a href={href(lang, '/accessibility')} class="hover:text-ink">Accessibility</a>
      </p>
    </div>
  </div>
</footer>
