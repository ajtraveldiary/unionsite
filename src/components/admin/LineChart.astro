---
/**
 * The Analytics screen's daily chart: one series at a time (Visitors or Pages read, switched by
 * two chips, so there is never a second scale), drawn as a 2 px line in the link token's colour
 * over recessive gridlines, with a crosshair and tooltip on hover or tap, and the same numbers as a
 * table underneath for screen readers and anyone who prefers one. Plain SVG; no chart library.
 */
interface Point { date: string; visitors: number; pageviews: number }
interface Props { points: Point[]; label: (date: string) => string }
const { points, label } = Astro.props;
const W = 720, H = 220, L = 44, R = 12, T = 12, B = 28;
const data = JSON.stringify(points.map((p) => ({ ...p, label: label(p.date) })));
---
<figure class="mt-3" data-line-chart data-points={data} data-w={W} data-h={H} data-l={L} data-r={R} data-t={T} data-b={B}>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Measure">
    <button type="button" class="chip" aria-pressed="true" data-measure="visitors">Visitors</button>
    <button type="button" class="chip" aria-pressed="false" data-measure="pageviews">Pages read</button>
  </div>
  <div class="relative mt-2">
    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full touch-none select-none" role="img" aria-label="Daily chart" data-svg></svg>
    <div class="pointer-events-none absolute hidden rounded-[var(--radius-control)] border border-line bg-surface px-2.5 py-1.5 text-xs shadow-float" data-tip></div>
  </div>
  <details class="mt-2 text-sm">
    <summary class="cursor-pointer text-ink-2">Show as a table</summary>
    <table class="mt-2 w-full max-w-md text-left">
      <thead><tr class="text-xs uppercase tracking-wide text-ink-3"><th class="py-1 font-semibold">Day</th><th class="py-1 text-right font-semibold">Visitors</th><th class="py-1 text-right font-semibold">Pages read</th></tr></thead>
      <tbody>{points.map((p) => <tr class="border-t border-line"><td class="py-1">{label(p.date)}</td><td class="py-1 text-right tabular">{p.visitors.toLocaleString('en-IN')}</td><td class="py-1 text-right tabular">{p.pageviews.toLocaleString('en-IN')}</td></tr>)}</tbody>
    </table>
  </details>
</figure>

<script>
  interface P { date: string; label: string; visitors: number; pageviews: number }
  function initLineCharts() {
    document.querySelectorAll<HTMLElement>('[data-line-chart]').forEach((fig) => {
      if (fig.dataset.ready) return;
      fig.dataset.ready = '1';
      const pts = JSON.parse(fig.dataset.points!) as P[];
      const [, H, L, R, T, B] = ['w', 'h', 'l', 'r', 't', 'b'].map((k) => Number(fig.dataset[k]));
      // Drawn at the chart's real width, so labels stay 11 px on a phone too
      let W = Number(fig.dataset.w);
      const svg = fig.querySelector<SVGSVGElement>('[data-svg]')!;
      const tip = fig.querySelector<HTMLElement>('[data-tip]')!;
      let measure: 'visitors' | 'pageviews' = 'visitors';
      const NS = 'http://www.w3.org/2000/svg';
      const el = (name: string, attrs: Record<string, string | number>) => { const n = document.createElementNS(NS, name); for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v)); return n; };
      const x = (i: number) => L + (pts.length < 2 ? (W - L - R) / 2 : (i * (W - L - R)) / (pts.length - 1));
      let max = 1, y = (v: number) => v;
      function draw() {
        W = Math.max(280, Math.round(svg.getBoundingClientRect().width) || W);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        svg.replaceChildren();
        const values = pts.map((p) => p[measure]);
        // A rounded top: 1, 2, 5 × a power of ten
        const top = Math.max(...values, 1);
        const step = 10 ** Math.floor(Math.log10(top));
        max = [1, 2, 5, 10].map((m) => m * step).find((m) => m >= top) ?? top;
        y = (v: number) => T + (H - T - B) * (1 - v / max);
        for (const f of max % 2 ? [0, 1] : [0, 0.5, 1]) {
          const v = Math.round(max * f);
          svg.append(el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: 'var(--line)', 'stroke-width': 1 }));
          const t = el('text', { x: L - 6, y: y(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--ink-3)' });
          t.textContent = v.toLocaleString('en-IN');
          svg.append(t);
        }
        const every = Math.ceil(pts.length / Math.max(2, Math.min(7, Math.floor(W / 90))));
        pts.forEach((p, i) => {
          if (i % every && i !== pts.length - 1) return;
          const t = el('text', { x: i === pts.length - 1 ? W - R : x(i), y: H - 8, 'text-anchor': i === pts.length - 1 ? 'end' : 'middle', 'font-size': 11, fill: 'var(--ink-3)' });
          t.textContent = p.label;
          svg.append(t);
        });
        svg.append(el('polyline', { points: pts.map((p, i) => `${x(i)},${y(p[measure])}`).join(' '), fill: 'none', stroke: 'var(--link)', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));
        svg.setAttribute('aria-label', `${measure === 'visitors' ? 'Visitors' : 'Pages read'} per ${pts[0]?.date.length === 7 ? 'month' : 'day'}`);
      }
      const cross = () => svg.querySelector('[data-cross]');
      function hover(clientX: number) {
        const box = svg.getBoundingClientRect();
        const sx = ((clientX - box.left) / box.width) * W;
        const i = Math.max(0, Math.min(pts.length - 1, Math.round(((sx - L) / (W - L - R)) * (pts.length - 1))));
        const p = pts[i];
        cross()?.remove();
        const g = el('g', { 'data-cross': '' });
        g.append(el('line', { x1: x(i), x2: x(i), y1: T, y2: H - B, stroke: 'var(--line-strong)', 'stroke-width': 1 }));
        g.append(el('circle', { cx: x(i), cy: y(p[measure]), r: 5, fill: 'var(--link)', stroke: 'var(--surface)', 'stroke-width': 2 }));
        svg.append(g);
        tip.innerHTML = '';
        tip.append(Object.assign(document.createElement('p'), { className: 'font-semibold', textContent: p.label }),
          Object.assign(document.createElement('p'), { textContent: `${p[measure].toLocaleString('en-IN')} ${measure === 'visitors' ? (p[measure] === 1 ? 'visitor' : 'visitors') : (p[measure] === 1 ? 'page read' : 'pages read')}` }));
        tip.classList.remove('hidden');
        const px = (x(i) / W) * box.width;
        tip.style.left = `${Math.min(Math.max(px - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth)}px`;
        tip.style.top = `${(y(p[measure]) / H) * box.height - tip.offsetHeight - 10}px`;
      }
      svg.addEventListener('pointermove', (e) => hover(e.clientX));
      svg.addEventListener('pointerdown', (e) => hover(e.clientX));
      svg.addEventListener('pointerleave', () => { cross()?.remove(); tip.classList.add('hidden'); });
      fig.querySelectorAll<HTMLButtonElement>('[data-measure]').forEach((b) => b.addEventListener('click', () => {
        measure = b.dataset.measure as typeof measure;
        fig.querySelectorAll('[data-measure]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        draw();
      }));
      draw();
      let width = W;
      new ResizeObserver(() => { const w = Math.round(svg.getBoundingClientRect().width); if (w && w !== width) { width = w; draw(); } }).observe(svg);
    });
  }
  initLineCharts();
</script>
