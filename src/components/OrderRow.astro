---
import Icon from './ui/Icon.astro';
import type { Lang, Order } from '~/lib/types';
import { t, langOf, formatDate, formatKb } from '~/lib/i18n';
import { orderUrl, subjectName } from '~/lib/content';

interface Props { order: Order; lang: Lang; compact?: boolean }
const { order: o, lang, compact = false } = Astro.props;
const subj = subjectName(o.subject);
---
<li class="group relative">
  <a href={orderUrl(o, lang)} class="flex items-start gap-3 rounded-xl px-3 py-3.5 transition-colors hover:bg-paper-2 sm:items-center sm:gap-4">
    <span class="relative grid size-11 shrink-0 place-items-center rounded-lg bg-brand-soft text-brand">
      <Icon name="FileText" size={21} />
      {o.important && <span class="absolute -right-1 -top-1 grid size-4 place-items-center rounded-full bg-gold-line ring-2 ring-surface" title="Important"><Icon name="Star" size={9} stroke={3} class="text-white" /></span>}
    </span>
    <span class="min-w-0 flex-1">
      <span lang={langOf(o.title, lang)} class="clamp-2 block font-semibold leading-snug group-hover:text-brand">{t(o.title, lang)}</span>
      <span lang="en" class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.78rem] text-ink-3">
        <span class="go-number !py-0.5 !text-[0.72rem]">{o.goNumber}</span>
        <time datetime={o.goDate} class="tabular">{formatDate(o.goDate, 'en', 'short')}</time>
        {!compact && subj && <span>{subj.en}</span>}
      </span>
    </span>
    <span lang="en" class="hidden shrink-0 items-center gap-1.5 rounded-full border border-line px-2.5 py-1 text-xs font-semibold text-ink-2 sm:flex">
      PDF · {formatKb(o.pdfKb)}
    </span>
    <Icon name="ChevronRight" size={18} class="mt-3 text-ink-3 transition-transform group-hover:translate-x-0.5 sm:mt-0" />
  </a>
</li>
