---
import Poster from './ui/Poster.astro';
import Icon from './ui/Icon.astro';
import type { Lang, Post } from '~/lib/types';
import { t, langOf, formatDate, formatViews } from '~/lib/i18n';
import { postUrl } from '~/lib/content';
import { topicBySlug, districtBySlug } from '~/data/districts';

interface Props {
  post: Post;
  lang: Lang;
  variant?: 'large' | 'compact';
  class?: string;
  headingLevel?: 'h2' | 'h3';
  /** Compact only: leave out the topic label when the surrounding list is already one topic */
  hideTopic?: boolean;
}
const { post, lang, variant = 'large', class: cls = '', headingLevel = 'h3', hideTopic = false } = Astro.props;
const H = headingLevel;
const topic = topicBySlug[post.topic];
const district = post.district ? districtBySlug[post.district] : undefined;
const titleLang = langOf(post.title, lang);
---
{variant === 'large' ? (
  <article class:list={['story group card lift relative flex flex-col overflow-hidden', cls]} data-topic={post.topic}>
    <div class="relative aspect-[16/9] overflow-hidden bg-paper-2">
      {post.cover.kind === 'poster' ? (
        <Poster cover={post.cover} seed={post.id} lang={lang} class="size-full transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
      ) : (
        <img src={post.cover.src} alt={t(post.cover.alt, lang)} loading="lazy" class="size-full object-cover" />
      )}
      {post.sample && <span lang="en" class="badge absolute right-3 top-3 bg-black/55 text-white backdrop-blur">Sample</span>}
    </div>
    <div class="flex flex-1 flex-col p-4 sm:p-5">
      <div class="mb-2.5 flex flex-wrap items-center gap-1.5">
        <span lang="en" class="badge badge-brand">{topic?.name.en}</span>
        {district && <span lang="en" class="badge badge-ink"><Icon name="MapPin" size={12} />{district.name.en}</span>}
      </div>
      <H lang={titleLang} class="h3 clamp-3">
        <a href={postUrl(post, lang)} class="stretched">{t(post.title, lang)}</a>
      </H>
      <div lang="en" class="mt-auto flex items-center gap-3 pt-4 text-[0.8rem] text-ink-3">
        <time datetime={post.date}>{formatDate(post.date, 'en', 'short')}</time>
        {post.views && post.views >= 50 && <span class="flex items-center gap-1"><Icon name="Eye" size={14} />{formatViews(post.views)}</span>}
        <span class="ml-auto grid size-8 place-items-center rounded-full border border-line text-ink-2 transition group-hover:border-brand group-hover:bg-brand-solid group-hover:text-white"><Icon name="ArrowUpRight" size={16} /></span>
      </div>
    </div>
  </article>
) : (
  <article class:list={['story group relative flex gap-3.5', cls]} data-topic={post.topic}>
    <div class="relative aspect-[4/3] w-28 shrink-0 overflow-hidden rounded-lg bg-paper-2 sm:w-36">
      {post.cover.kind === 'poster' && <Poster cover={post.cover} seed={post.id} lang={lang} class="size-full transition-transform duration-500 group-hover:scale-105" />}
    </div>
    <div class="min-w-0 flex-1">
      {!hideTopic && <span lang="en" class="text-[0.78rem] font-semibold text-brand">{topic?.name.en}</span>}
      <H lang={titleLang} class="title mt-0.5 clamp-3 text-[1.16rem] font-semibold leading-snug group-hover:text-brand">
        <a href={postUrl(post, lang)} class="stretched">{t(post.title, lang)}</a>
      </H>
      <time lang="en" datetime={post.date} class="mt-1 block text-xs text-ink-3">{formatDate(post.date, 'en', 'short')}</time>
    </div>
  </article>
)}
