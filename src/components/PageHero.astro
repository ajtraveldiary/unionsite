---
import Icon from './ui/Icon.astro';
import type { Lang } from '~/lib/types';
import { href } from '~/lib/i18n';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  titleLang?: 'ml' | 'en';
  sub?: string;
  subLang?: 'ml' | 'en';
  crumbs?: { label: string; path?: string }[];
}
const { lang, eyebrow, title, titleLang = 'en', sub, subLang = 'en', crumbs = [] } = Astro.props;
const all = [{ label: 'Home', path: '/' }, ...crumbs];
---
<section class="page-hero border-b border-line">
  <div class="container-x pb-7 pt-5 lg:pb-10 lg:pt-8">
    <nav aria-label="Breadcrumb" lang="en" class="mb-5">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-ink-3">
        {all.map((c, i) => (
          <li class="flex items-center gap-1">
            {i > 0 && <Icon name="ChevronRight" size={14} />}
            {c.path && i < all.length - 1 ? <a href={href(lang, c.path)} class="hover:text-ink hover:underline">{c.label}</a> : <span aria-current="page" class="text-ink-2">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    {eyebrow && <p lang="en" class="eyebrow mb-3 flex items-center gap-2"><span class="inline-block h-[3px] w-6 bg-brand-solid"></span>{eyebrow}</p>}
    <h1 lang={titleLang} class="display max-w-[24ch]">{title}</h1>
    {sub && <p lang={subLang} class="mt-3 max-w-2xl text-lg text-ink-2">{sub}</p>}
    <slot />
  </div>
</section>
