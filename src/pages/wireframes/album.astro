---
/**
 * Wireframe: photo album (plan, section 8: "masonry photo grid · lightbox with captions and swipe ·
 * download if allowed"). Albums are made in the admin's Media screen and show on Media, the district
 * hub's Gallery tab and linked events. Title, district and counts are examples.
 */
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import Ph from '~/components/wire/Ph.astro';

// Mixed shapes, as real photos come
const ratios = ['4/3', '3/4', '4/3', '1/1', '3/2', '3/4', '4/3', '3/2', '1/1', '4/3', '3/4', '3/2'];
---
<WireLayout title="Photo album" page="album">
  <div class="wf-wrap pt-6">
    <nav lang="en" class="t-meta" aria-label="Breadcrumb"><a href="/wireframes">Home</a> / <a href="#">Media</a> / Album</nav>
    <h1 lang="ml" class="t-display mt-2">ആൽബത്തിന്റെ പേര് (album title)</h1>
    <p lang="en" class="t-meta mt-2">Kollam · date · 24 photos · <a href="/wireframes/event" class="underline">the event</a></p>
    <div lang="en" class="mt-4 flex flex-wrap gap-2"><span class="wf-btn wf-btn-line !min-h-9 text-sm">WhatsApp</span><span class="wf-btn wf-btn-line !min-h-9 text-sm">Copy link</span></div>
  </div>

  <section class="wf-wrap mt-6" aria-label="Photos">
    <ul class="columns-2 gap-2 sm:columns-3 lg:columns-4">
      {ratios.map((r) => <li class="mb-2 break-inside-avoid"><Ph label="" ratio={r} /></li>)}
    </ul>
    <Note n={1}>Photos keep their own shape (a masonry grid: 2 columns on phones, up to 4 on laptops) and load as you scroll. Tapping one opens the lightbox below.</Note>
  </section>

  <section class="wf-wrap mt-10" aria-labelledby="lightbox">
    <h2 id="lightbox" lang="en" class="t-h2 mb-3">Lightbox</h2>
    <div class="relative overflow-hidden rounded-xl bg-zinc-900 p-3 text-zinc-100 sm:p-6">
      <div lang="en" class="flex items-center justify-between text-sm"><span>5 / 24</span><span class="flex gap-2"><span class="rounded border border-zinc-600 px-2 py-1">Download</span><span class="rounded border border-zinc-600 px-2 py-1">Close ✕</span></span></div>
      <div class="mt-3 flex items-center gap-2">
        <span class="hidden rounded-full border border-zinc-600 px-3 py-2 sm:block" aria-hidden="true">‹</span>
        <div class="grid aspect-[3/2] flex-1 place-items-center rounded-lg bg-zinc-700 text-sm text-zinc-300">Photo, as large as the screen allows</div>
        <span class="hidden rounded-full border border-zinc-600 px-3 py-2 sm:block" aria-hidden="true">›</span>
      </div>
      <p lang="ml" class="mt-3 text-sm">അടിക്കുറിപ്പ് (caption)</p>
    </div>
    <Note n={2}>Swipe or use the arrows; the arrow keys and Esc work on laptops. The caption follows the page language when an English one exists. Download shows only when the album allows it.</Note>
  </section>
</WireLayout>
