---
/**
 * Wireframe: Kerala Service reader (plan, section 8 "Issue reader" and section 11): full screen;
 * one page on phones, a two-page spread on laptops; thumbnails, zoom, page jump, contents and
 * download; a link can open a given page (#p=12). It replaces the old site's flipbook plugin and
 * is what "Read the PDF" opens on an issue page. The newest crawled issue stands in.
 */
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import { allIssues } from '~/lib/sample';
import { monthName } from '~/lib/i18n';

const issue = allIssues()[0];
const label = `${monthName(issue.month, 'en')} ${issue.year}`;
---
<WireLayout title={`Kerala Service · ${label}`} page="reader">
  <div class="wf-wrap pt-6">
    <Note n={1}>The reader covers the whole screen, above the site's header and bottom bar. It's drawn inside a frame here so it can be reviewed.</Note>
  </div>

  <section class="wf-wrap" aria-label="Reader">
    <div class="overflow-hidden rounded-xl bg-zinc-900 text-zinc-100">
      <!-- Top bar: close, title, page, contents, download -->
      <div lang="en" class="flex items-center gap-2 border-b border-zinc-700 px-3 py-2 text-sm">
        <span class="rounded border border-zinc-600 px-2 py-1">✕ Close</span>
        <span class="min-w-0 flex-1 truncate font-semibold">Kerala Service · {label}</span>
        <span class="hidden rounded border border-zinc-600 px-2 py-1 sm:inline">Contents</span>
        <span class="rounded border border-zinc-600 px-2 py-1">Download</span>
      </div>

      <!-- Pages: one on phones, a spread on laptops -->
      <div class="flex items-center justify-center gap-2 p-3 sm:p-6">
        <span class="hidden rounded-full border border-zinc-600 px-3 py-2 lg:block" aria-hidden="true">‹</span>
        <div class="grid w-full max-w-3xl gap-1 lg:grid-cols-2">
          <div class="grid aspect-[210/297] place-items-center rounded bg-zinc-200 text-sm text-zinc-500">Page 12</div>
          <div class="hidden aspect-[210/297] place-items-center rounded bg-zinc-200 text-sm text-zinc-500 lg:grid">Page 13</div>
        </div>
        <span class="hidden rounded-full border border-zinc-600 px-3 py-2 lg:block" aria-hidden="true">›</span>
      </div>

      <!-- Bottom bar: page jump and zoom, then thumbnails -->
      <div lang="en" class="flex flex-wrap items-center gap-2 border-t border-zinc-700 px-3 py-2 text-sm">
        <label class="flex items-center gap-2">Page <input class="w-14 rounded border border-zinc-600 bg-zinc-800 px-2 py-1 text-center" value="12" inputmode="numeric" aria-label="Page number" /> of N</label>
        <span class="ml-auto flex gap-1"><span class="rounded border border-zinc-600 px-2 py-1">−</span><span class="rounded border border-zinc-600 px-2 py-1">Fit</span><span class="rounded border border-zinc-600 px-2 py-1">+</span></span>
      </div>
      <ol class="no-scrollbar flex gap-2 overflow-x-auto border-t border-zinc-700 p-3" aria-label="Pages">
        {Array.from({ length: 14 }, (_, i) => (
          <li class:list={['grid aspect-[210/297] w-12 shrink-0 place-items-center rounded text-[0.625rem]', i === 11 || i === 12 ? 'bg-zinc-100 text-zinc-900 outline outline-2 outline-white' : 'bg-zinc-600 text-zinc-300']}>{i + 1}</li>
        ))}
      </ol>
    </div>
    <Note n={2}>On phones one page fills the screen: swipe for the next, pinch to zoom, and the thumbnails hide until tapped. On laptops two pages sit side by side, with arrow keys to turn. Page 1 shows first while the rest load from R2, so a 20 MB issue opens in under 3 seconds on 4G (plan, section 11).</Note>
  </section>

  <section class="wf-wrap mt-10 max-w-2xl" aria-labelledby="contents">
    <h2 id="contents" lang="en" class="t-h2">Contents</h2>
    <ol class="mt-2 divide-y divide-zinc-200 border-y border-zinc-200">
      {[3, 8, 12, 20].map((p, i) => (
        <li class="flex items-baseline gap-3 py-2.5"><span lang="en" class="t-meta w-10 tabular-nums">p. {p}</span><span lang="ml" class="min-w-0 flex-1 font-medium">ലേഖനം {i + 1} (article title · author)</span></li>
      ))}
    </ol>
    <Note n={3}>The contents panel (from the admin's Kerala Service upload) jumps to an article's page; each line has its own link such as /kerala-service/{issue.year}/{String(issue.month).padStart(2, '0')}#p=12, to share one article.</Note>
  </section>
</WireLayout>
