---
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import Ph from '~/components/wire/Ph.astro';
import { site, stateCommittee, roleLabels } from '~/data/site';

const leaders = stateCommittee.filter((p) => ['president', 'general_secretary', 'treasurer'].includes(p.role));
const sections = [
  { title: 'History', text: 'From the 1920 NGO Association to today' },
  { title: 'State committee', text: 'Office-bearers and secretariat' },
  { title: 'Conferences', text: `${site.conferences} state conferences since ${site.founded}` },
  { title: 'Struggles', text: 'Major strikes and campaigns' },
  { title: 'Documents', text: 'Bye-law, policy resolutions, jubilee documents' },
  { title: 'Media', text: 'Photo albums and videos' },
  { title: 'Contact', text: 'State Centre and district offices' },
];
const docs = ['Bye-Law', 'Policy resolution, 1965', 'Silver Jubilee conference programme', 'Golden Jubilee organisational document'];
---
<WireLayout title="About" page="about">
  <div lang="en" class="wf-wrap pt-6">
    <nav class="t-meta" aria-label="Breadcrumb"><a href="/wireframes">Home</a> / About</nav>
    <h1 class="t-display mt-2">About the union</h1>
    <p class="mt-3 max-w-2xl text-lg text-zinc-600">The Kerala NGO Union organises Kerala's State Government employees for a people-oriented civil service. It was formed in {site.founded}, with roots in the NGO Association of 1920.</p>
    <Note n={1}>About becomes a hub: a short introduction, then one card per sub-page. Pages the old site had (History, Conferences, Struggles, Documents) all live here.</Note>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {sections.map((s) => (
        <li class="wf-box relative p-4 hover:bg-zinc-50">
          <a href="#" class="stretched t-h3 block">{s.title}</a>
          <p class="mt-1 text-sm text-zinc-600">{s.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <section class="wf-wrap mt-12" aria-labelledby="leaders">
    <div class="wf-section-head"><h2 id="leaders" lang="en" class="t-h1">Leadership</h2><a href="#" lang="en" class="wf-link">Full state committee</a></div>
    <Note n={2}>The three office-bearers with photos, moved here from the home page. Names follow the page language.</Note>
    <ul class="grid gap-4 sm:grid-cols-3">
      {leaders.map((p) => (
        <li class="flex items-center gap-4">
          <Ph label="Photo" class="size-20 shrink-0 !rounded-full" />
          <div><p lang="en" class="t-label">{roleLabels[p.role].en}</p><p lang="ml" class="t-h2">{p.name.ml}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section lang="en" class="wf-wrap mt-12 grid gap-10 lg:grid-cols-2">
    <div>
      <div class="wf-section-head"><h2 class="t-h1">Documents</h2></div>
      <Note n={3}>Founding documents as a simple list, each opening a readable page with a PDF download.</Note>
      <ul class="divide-y divide-zinc-200">
        {docs.map((d) => <li class="flex items-center justify-between gap-4 py-3"><a href="#" class="font-medium">{d}</a><span class="t-meta">PDF</span></li>)}
      </ul>
    </div>
    <div>
      <div class="wf-section-head"><h2 class="t-h1">Contact</h2></div>
      <p lang="ml">{site.address.ml}</p>
      <p class="t-meta mt-1">Phone and email to be added</p>
      <Ph label="Map" ratio="16/9" class="mt-4" />
    </div>
  </section>
</WireLayout>
