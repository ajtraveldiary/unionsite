---
/**
 * Wireframe: Struggles (plan, section 8: "timeline of major struggles linking to stories"). The
 * union's major strikes and campaigns as a timeline, newest first; each opens its stories in News.
 * The historic entries are placeholders until the old site's Struggles page is moved over; the
 * recent stories are real (crawled posts with the Struggles topic).
 */
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import Thumb from '~/components/wire/Thumb.astro';
import { allPosts } from '~/lib/sample';
import { formatDate } from '~/lib/i18n';

const recent = allPosts().filter((p) => p.topic === 'struggles').slice(0, 3);
const decades = ['2020s', '2010s', '2000s', '1990s', 'Earlier'];
const historic = Array.from({ length: 4 }, (_, i) => ({ year: 'Year', title: `Struggle ${i + 1}`, stories: [3, 0, 5, 1][i] }));
---
<WireLayout title="Struggles" page="struggles">
  <div class="wf-wrap pt-6">
    <nav lang="en" class="t-meta" aria-label="Breadcrumb"><a href="/wireframes">Home</a> / <a href="/wireframes/about">About</a> / Struggles</nav>
    <h1 lang="en" class="t-display mt-2">Struggles</h1>
    <p lang="ml" class="mt-3 max-w-2xl text-lg text-zinc-600">പ്രക്ഷോഭങ്ങളുടെ ചുരുക്കം (a short introduction)</p>
    <div lang="en" class="no-scrollbar -mx-4 mt-5 flex gap-2 overflow-x-auto px-4" role="group" aria-label="Jump to">
      {decades.map((d, i) => <a href={`#d${i}`} class="wf-chip shrink-0">{d}</a>)}
    </div>
    <Note n={1}>A timeline, newest first, with decade chips to jump back. Each struggle is a short entry (year, name, two lines) that opens its stories in News, so the page never repeats what News already holds.</Note>
  </div>

  <section id="d0" class="wf-wrap mt-6 scroll-mt-24" aria-labelledby="now">
    <h2 id="now" lang="en" class="t-h2 mb-3">Now</h2>
    <ul class="grid gap-4 md:grid-cols-3">
      {recent.map((p) => (
        <li class="relative">
          <Thumb post={p} ratio="16/9" />
          <p lang="en" class="t-meta mt-2">{formatDate(p.date, 'en', 'short')}</p>
          <a href="/wireframes/article" lang="ml" class="stretched clamp-2 mt-1 block font-semibold leading-snug">{p.title.ml}</a>
        </li>
      ))}
    </ul>
    <a href="/wireframes/news" lang="en" class="wf-link mt-3 inline-block">All struggle stories in News</a>
  </section>

  <section class="wf-wrap mt-10" aria-labelledby="timeline">
    <h2 id="timeline" lang="en" class="t-h2 mb-4">Timeline</h2>
    <ol class="relative ml-2 border-l-2 border-zinc-200">
      {historic.map((s, i) => (
        <li id={i === 0 ? 'd1' : undefined} class="relative scroll-mt-24 pb-8 pl-6">
          <span class="absolute -left-[9px] top-1 size-4 rounded-full border-2 border-zinc-800 bg-white" aria-hidden="true"></span>
          <p lang="en" class="text-lg font-bold tabular-nums">{s.year}</p>
          <h3 lang="ml" class="t-h3 mt-0.5">{s.title}</h3>
          <p lang="ml" class="mt-1 max-w-2xl text-zinc-600">രണ്ടു വരി വിവരണം (two lines on what happened and what it won)</p>
          <p lang="en" class="t-meta mt-1">{s.stories ? <a href="/wireframes/news" class="underline">{s.stories} stories</a> : 'No stories on the site'}</p>
        </li>
      ))}
    </ol>
    <Note n={2}>Old struggles with no stories on the site still get their entry; a photo can sit beside any entry. The state office keeps the page in the admin's Pages & documents screen, where Struggles is listed.</Note>
  </section>
</WireLayout>
