---
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import Ph from '~/components/wire/Ph.astro';
import Thumb from '~/components/wire/Thumb.astro';
import { allPosts, latestOrders, upcomingEvents, sortedDistricts, postsForDistrict, subjectName } from '~/lib/content';
import { t, langOf, formatDate, dateParts, monthName } from '~/lib/i18n';
import { topicBySlug, districtBySlug } from '~/data/districts';
import { magazineIssues, videos } from '~/data/site';
import type { Post } from '~/lib/types';

const lang = 'ml' as const;
const posts = allPosts();

// 1 · Top news: the lead plus up to four stories beside it
const lead = posts.find((p) => p.featured) ?? posts[0];
const topRest = posts.filter((p) => p !== lead).slice(0, 4);
const used = new Set<Post>([lead, ...topRest]);

// 2 · From the union: three columns, each continuing where Top news stops, so nothing repeats
const fresh = (list: Post[], n: number) => {
  const out = list.filter((p) => !used.has(p)).slice(0, n);
  out.forEach((p) => used.add(p));
  return out;
};
const columns = [
  { name: 'Secretary’s page', more: 'secretary', posts: fresh(posts.filter((p) => p.topic === 'secretary'), 4) },
  { name: 'FSETO', more: 'fseto', posts: fresh(posts.filter((p) => p.topic === 'fseto'), 4) },
];
columns.unshift({ name: 'NGO Union News', more: '', posts: fresh(posts.filter((p) => p.topic !== 'secretary' && p.topic !== 'fseto'), 4) });

const orders = latestOrders(5);
const events = upcomingEvents(50); // every upcoming event; the slider shows 3 at a time
const popular = ['DA', 'Pay Revision', 'Pension', 'MEDISEP', 'Leave surrender', 'Bonus'];
// Tools & guides beside the orders: calculators, how-to guides, forms and portals (3x3)
const tools = [
  { name: 'DA arrears', kind: 'Calculator' },
  { name: 'Pay fixation', kind: 'Calculator' },
  { name: 'Leave surrender', kind: 'Calculator' },
  { name: 'Pension & DCRG', kind: 'Calculator' },
  { name: 'MEDISEP claim', kind: 'Guide' },
  { name: 'Apply for HBA', kind: 'Guide' },
  { name: 'GPF withdrawal', kind: 'Guide' },
  { name: 'Forms & downloads', kind: 'PDFs' },
  { name: 'SPARK & portals', kind: 'Links' },
];
// Districts: events and news from every district (each column filterable by district),
// then all 15 districts as links to their pages
const districts = sortedDistricts().map((d) => ({ d, count: postsForDistrict(d.slug).length }));
const districtEvents = upcomingEvents(50).filter((e) => e.district);
const districtPosts = posts.filter((p) => p.district);
const EVENT_LIMIT = 4;
const NEWS_LIMIT = 5;
const shortName = (en: string) => en.replace('Thiruvananthapuram', 'TVM');
const issue = magazineIssues[0];
const ARTICLE = '/wireframes/article';
// "G.O.(P) No.112/2026/Fin" -> type "G.O.(P)", number "112", year "2026", department "Fin"
const goParts = (go: string) => {
  const m = go.match(/^(.*?)\s*No\.\s*(\d+)\/(\d+)\/?(.*)$/);
  return m ? { type: m[1], n: m[2], year: m[3], dept: m[4] } : { type: '', n: go, year: '', dept: '' };
};
const meta = (p: Post) => `${topicBySlug[p.topic].name.en} · ${formatDate(p.date, 'en', 'short')}`;
---
<WireLayout title="Home" page="home">
  <h1 class="sr-only">Kerala NGO Union</h1>

  <!-- Notices strip: home page only, shown only while a notice is active -->
  <div class="wf-wrap mt-6">
    <Note n={1}>Notices strip, home page only. It appears only while the office has an active notice (a strike call, a deadline) and disappears when the notice expires.</Note>
    <div lang="en" class="flex items-start gap-3 rounded-xl border border-zinc-300 bg-zinc-100 px-4 py-3">
      <span class="t-label shrink-0 pt-0.5">Notice</span>
      <p class="min-w-0 flex-1 text-sm"><span class="font-semibold">Example notice:</span> a one- or two-line announcement with a link to the full post. <a href={ARTICLE} class="wf-link">Read more</a></p>
    </div>
  </div>

  <!-- 1 · Top news: lead + up to 4 beside it, then the next 3 events -->
  <section class="wf-wrap mt-6" aria-labelledby="top-news">
    <div class="wf-section-head"><h2 id="top-news" lang="en" class="t-h1">Top news</h2><a href="/wireframes/news" lang="en" class="wf-link">All news</a></div>
    <Note n={2}>Top news opens the page (search stays in the header). The lead's headline sits over its photo on laptops so the whole story fits the first screen, and under it on phones. Up to four stories sit beside it; the fourth shows only where it fits next to the lead (laptops), so phones get three. Stories without a photo (here, the sample posts) show a neutral tile with their topic instead. The row underneath is a slider of all upcoming events: three in view on laptops, swipe on phones, with arrows only when there are more.</Note>
    <div class="grid gap-x-8 gap-y-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <!-- Lead: headline over the photo on laptops so the whole story fits the first screen; under it on phones -->
      <article class="relative overflow-hidden rounded-[10px]">
        <Thumb post={lead} ratio="16/9" class="lg:!rounded-none lg:!border-0" />
        <div class="lg:absolute lg:inset-x-0 lg:bottom-0 lg:bg-gradient-to-t lg:from-zinc-900/95 lg:via-zinc-900/70 lg:to-transparent lg:px-6 lg:pb-5 lg:pt-20">
          <p lang="en" class="t-meta mt-3 lg:mt-0 lg:!text-zinc-300">{meta(lead)}</p>
          <h3 lang={langOf(lead.title, lang)} class="t-display mt-1 !text-[calc(clamp(1.45rem,1.1rem+1.2vw,2rem)*1.16)] lg:text-white"><a href={ARTICLE} class="stretched">{t(lead.title, lang)}</a></h3>
          <p lang={langOf(lead.summary, lang)} class="clamp-2 mt-2 text-zinc-600 lg:text-zinc-200">{t(lead.summary, lang)}</p>
        </div>
      </article>
      <ul class="divide-y divide-zinc-200">
        {topRest.map((p, i) => (
          <li class:list={['relative gap-3 py-3 first:pt-0', i === 3 ? 'hidden lg:flex' : 'flex']}>
            <Thumb post={p} class="w-24 shrink-0 self-start sm:w-28" />
            <div class="min-w-0">
              <p lang="en" class="t-meta">{meta(p)}</p>
              <h3 lang={langOf(p.title, lang)} class="t-h3 clamp-3 mt-0.5"><a href={ARTICLE} class="stretched">{t(p.title, lang)}</a></h3>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-6 border-t border-zinc-200 pt-5">
      <div lang="en" class="mb-3 flex items-center justify-between gap-4">
        <h2 class="t-label">Coming up</h2>
        <div class="flex items-center gap-2">
          <!-- Arrows appear only when there are more events than fit -->
          <button type="button" data-ev-prev class="wf-btn wf-btn-line hidden !min-h-9 !px-3" aria-label="Previous events">‹</button>
          <button type="button" data-ev-next class="wf-btn wf-btn-line hidden !min-h-9 !px-3" aria-label="Next events">›</button>
          <a href="#" class="wf-link">Calendar</a>
        </div>
      </div>
      <!-- Slider: every upcoming event; 3 per view on laptops, swipe on phones -->
      <ul data-ev-track class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth px-4 md:mx-0 md:px-0">
        {events.map((e) => {
          const d = dateParts(e.start);
          return (
            <li class="wf-box relative flex w-[85%] shrink-0 snap-start gap-4 p-3 sm:w-[calc((100%-0.75rem)/2)] lg:w-[calc((100%-1.5rem)/3)]">
              <div lang="en" class="w-14 shrink-0 rounded-lg bg-zinc-100 py-1.5 text-center leading-tight">
                <p class="text-xs font-semibold uppercase">{d.monthShort}</p><p class="text-xl font-bold tabular-nums">{d.d}</p>
              </div>
              <div class="min-w-0">
                <a href="#" lang={langOf(e.title, lang)} class="stretched font-semibold leading-snug">{t(e.title, lang)}</a>
                <p lang={langOf(e.venue, lang)} class="t-meta mt-0.5">{t(e.venue, lang)}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 2 · From the union -->
  <section class="wf-wrap mt-12" aria-labelledby="from-union">
    <div class="wf-section-head"><h2 id="from-union" lang="en" class="t-h1">From the union</h2></div>
    <Note n={3}>Three columns: NGO Union News carries on from where Top news stops, then Secretary's page and FSETO. Each opens with one photo story and lists three more as text. Nothing repeats from Top news.</Note>
    <div class="grid gap-8 md:grid-cols-3">
      {columns.map((c) => {
        const [first, ...rest] = c.posts;
        return (
          <div>
            <h3 lang="en" class="t-h2 border-b-2 border-zinc-800 pb-1">{c.name}</h3>
            {first && (
              <article class="relative mt-3">
                <Thumb post={first} ratio="16/9" />
                <p lang="en" class="t-meta mt-2">{formatDate(first.date, 'en', 'short')}</p>
                <a href={ARTICLE} lang={langOf(first.title, lang)} class="stretched t-h3 clamp-3 mt-0.5 block">{t(first.title, lang)}</a>
              </article>
            )}
            <ul class="mt-2 divide-y divide-zinc-200 border-t border-zinc-200">
              {rest.map((p) => (
                <li class="relative py-3">
                  <a href={ARTICLE} lang={langOf(p.title, lang)} class="stretched clamp-2 font-medium leading-snug">{t(p.title, lang)}</a>
                  <p lang="en" class="t-meta mt-1">{formatDate(p.date, 'en', 'short')}</p>
                </li>
              ))}
            </ul>
            <a href="/wireframes/news" lang="en" class="wf-link">More from {c.name}</a>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 3 · Latest orders + Tools & guides -->
  <section class="wf-wrap mt-12 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    <div>
      <div class="wf-section-head"><h2 lang="en" class="t-h1">Latest orders</h2><a href="/wireframes/orders" lang="en" class="wf-link">All orders</a></div>
      <Note n={4}>Orders on the left, tools and guides for employees on the right. Popular subjects sit above the orders as quick filters, each opening the Orders page already filtered. Each order number sits inside a small document icon (type, number, year), with the date, department and subject under the title.</Note>
      <div lang="en" class="no-scrollbar -mx-4 mb-2 flex gap-2 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:px-0">
        {popular.map((c) => <a href="/wireframes/orders" class="wf-chip">{c}</a>)}
      </div>
      <ul class="divide-y divide-zinc-200">
        {orders.map((o) => {
          const g = goParts(o.goNumber);
          return (
            <li class="relative flex items-center gap-4 py-3">
              <!-- Document icon carrying the order number: type, number, year -->
              <div lang="en" class="wf-doc" aria-hidden="true">
                <span class="text-[0.5625rem] font-semibold uppercase tracking-wide text-zinc-500">{g.type}</span>
                <span class="text-[1.25rem] font-bold leading-none tabular-nums">{g.n}</span>
                <span class="text-[0.6875rem] font-medium tabular-nums text-zinc-600">{g.year}</span>
              </div>
              <div class="min-w-0">
                <a href="/wireframes/orders" lang={langOf(o.title, lang)} class="stretched clamp-2 font-medium leading-snug"><span class="sr-only" lang="en">{o.goNumber}: </span>{t(o.title, lang)}</a>
                <p lang="en" class="t-meta mt-0.5">{formatDate(o.goDate, 'en', 'short')}{g.dept && ` · ${g.dept}`} · {subjectName(o.subject)?.en}{o.important && ' · Important'}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
    <div>
      <div class="wf-section-head"><h2 lang="en" class="t-h1">Tools &amp; guides</h2><a href="#" lang="en" class="wf-link">All tools</a></div>
      <Note n={5}>A 3×3 grid of icons: calculators, how-to guides, forms and Govt portals. Calculators are new features to build in a later phase.</Note>
      <ul lang="en" class="grid grid-cols-3 gap-2">
        {tools.map((tl) => (
          <li class="wf-box relative flex aspect-square flex-col items-center justify-center gap-1.5 p-2 text-center hover:bg-zinc-50">
            <span class="grid size-10 place-items-center rounded-lg border-2 border-zinc-300 text-[0.625rem] font-semibold text-zinc-500" aria-hidden="true">icon</span>
            <a href="#" class="stretched text-[0.8125rem] font-semibold leading-tight">{tl.name}</a>
            <span class="text-[0.6875rem] text-zinc-500">{tl.kind}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · Districts: events and news from every district, then all 15 districts -->
  <section class="wf-wrap mt-12" aria-labelledby="districts">
    <div class="wf-section-head"><h2 id="districts" lang="en" class="t-h1">Districts</h2><a href="/wireframes/district" lang="en" class="wf-link">Map of districts</a></div>
    <Note n={6}>Three columns. Events and news from all districts, each with a filter button to narrow it to one district. Then all 15 districts, each linking to its own page.</Note>
    <div class="grid grid-cols-[minmax(0,1fr)] gap-8 md:grid-cols-2 lg:grid-cols-3">
      <!-- Events from all districts -->
      <div data-dfilter data-limit={EVENT_LIMIT}>
        <div class="mb-3 flex items-center justify-between gap-3 border-b-2 border-zinc-800 pb-1">
          <h3 lang="en" class="t-h2">District events</h3>
          <details class="relative" data-dfilter-menu>
            <summary lang="en" class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-zinc-300 px-2.5 py-1 text-sm hover:bg-zinc-50" aria-label="Filter events by district">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z" /></svg>
              <span data-dfilter-label class="max-w-28 truncate">All</span>
            </summary>
            <div lang="en" class="absolute right-0 z-20 mt-1 max-h-72 w-56 overflow-y-auto rounded-xl border border-zinc-200 bg-white p-1 shadow-lg">
              <button type="button" data-dfilter-pick="" aria-pressed="true" class="block w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-zinc-100 aria-pressed:font-semibold">All districts</button>
              {districts.map(({ d }) => <button type="button" data-dfilter-pick={d.slug} aria-pressed="false" class="block w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-zinc-100 aria-pressed:font-semibold">{d.name.en}</button>)}
            </div>
          </details>
        </div>
        <ul data-dfilter-list class="space-y-2">
          {districtEvents.map((e, i) => {
            const d = dateParts(e.start);
            return (
              <li data-district={e.district} hidden={i >= EVENT_LIMIT} class="wf-box relative flex gap-3 p-3">
                <div lang="en" class="w-12 shrink-0 rounded-lg bg-zinc-100 py-1 text-center leading-tight">
                  <p class="text-[0.6875rem] font-semibold uppercase">{d.monthShort}</p><p class="text-lg font-bold tabular-nums">{d.d}</p>
                </div>
                <div class="min-w-0">
                  <p lang="en" class="t-meta font-semibold !text-zinc-700">{shortName(districtBySlug[e.district!].name.en)}</p>
                  <a href="#" lang={langOf(e.title, lang)} class="stretched font-semibold leading-snug">{t(e.title, lang)}</a>
                  <p lang={langOf(e.venue, lang)} class="t-meta">{t(e.venue, lang)}</p>
                </div>
              </li>
            );
          })}
        </ul>
        <p lang="en" data-dfilter-empty hidden={districtEvents.length > 0} class="rounded-xl border border-dashed border-zinc-300 p-4 text-sm text-zinc-500">No upcoming events<span data-dfilter-name></span>.</p>
        <a href="#" lang="en" class="wf-link mt-3 inline-block">All events</a>
      </div>

      <!-- News from all districts -->
      <div data-dfilter data-limit={NEWS_LIMIT}>
        <div class="mb-3 flex items-center justify-between gap-3 border-b-2 border-zinc-800 pb-1">
          <h3 lang="en" class="t-h2">District news</h3>
          <details class="relative" data-dfilter-menu>
            <summary lang="en" class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-zinc-300 px-2.5 py-1 text-sm hover:bg-zinc-50" aria-label="Filter news by district">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z" /></svg>
              <span data-dfilter-label class="max-w-28 truncate">All</span>
            </summary>
            <div lang="en" class="absolute right-0 z-20 mt-1 max-h-72 w-56 overflow-y-auto rounded-xl border border-zinc-200 bg-white p-1 shadow-lg">
              <button type="button" data-dfilter-pick="" aria-pressed="true" class="block w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-zinc-100 aria-pressed:font-semibold">All districts</button>
              {districts.map(({ d }) => <button type="button" data-dfilter-pick={d.slug} aria-pressed="false" class="block w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-zinc-100 aria-pressed:font-semibold">{d.name.en}</button>)}
            </div>
          </details>
        </div>
        <ul data-dfilter-list class="divide-y divide-zinc-200">
          {districtPosts.map((p, i) => (
            <li data-district={p.district} hidden={i >= NEWS_LIMIT} class="relative flex gap-3 py-3 first:pt-0">
              <Thumb post={p} class="w-20 shrink-0 self-start" />
              <div class="min-w-0">
                <p lang="en" class="t-meta"><span class="font-semibold text-zinc-700">{shortName(districtBySlug[p.district!].name.en)}</span> · {formatDate(p.date, 'en', 'short')}</p>
                <a href={ARTICLE} lang={langOf(p.title, lang)} class="stretched t-h3 clamp-2 mt-0.5 block">{t(p.title, lang)}</a>
              </div>
            </li>
          ))}
        </ul>
        <p lang="en" data-dfilter-empty hidden={districtPosts.length > 0} class="rounded-xl border border-dashed border-zinc-300 p-4 text-sm text-zinc-500">No news<span data-dfilter-name></span> yet.</p>
        <a href="/wireframes/news" lang="en" class="wf-link mt-3 inline-block">All district news</a>
      </div>

      <!-- All districts -->
      <div class="md:col-span-2 lg:col-span-1">
        <h3 lang="en" class="t-h2 mb-3 border-b-2 border-zinc-800 pb-1">All districts</h3>
        <ul lang="en" class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-2">
          {districts.map(({ d, count }) => (
            <li class="wf-box relative px-3 py-2 hover:bg-zinc-50">
              <a href="/wireframes/district" class="stretched block text-sm font-semibold leading-snug">{shortName(d.name.en)}</a>
              <span class="t-meta">{count ? `${count} post${count === 1 ? '' : 's'}` : 'No posts yet'}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5 · Read & watch -->
  <section class="wf-wrap mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div>
      <div class="wf-section-head"><h2 lang="en" class="t-h1">Kerala Service</h2><a href="#" lang="en" class="wf-link">Archive</a></div>
      <Note n={7}>The current magazine issue and the three latest videos close the page. Videos load only when tapped.</Note>
      <div class="flex gap-4">
        <Ph label="Cover" ratio="210/297" class="w-28 shrink-0" />
        <div lang="en">
          <p class="t-label">Current issue</p>
          <p class="t-h2 mt-1">{monthName(issue.month, 'en')} {issue.year}</p>
          <a href="#" class="wf-btn wf-btn-dark mt-3">Read online</a>
        </div>
      </div>
    </div>
    <div>
      <div class="wf-section-head"><h2 lang="en" class="t-h1">Videos</h2><a href="#" lang="en" class="wf-link">YouTube channel</a></div>
      <ul class="grid gap-4 sm:grid-cols-3">
        {videos.slice(0, 3).map((v) => (
          <li><Ph label="Video" ratio="16/9" /><p lang="ml" class="clamp-2 mt-2 text-sm font-medium leading-snug">{v.title.ml}</p></li>
        ))}
      </ul>
    </div>
  </section>
</WireLayout>

<script>
  // District columns: the filter button narrows a column to one district
  document.querySelectorAll<HTMLElement>('[data-dfilter]').forEach((box) => {
    const limit = Number(box.dataset.limit) || 5;
    const items = [...box.querySelectorAll<HTMLElement>('[data-dfilter-list] > li')];
    const empty = box.querySelector<HTMLElement>('[data-dfilter-empty]')!;
    const label = box.querySelector<HTMLElement>('[data-dfilter-label]')!;
    const menu = box.querySelector<HTMLDetailsElement>('[data-dfilter-menu]')!;
    box.addEventListener('click', (e) => {
      const pick = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-dfilter-pick]');
      if (!pick) return;
      const slug = pick.dataset.dfilterPick!;
      const name = pick.textContent!.trim();
      let shown = 0;
      for (const li of items) {
        const ok = (!slug || li.dataset.district === slug) && shown < limit;
        li.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
      empty.querySelector('[data-dfilter-name]')!.textContent = slug ? ` in ${name}` : '';
      label.textContent = slug ? name.replace('Thiruvananthapuram', 'TVM') : 'All';
      box.querySelectorAll('[data-dfilter-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b === pick)));
      menu.open = false;
    });
  });

  // Events slider: show the arrows only when the track overflows, and page by one view
  const track = document.querySelector<HTMLElement>('[data-ev-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-ev-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-ev-next]');
  if (track && prev && next) {
    const sync = () => {
      const more = track.scrollWidth > track.clientWidth + 2;
      prev.classList.toggle('hidden', !more);
      next.classList.toggle('hidden', !more);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
</script>
