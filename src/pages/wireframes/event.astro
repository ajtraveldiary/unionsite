---
/**
 * Wireframe: one event (plan, section 8 "Event detail" and section 11 "Events calendar"): title,
 * date and time block, venue with a map link, description, Add to calendar, Share; after the event,
 * its report and album. A two-day sample event stands in, to show how a span reads.
 */
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import Ph from '~/components/wire/Ph.astro';
import { allEvents } from '~/lib/sample';
import { districtBySlug } from '~/data/districts';
import { formatDate } from '~/lib/i18n';

const e = allEvents().find((x) => x.end) ?? allEvents()[0];
const time = (iso: string) => iso.slice(11, 16);
// "24 Oct 2026" → day "24 Oct", month "Oct 2026"
const dayMonth = (iso: string) => formatDate(iso, 'en', 'short').split(' ').slice(0, 2).join(' ');
const monthYear = (iso: string) => formatDate(iso, 'en', 'short').split(' ').slice(1).join(' ');
const district = e.district ? districtBySlug[e.district].name.en : 'State';
const others = allEvents().filter((x) => x.slug !== e.slug).slice(0, 3);
---
<WireLayout title={e.title.en ?? 'Event'} page="event">
  <div class="wf-wrap max-w-[860px] pt-6">
    <nav lang="en" class="t-meta" aria-label="Breadcrumb"><a href="/wireframes">Home</a> / <a href="/wireframes/news">News</a> / Events</nav>
    <p lang="en" class="t-label mt-4">Event · {district}</p>
    <h1 lang="ml" class="t-display mt-1">{e.title.ml}</h1>

    <div class="mt-5 grid gap-4 sm:grid-cols-[auto_minmax(0,1fr)]">
      <div lang="en" class="wf-box flex items-center gap-3 p-4">
        <div class="text-center"><p class="text-3xl font-bold tabular-nums leading-none">{e.start.slice(8, 10)}{e.end && `–${e.end.slice(8, 10)}`}</p><p class="t-label mt-1">{monthYear(e.start)}</p></div>
      </div>
      <div lang="en" class="space-y-1">
        <p class="font-semibold">{formatDate(e.start, 'en')}{e.end && ` to ${formatDate(e.end, 'en')}`}</p>
        <p class="text-zinc-600">{time(e.start)}{e.end && ` – ${time(e.end)} on the last day`}</p>
        <p><span lang="ml">{e.venue.ml}</span> · <a href="#" class="underline">Directions</a></p>
      </div>
    </div>
    <div lang="en" class="mt-4 flex flex-wrap gap-2 border-y border-zinc-200 py-3">
      <span class="wf-btn wf-btn-dark !min-h-10 text-sm">Add to calendar</span>
      <span class="wf-btn wf-btn-line !min-h-10 text-sm">WhatsApp</span>
      <span class="wf-btn wf-btn-line !min-h-10 text-sm">Copy link</span>
    </div>
    <Note n={1}>A multi-day event shows as a span (24–25). "Add to calendar" offers the phone's calendar (.ics) and Google Calendar; all events are also one calendar feed people can subscribe to (plan, section 11). The page is /events/{e.slug}.</Note>

    <Ph label="Map" ratio="16/7" class="mt-6" />

    <section class="mt-8" aria-labelledby="about">
      <h2 id="about" lang="en" class="t-h2">About the event</h2>
      <div lang="ml" class="mt-3 space-y-4 text-[1.125rem] leading-[1.85] text-zinc-700"><p>പരിപാടിയുടെ വിവരണം (programme, speakers, who should come)</p></div>
    </section>

    <section class="wf-box mt-8 border-dashed p-4" aria-labelledby="after">
      <p lang="en" class="t-label">After the event</p>
      <h2 id="after" lang="en" class="t-h3 mt-1">Report and photos</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-[10rem_minmax(0,1fr)]">
        <Ph label="Report photo" ratio="4/3" />
        <div><p lang="ml" class="font-semibold">റിപ്പോർട്ടിന്റെ തലക്കെട്ട് (the news report)</p><p lang="en" class="t-meta mt-1">Linked by the editor · <a href="/wireframes/album" class="underline">Album, 24 photos</a></p></div>
      </div>
      <Note n={2}>Once the event is over, the date block greys out, "Add to calendar" goes, and this box takes the top of the page with the linked news report and album.</Note>
    </section>

    <section lang="en" class="mt-10" aria-labelledby="more">
      <div class="wf-section-head"><h2 id="more" class="t-h2">Other events</h2><a href="#" class="wf-link">Calendar</a></div>
      <ul class="divide-y divide-zinc-200 border-y border-zinc-200">
        {others.map((x) => <li class="flex gap-4 py-3"><span class="w-16 shrink-0 font-semibold tabular-nums">{dayMonth(x.start)}</span><a href="/wireframes/event" lang="ml" class="font-medium">{x.title.ml}</a></li>)}
      </ul>
    </section>
  </div>
</WireLayout>
