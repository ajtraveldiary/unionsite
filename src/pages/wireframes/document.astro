---
/**
 * Wireframe: one document (plan, section 8: "read online or download PDF"). A page per document
 * with a short description, the PDF in a reader on the page, Download and Share, and the other
 * documents. The Bye-Law stands in.
 */
import WireLayout from '~/components/wire/WireLayout.astro';
import Note from '~/components/wire/Note.astro';
import Ph from '~/components/wire/Ph.astro';

const others = ['Policy resolution, 1965', 'Silver Jubilee conference programme', 'Golden Jubilee organisational document'];
---
<WireLayout title="Bye-Law" page="document">
  <div class="wf-wrap pt-6">
    <nav lang="en" class="t-meta" aria-label="Breadcrumb"><a href="/wireframes">Home</a> / <a href="/wireframes/about">About</a> / <a href="/wireframes/documents">Documents</a> / Bye-Law</nav>
    <p lang="en" class="t-label mt-4">Bye-Law · current version</p>
    <h1 lang="en" class="t-display mt-1">Bye-Law</h1>
    <p lang="ml" class="mt-3 max-w-2xl text-lg text-zinc-600">ചുരുക്ക വിവരണം (a short description of what the document is)</p>
    <div lang="en" class="mt-4 flex flex-wrap items-center gap-2 border-y border-zinc-200 py-3">
      <span class="t-meta mr-auto">PDF · pages · size · updated date</span>
      <span class="wf-btn wf-btn-dark !min-h-10 text-sm">Download</span>
      <span class="wf-btn wf-btn-line !min-h-10 text-sm">WhatsApp</span>
      <span class="wf-btn wf-btn-line !min-h-10 text-sm">Copy link</span>
    </div>
  </div>

  <section class="wf-wrap mt-6" aria-label="Document">
    <div class="rounded-xl border border-zinc-300 bg-zinc-100">
      <div lang="en" class="flex flex-wrap items-center gap-2 border-b border-zinc-300 bg-white px-3 py-2 text-sm">
        <span class="font-semibold">Page 1 of N</span>
        <span class="wf-btn wf-btn-line !min-h-8 px-2 text-xs">−</span><span class="wf-btn wf-btn-line !min-h-8 px-2 text-xs">+</span>
        <span class="wf-btn wf-btn-line !min-h-8 ml-auto px-2 text-xs">Full screen</span>
      </div>
      <div class="grid place-items-center gap-4 p-4 sm:p-8">
        <Ph label="Page 1" ratio="210/297" class="w-full max-w-md" />
        <Ph label="Page 2" ratio="210/297" class="w-full max-w-md" />
      </div>
    </div>
    <Note n={1}>The PDF opens on the page with pdf.js: pages load as you scroll, so a long document starts at once on 4G. "Full screen" uses the same reader as Kerala Service. Under the reader, a text summary helps screen-reader users (plan, section 9).</Note>
  </section>

  <section lang="en" class="wf-wrap mt-10" aria-labelledby="other">
    <h2 id="other" class="t-h2">Other documents</h2>
    <ul class="mt-2 divide-y divide-zinc-200 border-y border-zinc-200">{others.map((d) => <li class="flex items-center justify-between gap-3 py-3"><a href="/wireframes/document" class="font-medium">{d}</a><span class="t-meta">PDF</span></li>)}</ul>
  </section>
</WireLayout>
