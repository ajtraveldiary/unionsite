---
import PostEditorView from '~/views/admin/PostEditorView.astro';
import { coverInfo, loadForEditor } from '~/lib/admin/posts';

export const prerender = false;
const id = Number(Astro.params.id);
const data = Number.isInteger(id) && id > 0 ? await loadForEditor(Astro.locals.user!, id) : null;
if (!data) return new Response(null, { status: 404 });
const cover = await coverInfo(data.doc.coverMediaId);
---
<PostEditorView data={data} cover={cover} />
