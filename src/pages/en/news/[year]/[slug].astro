---
import ArticleView from '~/views/ArticleView.astro';
import { postByPath } from '~/lib/content';
import { cachePage, tags } from '~/lib/cache';

export const prerender = false;
const post = await postByPath(Astro.params.year!, Astro.params.slug!);
if (!post) return new Response(null, { status: 404 });
cachePage(Astro, 'item', [tags.post(post.id)]);
---
<ArticleView lang="en" post={post} />
