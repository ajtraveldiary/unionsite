---
import IssueView from '~/views/IssueView.astro';
import { allIssues } from '~/lib/content';
import { cachePage, tags } from '~/lib/cache';

export const prerender = false;
const year = Number(Astro.params.year);
const month = Number(Astro.params.month);
const issues = await allIssues();
if (Astro.params.month!.length !== 2 || !issues.some((i) => i.year === year && i.month === month)) return new Response(null, { status: 404 });
cachePage(Astro, 'item', [tags.issues]);
---
<IssueView lang="ml" issues={issues} year={year} month={month} />
