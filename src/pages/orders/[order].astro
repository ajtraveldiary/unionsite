---
import OrderView from '~/views/OrderView.astro';
import { orderById, orderUrl } from '~/lib/content';
import { cachePage, tags } from '~/lib/cache';

export const prerender = false;
// /orders/{id}-{slug}: the id finds the order; an old or mistyped slug redirects to the right one
const param = Astro.params.order!;
const order = await orderById(parseInt(param, 10));
if (!order) return new Response(null, { status: 404 });
if (param !== `${order.id}-${order.slug}`) return Astro.redirect(orderUrl(order, 'ml'), 301);
cachePage(Astro, 'item', [tags.order(order.id)]);
---
<OrderView lang="ml" order={order} />
